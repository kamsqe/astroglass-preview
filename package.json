{
  "name": "liquid-glass-astro-theme",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm run index:content",
    "index:content": "node scripts/generate-search-index.mjs",
    "preview": "wrangler pages dev dist",
    "preview:cloudflare": "wrangler pages dev dist",
    "preview:vercel": "vercel dev",
    "preview:netlify": "netlify dev",
    "deploy": "astro build && pnpm run index:content && wrangler pages deploy dist",
    "deploy:cloudflare": "pnpm run deploy",
    "deploy:vercel": "pnpm run build && vercel deploy",
    "deploy:netlify": "pnpm run build && netlify deploy --prod",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.16.9",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "valibot": "^1.2.0"
  }
}
