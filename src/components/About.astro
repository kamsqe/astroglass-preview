---
import AboutLiquid from './about/AboutLiquid.astro';
import AboutGlass from './about/AboutGlass.astro';
import AboutNeo from './about/AboutNeo.astro';
import AboutLuxury from './about/AboutLuxury.astro';
import AboutMinimal from './about/AboutMinimal.astro';

export interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 ? <AboutLiquid /> : 
 version === 2 ? <AboutGlass /> : 
 version === 3 ? <AboutNeo /> : 
 version === 4 ? <AboutLuxury /> : 
 <AboutMinimal />}
