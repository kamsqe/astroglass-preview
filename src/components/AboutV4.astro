---
/**
 * About V4 - The Journey Timeline (Redesigned)
 * A stunning vertical timeline with glowing nodes, flowing connections, and immersive cards.
 */
import { getLocaleFromUrl, useTranslations } from '../utils/i18n';

export interface Props {
  isFirst?: boolean;
}

const { isFirst = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const milestones = [
  { year: '2021', icon: '💡', title: t('about.timeline.m1Title'), desc: t('about.timeline.m1Desc'), color: 'from-violet-500 to-purple-600' },
  { year: '2022', icon: '🛠', title: t('about.timeline.m2Title'), desc: t('about.timeline.m2Desc'), color: 'from-blue-500 to-cyan-500' },
  { year: '2023', icon: '🚀', title: t('about.timeline.m3Title'), desc: t('about.timeline.m3Desc'), color: 'from-emerald-500 to-teal-500' },
  { year: '2024', icon: '✨', title: t('about.timeline.m4Title'), desc: t('about.timeline.m4Desc'), color: 'from-amber-500 to-orange-500' },
  { year: t('about.timeline.today'), icon: '👋', title: t('about.timeline.m5Title'), desc: t('about.timeline.m5Desc'), color: 'from-rose-500 to-pink-500', isCta: true },
];
---

<section class:list={["timeline-section relative px-4 sm:px-6 overflow-hidden", isFirst ? "pt-[calc(40px+var(--nav-offset))] pb-20 md:pb-32 md:pt-[calc(80px+var(--nav-offset))]" : "py-20 md:py-32"]}>
  <!-- Background ambient -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-primary/5 rounded-full blur-[100px]"></div>
  </div>

  <div class="max-w-5xl mx-auto relative z-10">
    <!-- Header -->
    <div class="text-center mb-16 lg:mb-24">
      <div class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-accent/20 to-primary/20 border border-accent/20 text-accent text-xs font-bold uppercase tracking-widest mb-6 backdrop-blur-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
        </span>
        {t('about.ourJourney')}
      </div>
      <h2 class="text-4xl sm:text-5xl lg:text-7xl font-black text-base-content tracking-tight mb-6">
        {t('about.timelineTitle')}
      </h2>
      <p class="text-lg sm:text-xl text-base-content/50 max-w-2xl mx-auto leading-relaxed">
        {t('about.timelineSubtitle')}
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="timeline-container relative">
      <!-- Central flowing line -->
      <div class="timeline-line absolute left-6 sm:left-8 lg:left-1/2 top-0 bottom-0 w-[2px] lg:-translate-x-1/2">
        <div class="absolute inset-0 bg-gradient-to-b from-accent via-primary to-accent/20 rounded-full"></div>
        <div class="timeline-glow absolute inset-0 bg-gradient-to-b from-accent via-primary to-accent/20 rounded-full blur-sm opacity-50"></div>
      </div>

      <!-- Milestones -->
      <div class="space-y-12 lg:space-y-0">
        {milestones.map((m, i) => (
          <div 
            class={`milestone-wrapper relative lg:grid lg:grid-cols-2 lg:gap-12 ${i > 0 ? 'lg:mt-20' : ''}`}
            data-index={i}
          >
            <!-- Timeline Node -->
            <div class="timeline-node absolute left-6 sm:left-8 lg:left-1/2 -translate-x-1/2 z-20">
              <div class="node-outer relative w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-base-100 border-2 border-base-content/10 flex items-center justify-center shadow-xl">
                <div class={`node-inner w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-gradient-to-br ${m.color} flex items-center justify-center text-lg sm:text-xl shadow-lg`}>
                  {m.icon}
                </div>
                <!-- Pulse ring -->
                <div class={`absolute inset-0 rounded-full bg-gradient-to-br ${m.color} opacity-20 animate-ping`} style="animation-duration: 2s;"></div>
              </div>
              <!-- Year badge attached to node -->
              <div class="absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap">
                <span class={`px-3 py-1 rounded-full text-[10px] sm:text-xs font-black tracking-wider bg-gradient-to-r ${m.color} text-white shadow-lg`}>
                  {m.year}
                </span>
              </div>
            </div>

            <!-- Content Card -->
            <div class={`milestone-card ml-20 sm:ml-24 lg:ml-0 ${i % 2 === 0 ? 'lg:col-start-1 lg:pr-16 lg:text-right' : 'lg:col-start-2 lg:pl-16 lg:text-left'}`}>
              <div class={`card-inner relative p-6 sm:p-8 rounded-2xl sm:rounded-3xl backdrop-blur-xl border transition-all duration-700 ${m.isCta ? 'bg-gradient-to-br from-accent/10 to-primary/10 border-accent/30' : 'bg-base-content/[0.03] border-base-content/10 hover:bg-base-content/[0.06] hover:border-base-content/20'}`}>
                <!-- Gradient accent line -->
                <div class={`absolute ${i % 2 === 0 ? 'lg:right-0 lg:left-auto left-0' : 'left-0'} top-6 bottom-6 w-1 rounded-full bg-gradient-to-b ${m.color} opacity-60`}></div>
                
                <h3 class="text-xl sm:text-2xl font-black text-base-content mb-3">
                  {m.title}
                </h3>
                <p class="text-sm sm:text-base text-base-content/60 leading-relaxed">
                  {m.desc}
                </p>

                {m.isCta && (
                  <div class={`mt-6 ${i % 2 === 0 ? 'lg:text-right' : ''}`}>
                    <a href="#explore" class="inline-flex items-center gap-3 px-6 py-3 rounded-xl bg-gradient-to-r from-accent to-primary text-white font-bold text-sm shadow-lg shadow-accent/25 hover:shadow-xl hover:shadow-accent/30 hover:scale-105 active:scale-95 transition-all duration-300">
                      {t('hero.startBuilding')}
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </a>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-section {
    background: radial-gradient(ellipse at 50% 0%, hsl(var(--a) / 0.03) 0%, transparent 50%);
  }

  .timeline-node {
    transition: all 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .node-outer {
    transition: all 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .milestone-wrapper:hover .node-outer {
    transform: scale(1.15);
    border-color: hsl(var(--a) / 0.4);
    box-shadow: 0 0 30px hsl(var(--a) / 0.3);
  }

  .milestone-wrapper:hover .node-inner {
    transform: scale(1.1) rotate(10deg);
  }

  .node-inner {
    transition: all 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .milestone-card {
    opacity: 0;
    transform: translateY(30px);
    animation: card-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .milestone-wrapper:nth-child(1) .milestone-card { animation-delay: 0ms; }
  .milestone-wrapper:nth-child(2) .milestone-card { animation-delay: 150ms; }
  .milestone-wrapper:nth-child(3) .milestone-card { animation-delay: 300ms; }
  .milestone-wrapper:nth-child(4) .milestone-card { animation-delay: 450ms; }
  .milestone-wrapper:nth-child(5) .milestone-card { animation-delay: 600ms; }

  @keyframes card-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .card-inner {
    transition: all 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .milestone-wrapper:hover .card-inner {
    transform: translateY(-4px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .timeline-glow {
    animation: glow-pulse 3s ease-in-out infinite;
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
  }

  /* Desktop alternating layout */
  @media (min-width: 1024px) {
    .milestone-wrapper:nth-child(odd) .milestone-card {
      animation-name: card-reveal-left;
    }
    
    .milestone-wrapper:nth-child(even) .milestone-card {
      animation-name: card-reveal-right;
    }

    @keyframes card-reveal-left {
      from {
        opacity: 0;
        transform: translateX(30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes card-reveal-right {
      from {
        opacity: 0;
        transform: translateX(-30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }
  }
</style>
