---
import FAQLiquid from './faq/FAQLiquid.astro';
import FAQGlass from './faq/FAQGlass.astro';
import FAQNeo from './faq/FAQNeo.astro';
import FAQLuxury from './faq/FAQLuxury.astro';
import FAQMinimal from './faq/FAQMinimal.astro';

export interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 ? <FAQLiquid /> : 
 version === 2 ? <FAQGlass /> : 
 version === 3 ? <FAQNeo /> : 
 version === 4 ? <FAQLuxury /> : 
 <FAQMinimal />}
