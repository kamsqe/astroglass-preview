---
/**
 * FAQ - Version Switcher Wrapper
 * Renders the selected FAQ version based on prop.
 */
import FAQV1 from './FAQV1.astro';
import FAQV2 from './FAQV2.astro';
import FAQV3 from './FAQV3.astro';
import FAQV4 from './FAQV4.astro';
import FAQV5 from './FAQV5.astro';

interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 && <FAQV1 />}
{version === 2 && <FAQV2 />}
{version === 3 && <FAQV3 />}
{version === 4 && <FAQV4 />}
{version === 5 && <FAQV5 />}
