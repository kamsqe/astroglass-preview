---
/**
 * FAQ V4 - The Search Hero
 * Large prominent search bar with instant filtering.
 * Mobile: Sticky search with filtered results. Desktop: Centered search with grid.
 */
import { getLocaleFromUrl, useTranslations } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const faqs = [
  { q: t('faq.q1'), a: t('faq.a1'), tags: ["basics", "new"] },
  { q: t('faq.q2'), a: t('faq.a2'), tags: ["basics", "pricing"] },
  { q: t('faq.q3'), a: t('faq.a3'), tags: ["pricing", "plans"] },
  { q: t('faq.q4'), a: t('faq.a4'), tags: ["pricing", "billing"] },
  { q: t('faq.q5'), a: t('faq.a5'), tags: ["technical", "developer"] },
  { q: t('faq.q9'), a: t('faq.a9'), tags: ["technical", "integrations"] },
  { q: t('faq.q6'), a: t('faq.a6'), tags: ["technical", "security"] },
  { q: t('faq.q7'), a: t('faq.a7'), tags: ["team", "account"] },
  { q: t('faq.q8'), a: t('faq.a8'), tags: ["account", "login"] },
  { q: t('faq.q10'), a: t('faq.a10'), tags: ["support", "help"] },
  { q: t('faq.q11'), a: t('faq.a11'), tags: ["support", "docs"] },
  { q: t('faq.q12'), a: t('faq.a12'), tags: ["account", "data"] },
];

const popularTags = ["basics", "pricing", "technical", "account", "support"];
---

<section class="relative py-24 lg:py-32 px-6 overflow-hidden bg-base-100">
  <div class="max-w-4xl mx-auto">
    <!-- Header with Search -->
    <div class="text-center mb-12">
       <span class="text-[10px] font-black uppercase tracking-[0.5em] text-accent mb-4 block">{t('faq.helpCenter')}</span>
       <h2 class="text-4xl md:text-6xl font-black text-base-content tracking-tighter mb-8">{t('faq.title')}</h2>
       
       <!-- Search Bar -->
       <div class="relative max-w-xl mx-auto">
          <div class="faq-v4-search-wrapper flex items-center gap-3 p-4 lg:p-5 rounded-2xl bg-base-content/[0.03] border border-base-content/10 focus-within:border-accent/50 focus-within:bg-base-content/[0.05] focus-within:shadow-[0_0_40px_rgba(var(--a),0.1)] transition-all duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)]">
             <svg class="w-5 h-5 text-base-content/30 transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
             </svg>
             <input 
               type="text" 
               id="faq-v4-search"
               placeholder={t('faq.searchPlaceholder')} 
               class="flex-1 bg-transparent text-base-content placeholder:text-base-content/30 outline-none border-none ring-0 focus:outline-none focus:border-none focus:ring-0 text-base"
             />
             <button id="faq-v4-clear" class="hidden px-3 py-1 rounded-lg bg-base-content/5 text-xs text-base-content/50 hover:bg-base-content/10 transition-all duration-500">
                {t('faq.clear')}
             </button>
          </div>
          
          <!-- Quick Tags (clickable filters) -->
          <div class="flex flex-wrap justify-center gap-2 mt-4">
             {popularTags.map(tag => (
                <button 
                  class="faq-v4-tag-btn px-4 py-2 rounded-full bg-base-content/[0.04] border border-base-content/10 text-xs font-medium text-base-content/60 hover:bg-accent/10 hover:border-accent/30 hover:text-accent hover:scale-105 active:scale-95 transition-all duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] capitalize cursor-pointer"
                  data-tag={tag}
                >
                   <span class="mr-1 opacity-50">#</span>{t(`faq.tags.${tag}`)}
                </button>
             ))}
          </div>
       </div>
    </div>

    <!-- Results -->
    <div class="faq-v4-results space-y-3" id="faq-v4-results">
       {faqs.map((faq, i) => (
          <div 
            class="faq-v4-result-item" 
            data-question={faq.q.toLowerCase()}
            data-answer={faq.a.toLowerCase()}
            data-tags={faq.tags.join(' ')}
            style={`animation-delay: ${i * 50}ms`}
          >
             <button class="faq-v4-result-trigger w-full flex items-center justify-between p-5 lg:p-6 rounded-xl lg:rounded-2xl bg-base-content/[0.02] border border-base-content/5 hover:bg-base-content/[0.05] hover:border-base-content/10 transition-all duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] text-left group">
                <span class="text-sm lg:text-base text-base-content font-medium pr-4 group-hover:text-accent transition-colors duration-500">{faq.q}</span>
                <div class="w-8 h-8 rounded-full bg-base-content/5 flex items-center justify-center flex-shrink-0 group-hover:bg-accent/10 transition-all duration-500">
                   <svg class="w-4 h-4 text-base-content/20 transition-all duration-500 group-hover:text-accent faq-v4-result-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                   </svg>
                </div>
             </button>
             <div class="faq-v4-result-content hidden px-5 lg:px-6 pb-5 lg:pb-6">
                <p class="text-sm text-base-content/60 leading-relaxed pt-2">{faq.a}</p>
                <div class="flex gap-2 mt-4">
                   {faq.tags.map(tag => (
                      <span class="faq-v4-label px-2 py-1 rounded-md bg-base-content/[0.02] text-[10px] text-base-content/25 capitalize italic">{t(`faq.tags.${tag}`)}</span>
                   ))}
                </div>
             </div>
          </div>
       ))}
    </div>

    <!-- No results message -->
    <div class="faq-v4-no-results hidden text-center py-12">
       <span class="text-4xl mb-4 block">🔍</span>
       <p class="text-base text-base-content/50 mb-2">{t('faq.noResults')}</p>
       <p class="text-sm text-base-content/30">{t('faq.tryDifferent')} <a href="#" class="text-accent hover:underline">{t('faq.contactSupport')}</a></p>
    </div>

    <!-- Result count -->
    <div class="text-center mt-8">
       <p class="text-xs text-base-content/30" id="faq-v4-count" data-template={t('faq.showingQuestions')}>{t('faq.showingQuestions').replace('{count}', faqs.length)}</p>
    </div>
  </div>
</section>

<style>
  .faq-v4-result-item {
    opacity: 0;
    animation: resultFadeInV4 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes resultFadeInV4 {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .faq-v4-result-item.open .faq-v4-result-arrow {
    transform: rotate(180deg);
  }

  .faq-v4-result-item.open .faq-v4-result-trigger {
    background: hsl(var(--bc) / 0.04);
    border-color: hsl(var(--bc) / 0.1);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .faq-v4-result-item.hidden-by-search {
    display: none;
  }

  .faq-v4-result-content {
    animation: contentExpandV4 600ms cubic-bezier(0.16, 1, 0.3, 1);
    background: hsl(var(--bc) / 0.02);
    border: 1px solid hsl(var(--bc) / 0.05);
    border-top: none;
    border-bottom-left-radius: 1rem;
    border-bottom-right-radius: 1rem;
  }

  @keyframes contentExpandV4 {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .faq-v4-tag-btn {
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .faq-v4-tag-btn.active {
    background: hsl(var(--a) / 0.15);
    border-color: hsl(var(--a) / 0.4);
    color: hsl(var(--a));
    font-weight: 600;
    box-shadow: 0 0 12px hsl(var(--a) / 0.2);
  }

  /* Non-clickable labels in answers */
  .faq-v4-label {
    cursor: default;
    user-select: none;
  }

  /* Input - remove all focus styles */
  #faq-v4-search,
  #faq-v4-search:focus,
  #faq-v4-search:focus-visible {
    outline: none !important;
    border: none !important;
    box-shadow: none !important;
    -webkit-appearance: none;
  }

  .faq-v4-search-wrapper:focus-within svg {
    color: hsl(var(--a));
  }
</style>

<script>
  let faqV4Controller: AbortController | null = null;

  function initFAQV4Search() {
    // Abort previous listeners
    faqV4Controller?.abort();
    faqV4Controller = new AbortController();
    const signal = faqV4Controller.signal;

    const searchInput = document.getElementById('faq-v4-search') as HTMLInputElement;
    const clearBtn = document.getElementById('faq-v4-clear');
    const results = document.querySelectorAll('.faq-v4-result-item');
    const noResults = document.querySelector('.faq-v4-no-results');
    const countEl = document.getElementById('faq-v4-count');
    const tagBtns = document.querySelectorAll('.faq-v4-tag-btn');
    
    let activeTag = '';

    function filterResults() {
      const query = searchInput?.value.toLowerCase().trim() || '';
      let visibleCount = 0;

      results.forEach(item => {
        const q = (item as HTMLElement).dataset.question || '';
        const a = (item as HTMLElement).dataset.answer || '';
        const tags = (item as HTMLElement).dataset.tags || '';
        
        const matchesSearch = !query || q.includes(query) || a.includes(query);
        const matchesTag = !activeTag || tags.includes(activeTag);
        
        if (matchesSearch && matchesTag) {
          item.classList.remove('hidden-by-search');
          visibleCount++;
        } else {
          item.classList.add('hidden-by-search');
        }
      });

      // Show/hide no results
      noResults?.classList.toggle('hidden', visibleCount > 0);
      
      // Update count
      if (countEl) {
        const template = countEl.dataset.template || "Showing {count} questions";
        countEl.textContent = template.replace('{count}', visibleCount.toString());
      }

      // Show/hide clear button
      clearBtn?.classList.toggle('hidden', !query && !activeTag);
    }

    // Search input
    searchInput?.addEventListener('input', filterResults, { signal });

    // Clear button
    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeTag = '';
      tagBtns.forEach(b => b.classList.remove('active'));
      filterResults();
    }, { signal });

    // Tag buttons
    tagBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = (btn as HTMLElement).dataset.tag || '';
        
        if (activeTag === tag) {
          activeTag = '';
          btn.classList.remove('active');
        } else {
          activeTag = tag;
          tagBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        }
        
        filterResults();
      }, { signal });
    });

    // Accordion expand/collapse
    document.querySelectorAll('.faq-v4-result-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-v4-result-item');
        const content = item?.querySelector('.faq-v4-result-content');
        const isOpen = item?.classList.contains('open');
        
        // Close all others
        results.forEach(r => {
          if (r !== item) {
            r.classList.remove('open');
            r.querySelector('.faq-v4-result-content')?.classList.add('hidden');
          }
        });
        
        // Toggle this
        item?.classList.toggle('open', !isOpen);
        content?.classList.toggle('hidden', isOpen);
      }, { signal });
    });
  }

  initFAQV4Search();
  document.addEventListener('astro:after-swap', initFAQV4Search);
</script>
