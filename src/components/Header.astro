---
/**
 * Header Component
 *
 * Responsive header with nested dropdown navigation and mobile menu.
 * Uses modular sub-components for reusability.
 *
 * @example
 * ```astro
 * <Header />
 * ```
 */
import { getLocaleFromUrl, useTranslations } from '../utils/i18n';
import { buildNavLinks } from '../config/navigation';
import Logo from './Logo.astro';
import DesktopNav from './DesktopNav.astro';
import MobileNav from './MobileNav.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
  /** Additional CSS classes for the header */
  class?: string;
}

const { class: className = '' } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Build navigation links with locale and translations
const navLinks = buildNavLinks(locale, t);
---

<header class:list={['header-glass sticky top-0 z-50', className]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-18">
      <!-- Logo -->
      <Logo />

      <!-- Desktop Navigation -->
      <DesktopNav links={navLinks} />

      <!-- Desktop Switchers -->
      <div class="hidden lg:flex items-center gap-1.5">
        <ThemeSwitcher />
        <div class="switcher-separator"></div>
        <LanguageSwitcher />
      </div>

      <!-- Hamburger Button -->
      <button type="button" class="hamburger-btn lg:hidden" id="menu-toggle" aria-label="Toggle menu">
        <div class="hamburger-icon" id="hamburger-icon">
          <span></span>
          <span></span>
        </div>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation (separate from header) -->
<MobileNav links={navLinks} />

<script>
  function initNavigation() {
    const btn = document.getElementById('menu-toggle');
    const nav = document.getElementById('mobile-nav');

    if (!btn || !nav) return;

    function closeMenu() {
      nav.classList.remove('is-open');
      btn.classList.remove('is-active');
      document.body.style.overflow = '';
      nav.querySelectorAll('.mobile-dropdown.is-open').forEach(d => d.classList.remove('is-open'));
      nav.querySelectorAll('.mobile-nested-dropdown.is-open').forEach(d => d.classList.remove('is-open'));
    }

    function openMenu() {
      nav.classList.add('is-open');
      btn.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }

    // Ensure menu is closed on page load
    closeMenu();

    // Clone button to remove old listeners
    const newBtn = btn.cloneNode(true) as HTMLElement;
    btn.parentNode?.replaceChild(newBtn, btn);

    newBtn.addEventListener('click', () => {
      if (nav.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close on link click (not dropdown triggers)
    nav.querySelectorAll('a').forEach(link => {
      const newLink = link.cloneNode(true) as HTMLElement;
      link.parentNode?.replaceChild(newLink, link);
      newLink.addEventListener('click', closeMenu);
    });

    // Mobile dropdown toggles
    nav.querySelectorAll('[data-mobile-dropdown]').forEach(dropdown => {
      const trigger = dropdown.querySelector('.mobile-dropdown-trigger');
      if (!trigger) return;

      const newTrigger = trigger.cloneNode(true) as HTMLElement;
      trigger.parentNode?.replaceChild(newTrigger, trigger);

      newTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropdown.classList.toggle('is-open');
      });
    });

    // Mobile nested dropdown toggles
    nav.querySelectorAll('[data-mobile-nested]').forEach(nestedDropdown => {
      const trigger = nestedDropdown.querySelector('.mobile-nested-trigger');
      if (!trigger) return;

      const newTrigger = trigger.cloneNode(true) as HTMLElement;
      trigger.parentNode?.replaceChild(newTrigger, trigger);

      newTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        nestedDropdown.classList.toggle('is-open');
      });
    });
  }

  // Handle keyboard escape - only add once
  if (!(window as any).__escapeListenerAdded) {
    (window as any).__escapeListenerAdded = true;
    document.addEventListener('keydown', (e) => {
      const nav = document.getElementById('mobile-nav');
      const btn = document.getElementById('menu-toggle');
      if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
        nav.classList.remove('is-open');
        nav.querySelectorAll('.mobile-dropdown.is-open').forEach(d => d.classList.remove('is-open'));
        nav.querySelectorAll('.mobile-nested-dropdown.is-open').forEach(d => d.classList.remove('is-open'));
        btn?.classList.remove('is-active');
        document.body.style.overflow = '';
        btn?.focus();
      }
    });
  }

  // Handle window resize - only add once
  if (!(window as any).__resizeListenerAdded) {
    (window as any).__resizeListenerAdded = true;
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const nav = document.getElementById('mobile-nav');
        const btn = document.getElementById('menu-toggle');
        if (window.innerWidth >= 1024 && nav?.classList.contains('is-open')) {
          nav.classList.remove('is-open');
          nav.querySelectorAll('.mobile-dropdown.is-open').forEach(d => d.classList.remove('is-open'));
          nav.querySelectorAll('.mobile-nested-dropdown.is-open').forEach(d => d.classList.remove('is-open'));
          btn?.classList.remove('is-active');
          document.body.style.overflow = '';
        }
      }, 100);
    });
  }

  // Initialize on first load and after view transitions
  initNavigation();
  document.addEventListener('astro:after-swap', initNavigation);
</script>
