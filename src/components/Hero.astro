---
/**
 * Hero Wrapper Component
 * Dynamically switches between different hero versions.
 */
import HeroV1 from './HeroV1.astro';
import HeroV2 from './HeroV2.astro';
import HeroV3 from './HeroV3.astro';
import HeroV4 from './HeroV4.astro';
import HeroV5 from './HeroV5.astro';

export interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 ? <HeroV1 /> : 
 version === 2 ? <HeroV2 /> : 
 version === 3 ? <HeroV3 /> : 
 version === 4 ? <HeroV4 /> : 
 <HeroV5 />}
