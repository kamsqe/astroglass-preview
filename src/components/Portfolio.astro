---
import PortfolioLiquid from './portfolio/PortfolioLiquid.astro';
import PortfolioGlass from './portfolio/PortfolioGlass.astro';
import PortfolioNeo from './portfolio/PortfolioNeo.astro';
import PortfolioLuxury from './portfolio/PortfolioLuxury.astro';
import PortfolioMinimal from './portfolio/PortfolioMinimal.astro';

export interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 ? <PortfolioLiquid /> : 
 version === 2 ? <PortfolioGlass /> : 
 version === 3 ? <PortfolioNeo /> : 
 version === 4 ? <PortfolioLuxury /> : 
 <PortfolioMinimal />}
