---
/**
 * Portfolio V5 - Vertical Stage
 */
import { getLocaleFromUrl, useTranslations } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const projects = [
  { id: 1, title: t('portfolio.p1Title'), num: '01' },
  { id: 2, title: t('portfolio.p2Title'), num: '02' },
  { id: 3, title: t('portfolio.p3Title'), num: '03' },
  { id: 4, title: t('portfolio.p4Title'), num: '04' },
];
---

<section class="relative py-32 px-6">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-xs font-black tracking-[0.5em] text-accent uppercase mb-24 text-center">{t('portfolio.title')}</h2>

    <div class="space-y-4">
       {projects.map((p) => (
          <a href="#" class="stage-row group relative flex items-center justify-between py-12 border-b border-base-content/5 overflow-hidden transition-all duration-700">
             <div class="relative z-10 flex items-center gap-12">
                <span class="text-4xl md:text-6xl font-thin text-base-content/10 group-hover:text-accent group-hover:font-black transition-all duration-1000">{p.num}</span>
                <h3 class="text-5xl md:text-9xl font-black text-base-content tracking-tighter transition-all duration-1000 group-hover:translate-x-6">{p.title}</h3>
             </div>

             <!-- Floating Preview Image (Abstract Glass Card) -->
             <div class="absolute right-[5%] top-1/2 -translate-y-1/2 w-80 h-48 bg-accent/10 backdrop-blur-3xl rounded-3xl border border-accent/20 opacity-0 scale-50 -rotate-6 group-hover:opacity-100 group-hover:scale-100 group-hover:rotate-6 transition-all duration-[1200ms] cubic-bezier(0.16, 1, 0.3, 1) hidden lg:block pointer-events-none shadow-2xl">
                <div class="absolute inset-0 bg-gradient-to-tr from-accent/20 to-transparent"></div>
             </div>
             
             <div class="relative z-10 hidden md:block opacity-0 group-hover:opacity-100 transition-opacity duration-1000 pr-12">
                <div class="w-16 h-16 rounded-full border border-base-content/20 flex items-center justify-center">
                   <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </div>
             </div>
          </a>
       ))}
    </div>
  </div>
</section>

<style>
  .stage-row, .stage-row span, .stage-row h3, .stage-row div {
    transition: all 1500ms cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .stage-row:hover {
    padding-left: 40px;
    background: hsl(var(--bc) / 0.02);
  }
</style>
