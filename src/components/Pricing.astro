---
import PricingLiquid from './pricing/PricingLiquid.astro';
import PricingGlass from './pricing/PricingGlass.astro';
import PricingNeo from './pricing/PricingNeo.astro';
import PricingLuxury from './pricing/PricingLuxury.astro';
import PricingMinimal from './pricing/PricingMinimal.astro';

export interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 ? <PricingLiquid /> : 
 version === 2 ? <PricingGlass /> : 
 version === 3 ? <PricingNeo /> : 
 version === 4 ? <PricingLuxury /> : 
 <PricingMinimal />}
