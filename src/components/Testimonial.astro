---
import TestimonialLiquid from './testimonial/TestimonialLiquid.astro';
import TestimonialGlass from './testimonial/TestimonialGlass.astro';
import TestimonialNeo from './testimonial/TestimonialNeo.astro';
import TestimonialLuxury from './testimonial/TestimonialLuxury.astro';
import TestimonialMinimal from './testimonial/TestimonialMinimal.astro';

export interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 ? <TestimonialLiquid /> : 
 version === 2 ? <TestimonialGlass /> : 
 version === 3 ? <TestimonialNeo /> : 
 version === 4 ? <TestimonialLuxury /> : 
 <TestimonialMinimal />}
