---
/**
 * Testimonial - Version Switcher Wrapper
 * Renders the selected testimonial version based on prop.
 */
import TestimonialV1 from './TestimonialV1.astro';
import TestimonialV2 from './TestimonialV2.astro';
import TestimonialV3 from './TestimonialV3.astro';
import TestimonialV4 from './TestimonialV4.astro';
import TestimonialV5 from './TestimonialV5.astro';

interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 && <TestimonialV1 />}
{version === 2 && <TestimonialV2 />}
{version === 3 && <TestimonialV3 />}
{version === 4 && <TestimonialV4 />}
{version === 5 && <TestimonialV5 />}
