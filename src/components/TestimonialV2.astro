---
/**
 * Testimonial V2 - The Conversation Thread
 * Chat-style testimonials with typing indicators and message bubbles.
 * Mobile: Full-width chat with stacked meta. Desktop: Centered chat window.
 */
import { getLocaleFromUrl, useTranslations } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const messages = [
  {
    quote: t('testimonial.chat1'),
    author: "Alex Turner",
    role: t('testimonial.roles.indie'),
    company: "",
    avatar: "https://i.pravatar.cc/150?img=11",
    time: t('testimonial.time.2m'),
    reactions: [{ emoji: "🔥", count: 24 }, { emoji: "💯", count: 12 }]
  },
  {
    quote: t('testimonial.chat2'),
    author: "Priya Sharma",
    role: t('testimonial.roles.lead'),
    company: t('testimonial.companies.stripe'),
    avatar: "https://i.pravatar.cc/150?img=23",
    time: t('testimonial.time.15m'),
    reactions: [{ emoji: "❤️", count: 47 }, { emoji: "🙌", count: 18 }],
    verified: true
  },
  {
    quote: t('testimonial.chat3'),
    author: "James Wilson",
    role: t('testimonial.roles.senior'),
    company: t('testimonial.companies.shopify'),
    avatar: "https://i.pravatar.cc/150?img=33",
    time: t('testimonial.time.1h'),
    reactions: [{ emoji: "👏", count: 31 }]
  },
  {
    quote: t('testimonial.chat4'),
    author: "Maria Santos",
    role: t('testimonial.roles.founder'),
    company: t('testimonial.companies.launchpad'),
    avatar: "https://i.pravatar.cc/150?img=44",
    time: t('testimonial.time.3h'),
    reactions: [{ emoji: "🎉", count: 89 }, { emoji: "💪", count: 23 }]
  },
  {
    quote: t('testimonial.chat5'),
    author: "Chen Wei",
    role: t('testimonial.roles.cto'),
    company: t('testimonial.companies.techflow'),
    avatar: "https://i.pravatar.cc/150?img=52",
    time: t('testimonial.yesterday'),
    reactions: [{ emoji: "📈", count: 15 }],
    verified: true
  },
];
---

<section class="relative py-24 lg:py-32 px-6 overflow-hidden bg-base-100">
  <div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12">
       <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full bg-accent/10 border border-accent/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          <span class="text-xs font-bold text-accent">{messages.length} {t('testimonial.peopleTalking')}</span>
       </div>
       <h2 class="text-4xl md:text-6xl font-black text-base-content tracking-tighter">{t('testimonial.buzz')}</h2>
    </div>

    <!-- Chat Container -->
    <div class="chat-container relative">
       <!-- Messages -->
       <div class="space-y-6">
          {messages.map((m, i) => (
             <div 
               class="chat-message opacity-0 translate-y-4"
               data-delay={i * 150}
               style={`animation-delay: ${i * 150}ms`}
             >
                <div class="flex gap-3 sm:gap-4">
                   <!-- Avatar -->
                   <div class="flex-shrink-0">
                      <div class="relative">
                         <img 
                           src={m.avatar} 
                           alt={m.author} 
                           class="w-10 h-10 sm:w-12 sm:h-12 rounded-full object-cover border-2 border-base-content/10"
                         />
                         {m.verified && (
                            <div class="absolute -bottom-1 -right-1 w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-accent flex items-center justify-center">
                               <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-base-100" fill="currentColor" viewBox="0 0 20 20">
                                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                               </svg>
                            </div>
                         )}
                      </div>
                   </div>

                   <!-- Bubble -->
                   <div class="flex-1 min-w-0">
                      <!-- Desktop: inline meta -->
                      <div class="hidden sm:flex items-center gap-2 mb-2">
                         <span class="text-sm font-bold text-base-content">{m.author}</span>
                         <span class="text-xs text-base-content/30 truncate">{m.role}{m.company ? `, ${m.company}` : ''}</span>
                         <span class="text-xs text-base-content/20">· {m.time}</span>
                      </div>
                      
                      <!-- Mobile: stacked meta -->
                      <div class="sm:hidden mb-2">
                         <div class="flex items-center gap-2">
                            <span class="text-sm font-bold text-base-content">{m.author}</span>
                            <span class="text-xs text-base-content/20">{m.time}</span>
                         </div>
                         <span class="text-xs text-base-content/40">{m.role}{m.company ? `, ${m.company}` : ''}</span>
                      </div>
                      
                      <div class="chat-bubble relative p-4 sm:p-5 rounded-2xl rounded-tl-md bg-base-content/[0.04] border border-base-content/5">
                         <p class="text-sm sm:text-base text-base-content/80 leading-relaxed">{m.quote}</p>
                      </div>

                      <!-- Reactions -->
                      {m.reactions && (
                         <div class="flex flex-wrap gap-2 mt-3">
                            {m.reactions.map(r => (
                               <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-base-content/[0.03] border border-base-content/5 hover:bg-base-content/[0.06] transition-colors cursor-pointer">
                                  <span class="text-sm">{r.emoji}</span>
                                  <span class="text-xs font-bold text-base-content/50">{r.count}</span>
                               </div>
                            ))}
                         </div>
                      )}
                   </div>
                </div>
             </div>
          ))}
       </div>

       <!-- Typing Indicator -->
       <div class="typing-indicator flex gap-3 sm:gap-4 mt-8 opacity-60">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-base-content/5 border border-base-content/10 flex items-center justify-center">
             <span class="text-base sm:text-lg">💬</span>
          </div>
          <div class="flex items-center gap-1.5 px-4 sm:px-5 py-3 rounded-2xl rounded-tl-md bg-base-content/[0.03] border border-base-content/5">
             <div class="typing-dot w-2 h-2 rounded-full bg-base-content/30"></div>
             <div class="typing-dot w-2 h-2 rounded-full bg-base-content/30"></div>
             <div class="typing-dot w-2 h-2 rounded-full bg-base-content/30"></div>
          </div>
       </div>
    </div>
  </div>
</section>

<style>
  .chat-message {
    animation: chatFadeIn 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes chatFadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .chat-bubble {
    transition: all 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .chat-message:hover .chat-bubble {
    background: hsl(var(--bc) / 0.06);
    border-color: hsl(var(--bc) / 0.1);
  }

  .typing-dot {
    animation: typingBounce 1.4s infinite ease-in-out;
  }
  .typing-dot:nth-child(1) { animation-delay: 0ms; }
  .typing-dot:nth-child(2) { animation-delay: 200ms; }
  .typing-dot:nth-child(3) { animation-delay: 400ms; }

  @keyframes typingBounce {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-4px); }
  }
</style>

<script>
  function initChatMessages() {
    const messages = document.querySelectorAll('.chat-message');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const delay = parseInt((entry.target as HTMLElement).dataset.delay || '0');
          setTimeout(() => {
            entry.target.classList.add('animate');
          }, delay);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    messages.forEach(m => observer.observe(m));
  }

  initChatMessages();
  document.addEventListener('astro:after-swap', initChatMessages);
</script>
