---
/**
 * Testimonial V4 - The Masonry Wall
 * Pinterest-style staggered grid with varied card heights.
 * Mobile: 2-column masonry. Desktop: 4-column with featured highlights.
 */
import { getLocaleFromUrl, useTranslations } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const testimonials = [
  {
    quote: t('testimonial.t4_quote1'),
    author: t('testimonial.t4_author1'),
    role: t('testimonial.t4_role1'),
    avatar: "https://i.pravatar.cc/150?img=1",
    size: "small",
    accent: false
  },
  {
    quote: t('testimonial.t4_quote2'),
    author: t('testimonial.t4_author2'),
    role: t('testimonial.t4_role2'),
    avatar: "https://i.pravatar.cc/150?img=5",
    size: "large",
    accent: true
  },
  {
    quote: t('testimonial.t4_quote3'),
    author: t('testimonial.t4_author3'),
    role: t('testimonial.t4_role3'),
    avatar: "https://i.pravatar.cc/150?img=8",
    size: "medium",
    accent: false
  },
  {
    quote: t('testimonial.t4_quote4'),
    author: t('testimonial.t4_author4'),
    role: t('testimonial.t4_role4'),
    avatar: "https://i.pravatar.cc/150?img=10",
    size: "medium",
    accent: false
  },
  {
    quote: t('testimonial.t4_quote5'),
    author: t('testimonial.t4_author5'),
    role: t('testimonial.t4_role5'),
    avatar: "https://i.pravatar.cc/150?img=11",
    size: "small",
    accent: false
  },
  {
    quote: t('testimonial.t4_quote6'),
    author: t('testimonial.t4_author6'),
    role: t('testimonial.t4_role6'),
    avatar: "https://i.pravatar.cc/150?img=12",
    size: "large",
    accent: true
  },
  {
    quote: t('testimonial.t4_quote7'),
    author: t('testimonial.t4_author7'),
    role: t('testimonial.t4_role7'),
    avatar: "https://i.pravatar.cc/150?img=20",
    size: "small",
    accent: false
  },
  {
    quote: t('testimonial.t4_quote8'),
    author: t('testimonial.t4_author8'),
    role: t('testimonial.t4_role8'),
    avatar: "https://i.pravatar.cc/150?img=15",
    size: "medium",
    accent: false
  },
];
---

<section class="relative py-24 lg:py-32 px-6 overflow-hidden bg-base-100">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
       <span class="text-[10px] font-black uppercase tracking-[0.5em] text-accent mb-4 block">{t('testimonial.wallOfLove')}</span>
       <h2 class="text-4xl md:text-6xl font-black text-base-content tracking-tighter">{t('testimonial.buildersSay')}</h2>
       <p class="text-base text-base-content/40 mt-4 max-w-xl mx-auto">{t('testimonial.t4_subtitle')}</p>
    </div>

    <!-- Masonry Grid -->
    <div class="masonry-grid columns-2 lg:columns-3 xl:columns-4 gap-4 lg:gap-6">
       {testimonials.map((item, i) => (
          <div 
            class="masonry-card break-inside-avoid mb-4 lg:mb-6 group"
            style={`animation-delay: ${i * 80}ms`}
          >
             <div class:list={[
               "relative p-5 lg:p-6 rounded-2xl lg:rounded-[1.5rem] border transition-all duration-700 overflow-hidden",
               item.accent 
                 ? "bg-accent/5 border-accent/20 hover:bg-accent/10 hover:border-accent/30" 
                 : "bg-base-content/[0.02] border-base-content/5 hover:bg-base-content/[0.05] hover:border-base-content/15",
               item.size === 'large' ? "lg:p-8" : ""
             ]}>
                <!-- Accent glow for featured -->
                {item.accent && (
                   <div class="absolute inset-0 bg-gradient-to-br from-accent/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
                )}
                
                <div class="relative z-10">
                   <!-- Quote Icon for large cards -->
                   {item.size === 'large' && (
                      <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center mb-4">
                         <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                         </svg>
                      </div>
                   )}
                   
                   <!-- Quote -->
                   <p class:list={[
                     "text-base-content/70 leading-relaxed mb-5",
                     item.size === 'large' ? "text-base lg:text-lg font-medium" : "text-sm",
                     item.size === 'small' ? "text-sm font-medium" : ""
                   ]}>
                      "{item.quote}"
                   </p>

                   <!-- Author -->
                   <div class="flex items-center gap-3">
                      <img 
                        src={item.avatar} 
                        alt={item.author} 
                        class:list={[
                          "rounded-full object-cover border",
                          item.accent ? "border-accent/20" : "border-base-content/10",
                          item.size === 'large' ? "w-11 h-11" : "w-9 h-9"
                        ]}
                      />
                      <div>
                         <p class:list={[
                           "font-bold text-base-content",
                           item.size === 'large' ? "text-sm" : "text-xs"
                         ]}>{item.author}</p>
                         <p class:list={[
                           item.accent ? "text-accent/60" : "text-base-content/40",
                           item.size === 'large' ? "text-xs" : "text-[10px]"
                         ]}>{item.role}</p>
                      </div>
                   </div>
                </div>
             </div>
          </div>
       ))}
    </div>

    <!-- Stats Row -->
    <div class="flex flex-wrap justify-center gap-8 lg:gap-16 mt-16 pt-16 border-t border-base-content/5">
       <div class="text-center">
          <p class="text-3xl lg:text-4xl font-black text-base-content">10K+</p>
          <p class="text-xs text-base-content/40 mt-1">{t('testimonial.happyUsers')}</p>
       </div>
       <div class="text-center">
          <p class="text-3xl lg:text-4xl font-black text-accent">4.9</p>
          <p class="text-xs text-base-content/40 mt-1">{t('testimonial.avgRating')}</p>
       </div>
       <div class="text-center">
          <p class="text-3xl lg:text-4xl font-black text-base-content">50+</p>
          <p class="text-xs text-base-content/40 mt-1">{t('testimonial.countries')}</p>
       </div>
    </div>
  </div>
</section>

<style>
  .masonry-card {
    opacity: 0;
    animation: masonryFadeIn 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes masonryFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .masonry-card > div {
    transition: all 700ms cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .masonry-card:hover > div {
    transform: translateY(-4px) scale(1.01);
  }

  @media (min-width: 1024px) {
    .masonry-card:hover > div {
      transform: translateY(-6px) scale(1.02);
    }
  }
</style>
