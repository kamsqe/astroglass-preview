---
/**
 * CTA V5 - The Terminal Prompt (REMARKABLE)
 * Hacker/dev-aesthetic CTA disguised as a terminal command.
 * Appeals to developer audience with authentic coding feel.
 */
import { getLocaleFromUrl, useTranslations } from '../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const terminalData = JSON.stringify({
  devsOnline: t('cta.terminal.devsOnline'),
  deploysMin: t('cta.terminal.deploysMin')
});
---

<section class="relative py-20 lg:py-32 px-4 sm:px-6 overflow-hidden bg-base-100">
  <!-- Scanline overlay -->
  <div class="cta-v5-scanlines absolute inset-0 pointer-events-none opacity-[0.02]"></div>
  
  <!-- Glow background -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-accent/5 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-4xl mx-auto relative">
    <!-- Terminal Window -->
    <div class="cta-v5-terminal relative rounded-xl sm:rounded-2xl lg:rounded-3xl overflow-hidden bg-[#0d1117] border border-white/10 shadow-[0_20px_60px_rgba(0,0,0,0.3)] sm:shadow-[0_40px_100px_rgba(0,0,0,0.4)]" data-terminal={terminalData}>
      
      <!-- Terminal Header -->
      <div class="flex items-center gap-2 sm:gap-3 px-3 sm:px-4 py-2.5 sm:py-3 bg-white/5 border-b border-white/10">
        <!-- Traffic lights -->
        <div class="flex items-center gap-1.5 sm:gap-2">
          <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#ff5f56]"></div>
          <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#ffbd2e]"></div>
          <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#27c93f]"></div>
        </div>
        
        <!-- Tab -->
        <div class="flex-1 flex items-center justify-center">
          <div class="hidden sm:flex items-center gap-2 px-4 py-1 rounded-lg bg-white/5 text-white/40 text-sm font-mono">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span>{t('cta.terminal.tab')}</span>
          </div>
          <span class="sm:hidden text-xs text-white/30 font-mono">terminal</span>
        </div>

        <!-- Spacer for symmetry -->
        <div class="w-[40px] sm:w-[52px]"></div>
      </div>

      <!-- Terminal Body -->
      <div class="p-4 sm:p-6 lg:p-8 font-mono text-xs sm:text-sm lg:text-base space-y-3 sm:space-y-4">
        <!-- Previous commands -->
        <div class="space-y-2 sm:space-y-3 text-white/60">
          <!-- Command 1 -->
          <div class="flex items-start gap-2">
            <span class="text-accent shrink-0">→</span>
            <span class="text-[#79c0ff]">git</span>
            <span>clone success-story</span>
          </div>
          <div class="pl-4 sm:pl-5 text-white/40 text-[10px] sm:text-xs lg:text-sm">
            {t('cta.terminal.cloning')}
          </div>

          <!-- Command 2 -->
          <div class="flex items-start gap-2 mt-3 sm:mt-4">
            <span class="text-accent shrink-0">→</span>
            <span class="text-[#79c0ff]">npm</span>
            <span>run build</span>
          </div>
          <div class="pl-4 sm:pl-5 text-[#3fb950] text-[10px] sm:text-xs lg:text-sm flex items-center gap-2">
            <span>✓</span>
            <span>{t('cta.terminal.built')}</span>
          </div>

          <!-- Command 3 -->
          <div class="flex items-start gap-2 mt-3 sm:mt-4">
            <span class="text-accent shrink-0">→</span>
            <span class="text-[#79c0ff]">deploy</span>
            <span>--prod</span>
          </div>
          <div class="pl-4 sm:pl-5 text-[#3fb950] text-[10px] sm:text-xs lg:text-sm flex items-center gap-2">
            <span>✓</span>
            <span>{t('cta.terminal.live')} <span class="text-[#79c0ff]">yourapp.com</span></span>
          </div>
        </div>

        <!-- Divider -->
        <div class="h-px bg-white/10 my-4 sm:my-6"></div>

        <!-- Current prompt - The CTA -->
        <div class="cta-v5-prompt space-y-3 sm:space-y-4">
          <!-- The question -->
          <div class="flex items-start gap-2">
            <span class="text-accent shrink-0">→</span>
            <span class="text-white text-xs sm:text-sm lg:text-base">{t('cta.terminal.ready')}</span>
            <span class="cta-v5-cursor w-1.5 sm:w-2 h-4 sm:h-5 bg-accent inline-block ml-1"></span>
          </div>

          <!-- Options -->
          <div class="cta-v5-options pl-4 sm:pl-5 space-y-2 sm:space-y-3 mt-4 sm:mt-6">
            <button class="cta-v5-option group flex items-center gap-2 sm:gap-3 text-white/60 hover:text-white transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" data-action="start">
              <span class="flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 rounded-md bg-accent/10 text-accent text-[10px] sm:text-xs font-bold group-hover:bg-accent group-hover:text-base-100 transition-all duration-700">1</span>
              <span class="text-xs sm:text-sm">{t('cta.terminal.option1')}</span>
              <span class="text-accent opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-700">→</span>
            </button>

            <button class="cta-v5-option group flex items-center gap-2 sm:gap-3 text-white/60 hover:text-white transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" data-action="demo">
              <span class="flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 rounded-md bg-white/5 text-white/40 text-[10px] sm:text-xs font-bold group-hover:bg-white/10 group-hover:text-white/80 transition-all duration-700">2</span>
              <span class="text-xs sm:text-sm">{t('cta.terminal.option2')}</span>
              <span class="text-white/40 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-700">→</span>
            </button>

            <button class="cta-v5-option group flex items-center gap-2 sm:gap-3 text-white/60 hover:text-white transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" data-action="docs">
              <span class="flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 rounded-md bg-white/5 text-white/40 text-[10px] sm:text-xs font-bold group-hover:bg-white/10 group-hover:text-white/80 transition-all duration-700">3</span>
              <span class="text-xs sm:text-sm">{t('cta.terminal.option3')}</span>
              <span class="text-white/40 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-700">→</span>
            </button>
          </div>

          <!-- Keyboard hint (desktop only) -->
          <div class="hidden sm:flex pl-5 mt-6 items-center gap-4 text-white/30 text-xs">
            <span class="flex items-center gap-1">
              <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-white/50">↑</kbd>
              <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-white/50">↓</kbd>
              {t('cta.terminal.navigate')}
            </span>
            <span class="flex items-center gap-1">
              <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-white/50">enter</kbd>
              {t('cta.terminal.select')}
            </span>
          </div>
        </div>

        <!-- Live stats bar -->
        <div class="cta-v5-stats flex items-center gap-4 sm:gap-6 mt-6 sm:mt-8 pt-4 sm:pt-6 border-t border-white/10 text-white/40 text-[10px] sm:text-xs">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-[#3fb950] animate-pulse"></span>
            <span class="cta-v5-devs-count">847</span>
            <span class="cta-v5-devs-label">{t('cta.terminal.devsOnline')}</span>
          </div>
          <div class="hidden sm:flex items-center gap-2">
            <span>⚡</span>
            <span>23 {t('cta.terminal.deploysMin')}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Ambient glow under terminal -->
    <div class="absolute -bottom-6 sm:-bottom-10 left-1/2 -translate-x-1/2 w-2/3 sm:w-3/4 h-12 sm:h-20 bg-accent/20 blur-[40px] sm:blur-[60px] rounded-full pointer-events-none"></div>
  </div>
</section>

<style>
  /* Cursor blink */
  .cta-v5-cursor {
    animation: cursorBlink 1s ease-in-out infinite;
  }

  @keyframes cursorBlink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* Scanlines effect */
  .cta-v5-scanlines {
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255, 255, 255, 0.03) 2px,
      rgba(255, 255, 255, 0.03) 4px
    );
  }

  /* Terminal glow on hover */
  .cta-v5-terminal {
    transition: box-shadow 1200ms cubic-bezier(0.16, 1, 0.3, 1), 
                transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .cta-v5-terminal:hover {
    box-shadow: 0 50px 120px rgba(0, 0, 0, 0.5),
                0 0 80px rgba(var(--a), 0.1);
    transform: translateY(-4px);
  }

  /* Option hover state */
  .cta-v5-option {
    position: relative;
    padding: 0.5rem 0.75rem;
    margin-left: -0.75rem;
    border-radius: 0.5rem;
    transition: background 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-v5-option:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .cta-v5-option[data-action="start"]:hover {
    background: rgba(var(--a), 0.1);
  }

  /* Stats counter animation */
  .cta-v5-stats span {
    transition: color 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-v5-terminal:hover .cta-v5-stats span {
    color: rgba(255, 255, 255, 0.6);
  }
</style>

<script>
  function initTerminalCTA() {
    const terminal = document.querySelector('.cta-v5-terminal') as HTMLElement;
    if (!terminal) return;
    
    const options = document.querySelectorAll('.cta-v5-option');
    let selectedIndex = 0;

    const terminalData = terminal.dataset.terminal ? JSON.parse(terminal.dataset.terminal) : {};

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      const rect = terminal.getBoundingClientRect();
      const isVisible = rect.top < window.innerHeight && rect.bottom > 0;
      
      if (!isVisible) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, options.length - 1);
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        updateSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const selectedOption = options[selectedIndex] as HTMLElement;
        if (selectedOption) {
          selectedOption.click();
          selectedOption.style.transform = 'scale(0.98)';
          setTimeout(() => {
            selectedOption.style.transform = '';
          }, 150);
        }
      } else if (e.key >= '1' && e.key <= '3') {
        e.preventDefault();
        const index = parseInt(e.key) - 1;
        if (index < options.length) {
          selectedIndex = index;
          updateSelection();
          (options[index] as HTMLElement).click();
        }
      }
    });

    function updateSelection() {
      options.forEach((option, index) => {
        if (index === selectedIndex) {
          option.classList.add('text-white');
          option.classList.remove('text-white/60');
        } else {
          option.classList.remove('text-white');
          option.classList.add('text-white/60');
        }
      });
    }

    // Click handlers
    options.forEach((option) => {
      option.addEventListener('click', () => {
        const action = option.getAttribute('data-action');
        console.log('CTA action:', action);
      });
    });

    // Live stats animation
    const devsCountEl = terminal.querySelector('.cta-v5-devs-count');
    if (devsCountEl) {
      setInterval(() => {
        const current = parseInt(devsCountEl.textContent || '847');
        const change = Math.floor(Math.random() * 10) - 5;
        const newCount = Math.max(800, current + change);
        devsCountEl.textContent = String(newCount);
      }, 3000);
    }
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', initTerminalCTA);
  document.addEventListener('astro:page-load', initTerminalCTA);
</script>
