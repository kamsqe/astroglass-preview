---
/**
 * Command Palette - Search Component
 * 
 * Clean, minimal search with proper scroll-to-section and pulse highlight.
 */
import { useTranslations } from '../../utils/i18n';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'ru');
---

<!-- Overlay -->
<div id="cmd-overlay"></div>

<!-- Modal -->
<div id="cmd-modal" aria-modal="true">
  <div class="cmd-search-box">
    <svg class="cmd-search-icon" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
    </svg>
    <input 
      id="cmd-input"
      type="text"
      placeholder="Search documentation..."
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
    />
    <kbd class="cmd-esc">ESC</kbd>
  </div>
  <div id="cmd-content">
    <div class="cmd-placeholder">
      <p>Type to search</p>
      <div class="cmd-keys">
        <span><kbd>↑↓</kbd> Navigate</span>
        <span><kbd>↵</kbd> Open</span>
      </div>
    </div>
  </div>
</div>

<style>
  #cmd-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(6px);
    z-index: 9000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  #cmd-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  #cmd-modal {
    position: fixed;
    top: 15%;
    left: 50%;
    transform: translateX(-50%) translateY(-10px);
    width: 500px;
    max-width: calc(100vw - 32px);
    background: hsl(var(--b1));
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.4), 0 0 0 1px hsl(var(--bc) / 0.1);
    z-index: 9001;
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s ease;
    overflow: hidden;
  }
  #cmd-modal.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .cmd-search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid hsl(var(--bc) / 0.1);
  }
  .cmd-search-icon {
    width: 16px;
    height: 16px;
    color: hsl(var(--bc) / 0.4);
    flex-shrink: 0;
  }
  #cmd-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 15px;
    font-weight: 500;
    color: hsl(var(--bc));
    outline: none;
  }
  #cmd-input::placeholder {
    color: hsl(var(--bc) / 0.35);
    font-weight: 400;
  }
  .cmd-esc {
    font-size: 10px;
    padding: 4px 8px;
    background: hsl(var(--bc) / 0.07);
    border-radius: 5px;
    color: hsl(var(--bc) / 0.4);
    font-family: system-ui, sans-serif;
    font-weight: 500;
  }

  #cmd-content {
    max-height: 300px;
    overflow-y: auto;
  }

  .cmd-placeholder {
    padding: 28px 16px;
    text-align: center;
  }
  .cmd-placeholder p {
    font-size: 13px;
    color: hsl(var(--bc) / 0.4);
    margin-bottom: 12px;
  }
  .cmd-keys {
    display: flex;
    justify-content: center;
    gap: 16px;
    font-size: 11px;
    color: hsl(var(--bc) / 0.3);
  }
  .cmd-keys span {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .cmd-keys kbd {
    font-size: 10px;
    padding: 2px 5px;
    background: hsl(var(--bc) / 0.05);
    border-radius: 3px;
    font-family: system-ui;
  }

  .cmd-loading {
    padding: 28px 16px;
    text-align: center;
    font-size: 13px;
    color: hsl(var(--bc) / 0.4);
  }

  .cmd-empty {
    padding: 28px 16px;
    text-align: center;
    font-size: 13px;
    color: hsl(var(--bc) / 0.4);
  }

  .cmd-list {
    padding: 6px;
  }
  .cmd-link {
    display: block;
    padding: 10px 12px;
    border-radius: 8px;
    text-decoration: none;
    margin-bottom: 2px;
    transition: background 0.1s;
  }
  .cmd-link:last-child {
    margin-bottom: 0;
  }
  .cmd-link:hover,
  .cmd-link.active {
    background: hsl(var(--a) / 0.1);
  }
  .cmd-link-title {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: hsl(var(--bc));
    margin-bottom: 2px;
  }
  .cmd-link:hover .cmd-link-title,
  .cmd-link.active .cmd-link-title {
    color: hsl(var(--a));
  }
  .cmd-link-excerpt {
    display: block;
    font-size: 11px;
    color: hsl(var(--bc) / 0.5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cmd-link-excerpt :global(mark) {
    background: hsl(var(--wa) / 0.35);
    color: inherit;
    padding: 0 2px;
    border-radius: 2px;
    font-weight: 500;
  }
</style>

<script>
  let pf: any = null;
  let data: any[] = [];
  let idx = 0;

  function setup() {
    const overlay = document.getElementById('cmd-overlay');
    const modal = document.getElementById('cmd-modal');
    const input = document.getElementById('cmd-input') as HTMLInputElement;
    const content = document.getElementById('cmd-content');
    if (!overlay || !modal || !input || !content) return;

    // Load pagefind
    (async () => {
      try {
        pf = await (new Function(`return import("/pagefind/pagefind.js")`))();
        await pf.init();
      } catch {}
    })();

    const placeholder = () => {
      content.innerHTML = `
        <div class="cmd-placeholder">
          <p>Type to search</p>
          <div class="cmd-keys">
            <span><kbd>↑↓</kbd> Navigate</span>
            <span><kbd>↵</kbd> Open</span>
          </div>
        </div>
      `;
    };

    const open = () => {
      overlay.classList.add('open');
      modal.classList.add('open');
      input.value = '';
      input.focus();
      placeholder();
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      overlay.classList.remove('open');
      modal.classList.remove('open');
      data = [];
      idx = 0;
      document.body.style.overflow = '';
    };

    const render = () => {
      if (!data.length) {
        content.innerHTML = `<div class="cmd-empty">No results</div>`;
        return;
      }
      const q = encodeURIComponent(input.value.trim());
      content.innerHTML = `<div class="cmd-list">${data.map((r, i) => {
        const title = r.meta?.title || 'Untitled';
        const excerpt = (r.excerpt || '').replace(/<[^>]+>/g, '').slice(0, 80);
        const url = r.url.replace(/\.html$/, '').replace(/\/index$/, '');
        return `
          <a href="${url}?hl=${q}" class="cmd-link ${i === idx ? 'active' : ''}" data-i="${i}">
            <span class="cmd-link-title">${title}</span>
            <span class="cmd-link-excerpt">${excerpt}...</span>
          </a>
        `;
      }).join('')}</div>`;
      content.querySelectorAll('.cmd-link').forEach(el => el.addEventListener('click', close));
    };

    let t: any;
    input.addEventListener('input', () => {
      clearTimeout(t);
      const q = input.value.trim();
      if (!q || q.length < 2) { data = []; placeholder(); return; }
      if (!pf) return;
      t = setTimeout(async () => {
        content.innerHTML = `<div class="cmd-loading">Searching...</div>`;
        try {
          const res = await pf.search(q);
          const all = await Promise.all(res.results.slice(0, 8).map((r: any) => r.data()));
          data = all.filter((r: any) => r.url.includes('/docs/')).slice(0, 5);
          idx = 0;
          render();
        } catch {
          content.innerHTML = `<div class="cmd-empty">Error</div>`;
        }
      }, 100);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); idx = Math.min(idx + 1, data.length - 1); render(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); idx = Math.max(idx - 1, 0); render(); }
      else if (e.key === 'Enter' && data[idx]) {
        e.preventDefault();
        const url = data[idx].url.replace(/\.html$/, '').replace(/\/index$/, '');
        window.location.href = `${url}?hl=${encodeURIComponent(input.value.trim())}`;
        close();
      }
      else if (e.key === 'Escape') close();
    });

    overlay.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); open(); }
      if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) { e.preventDefault(); open(); }
    });

    placeholder();
  }

  // Highlight & scroll to matched section
  function highlight() {
    const params = new URLSearchParams(window.location.search);
    const q = params.get('hl');
    if (!q || q.length < 2) return;

    const body = document.querySelector('[data-pagefind-body]');
    if (!body) return;

    // Find first text node containing the query
    const walker = document.createTreeWalker(body, NodeFilter.SHOW_TEXT);
    let target: Node | null = null;
    const searchTerm = q.toLowerCase();
    
    while (walker.nextNode()) {
      const text = walker.currentNode.textContent?.toLowerCase() || '';
      if (text.includes(searchTerm)) {
        target = walker.currentNode;
        break;
      }
    }

    if (!target) return;

    // Find the closest section (heading or first ancestor with an ID)
    let section: HTMLElement | null = null;
    let node = target.parentElement;
    
    while (node && node !== body) {
      // Check if this node itself is a heading
      if (['H1', 'H2', 'H3', 'H4'].includes(node.tagName)) {
        section = node;
        break;
      }
      // Check if this node has an ID (anchor point)
      if (node.id) {
        section = node;
        break;
      }
      // Check if previous sibling is a heading
      let prev = node.previousElementSibling;
      while (prev) {
        if (['H1', 'H2', 'H3', 'H4'].includes(prev.tagName)) {
          section = prev as HTMLElement;
          break;
        }
        prev = prev.previousElementSibling;
      }
      if (section) break;
      node = node.parentElement;
    }

    // If no section found, use the target's parent
    if (!section) {
      section = target.parentElement;
    }

    if (!section) return;

    // Scroll to section
    setTimeout(() => {
      const y = section!.getBoundingClientRect().top + window.scrollY - 100;
      window.scrollTo({ top: y, behavior: 'smooth' });
    }, 100);

    // Pulse animation
    setTimeout(() => {
      section!.classList.add('hl-pulse');
    }, 400);

    setTimeout(() => {
      section!.classList.remove('hl-pulse');
    }, 1800);

    // Clean URL
    history.replaceState(null, '', window.location.pathname);
  }

  setup();
  highlight();
  document.addEventListener('astro:after-swap', () => { setup(); highlight(); });
</script>

<style is:global>
  .hl-pulse {
    animation: hlPulse 1.2s ease-out;
    border-radius: 6px;
  }
  @keyframes hlPulse {
    0% {
      background: hsl(var(--a) / 0.2);
      box-shadow: 0 0 0 4px hsl(var(--a) / 0.15);
    }
    100% {
      background: transparent;
      box-shadow: 0 0 0 0 transparent;
    }
  }
</style>
