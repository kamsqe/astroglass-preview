---
/**
 * Command Palette Component
 * 
 * Premium keyboard-activated search overlay (⌘K / Ctrl+K).
 * Scoped to documentation content only via Pagefind filtering.
 * Theme-aware styling for all color modes.
 */
import { useTranslations } from '../../utils/i18n';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'ru');
---

<!-- Backdrop -->
<div id="command-palette-backdrop" class="cmd-backdrop"></div>

<!-- Palette -->
<div id="command-palette" class="cmd-palette" role="dialog" aria-modal="true" aria-label="Search documentation">
  <div class="cmd-header">
    <div class="cmd-search-row">
      <svg class="cmd-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        type="text" 
        id="command-palette-input"
        class="cmd-input" 
        placeholder={t('docs.searchPlaceholder') || 'Search documentation...'}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <kbd class="cmd-kbd">ESC</kbd>
    </div>
  </div>
  
  <div id="command-palette-results" class="cmd-body">
    <div class="cmd-empty">
      <p class="cmd-empty-text">{t('docs.typeToSearch') || 'Type to search documentation'}</p>
      <div class="cmd-shortcuts">
        <span><kbd>⌘K</kbd> to open</span>
        <span><kbd>↑↓</kbd> navigate</span>
        <span><kbd>↵</kbd> select</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Backdrop */
  .cmd-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
  }
  .cmd-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Modal */
  .cmd-palette {
    position: fixed;
    top: 15%;
    left: 50%;
    transform: translateX(-50%) translateY(-12px) scale(0.96);
    width: calc(100% - 32px);
    max-width: 580px;
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--bc) / 0.1);
    border-radius: 20px;
    box-shadow: 
      0 24px 48px -12px rgba(0, 0, 0, 0.35),
      0 0 0 1px hsl(var(--bc) / 0.05);
    z-index: 9999;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .cmd-palette.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  /* Header */
  .cmd-header {
    padding: 16px 20px;
    border-bottom: 1px solid hsl(var(--bc) / 0.08);
    background: hsl(var(--bc) / 0.02);
  }
  .cmd-search-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .cmd-icon {
    width: 22px;
    height: 22px;
    color: hsl(var(--a));
    opacity: 0.65;
    flex-shrink: 0;
  }
  .cmd-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 17px;
    font-weight: 500;
    outline: none;
    color: hsl(var(--bc));
    min-width: 0;
  }
  .cmd-input::placeholder {
    color: hsl(var(--bc) / 0.35);
  }
  .cmd-kbd {
    font-size: 11px;
    padding: 5px 10px;
    background: hsl(var(--bc) / 0.06);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 6px;
    font-family: ui-monospace, monospace;
    font-weight: 600;
    color: hsl(var(--bc) / 0.4);
    flex-shrink: 0;
  }

  /* Body */
  .cmd-body {
    max-height: 400px;
    overflow-y: auto;
    padding: 12px;
  }

  /* Empty state */
  .cmd-empty {
    padding: 48px 24px;
    text-align: center;
  }
  .cmd-empty-text {
    font-size: 15px;
    font-weight: 500;
    color: hsl(var(--bc) / 0.45);
    margin-bottom: 20px;
  }
  .cmd-shortcuts {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 12px;
    color: hsl(var(--bc) / 0.35);
  }
  .cmd-shortcuts span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cmd-shortcuts kbd {
    font-size: 10px;
    padding: 3px 7px;
    background: hsl(var(--bc) / 0.05);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 5px;
    font-family: ui-monospace, monospace;
    font-weight: 600;
  }

  /* Loading */
  .cmd-loading {
    padding: 48px 24px;
    text-align: center;
    font-size: 14px;
    color: hsl(var(--bc) / 0.4);
  }

  /* No results */
  .cmd-no-results {
    padding: 48px 24px;
    text-align: center;
    font-size: 14px;
    color: hsl(var(--bc) / 0.4);
  }

  /* Result items */
  .cmd-item {
    display: block;
    padding: 14px 16px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    margin-bottom: 4px;
    border: 1px solid transparent;
  }
  .cmd-item:hover,
  .cmd-item.is-active {
    background: hsl(var(--a) / 0.06);
    border-color: hsl(var(--a) / 0.12);
  }
  .cmd-item.is-active {
    background: hsl(var(--a) / 0.1);
  }
  .cmd-item-title {
    display: block;
    font-weight: 700;
    font-size: 15px;
    color: hsl(var(--bc));
    margin-bottom: 4px;
  }
  .cmd-item:hover .cmd-item-title,
  .cmd-item.is-active .cmd-item-title {
    color: hsl(var(--a));
  }
  .cmd-item-excerpt {
    display: block;
    font-size: 13px;
    color: hsl(var(--bc) / 0.55);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cmd-item-excerpt mark {
    background: hsl(var(--a) / 0.15);
    color: hsl(var(--a));
    padding: 0 3px;
    border-radius: 3px;
    font-weight: 600;
  }
  .cmd-item-path {
    display: block;
    font-size: 11px;
    color: hsl(var(--bc) / 0.3);
    font-family: ui-monospace, monospace;
    margin-top: 6px;
  }
</style>

<script>
  let pagefind: any = null;
  let selectedIdx = 0;
  let searchResults: any[] = [];

  function initCommandPalette() {
    const backdrop = document.getElementById('command-palette-backdrop');
    const modal = document.getElementById('command-palette');
    const input = document.getElementById('command-palette-input') as HTMLInputElement;
    const body = document.getElementById('command-palette-results');

    if (!backdrop || !modal || !input || !body) return;

    // Load Pagefind at runtime
    (async () => {
      try {
        const path = '/pagefind/pagefind.js';
        pagefind = await (new Function(`return import("${path}")`))();
        await pagefind.init();
      } catch (e) {
        console.warn('Pagefind unavailable');
      }
    })();

    function showEmpty() {
      body.innerHTML = `
        <div class="cmd-empty">
          <p class="cmd-empty-text">Type to search documentation</p>
          <div class="cmd-shortcuts">
            <span><kbd>⌘K</kbd> to open</span>
            <span><kbd>↑↓</kbd> navigate</span>
            <span><kbd>↵</kbd> select</span>
          </div>
        </div>
      `;
    }

    function openModal() {
      backdrop.classList.add('is-open');
      modal.classList.add('is-open');
      input.focus();
      document.body.style.overflow = 'hidden';
      showEmpty();
    }

    function closeModal() {
      backdrop.classList.remove('is-open');
      modal.classList.remove('is-open');
      input.value = '';
      selectedIdx = 0;
      searchResults = [];
      document.body.style.overflow = '';
    }

    function renderResults() {
      if (searchResults.length === 0) {
        body.innerHTML = `<div class="cmd-no-results">No results found</div>`;
        return;
      }

      body.innerHTML = searchResults.map((r, i) => {
        const title = r.meta?.title || 'Untitled';
        const excerpt = r.excerpt || '';
        const path = r.url.replace(/\.html$/, '').replace(/\/index$/, '');
        
        return `
          <a href="${path}?q=${encodeURIComponent(input.value)}" 
             class="cmd-item ${i === selectedIdx ? 'is-active' : ''}" 
             data-i="${i}">
            <span class="cmd-item-title">${title}</span>
            ${excerpt ? `<span class="cmd-item-excerpt">${excerpt}</span>` : ''}
            <span class="cmd-item-path">${path}</span>
          </a>
        `;
      }).join('');

      body.querySelectorAll('.cmd-item').forEach(el => {
        el.addEventListener('click', closeModal);
      });
    }

    // Search handler
    let t: any;
    input.addEventListener('input', () => {
      clearTimeout(t);
      const q = input.value.trim();
      
      if (!q || q.length < 2) {
        searchResults = [];
        showEmpty();
        return;
      }

      if (!pagefind) return;

      t = setTimeout(async () => {
        body.innerHTML = `<div class="cmd-loading">Searching...</div>`;
        
        try {
          const search = await pagefind.search(q);
          const all = await Promise.all(search.results.slice(0, 10).map((r: any) => r.data()));
          searchResults = all.filter((r: any) => r.url.includes('/docs/')).slice(0, 6);
          selectedIdx = 0;
          renderResults();
        } catch (e) {
          body.innerHTML = `<div class="cmd-no-results">Search error</div>`;
        }
      }, 100);
    });

    // Keyboard
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIdx = Math.min(selectedIdx + 1, searchResults.length - 1);
        renderResults();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIdx = Math.max(selectedIdx - 1, 0);
        renderResults();
      } else if (e.key === 'Enter' && searchResults[selectedIdx]) {
        e.preventDefault();
        const path = searchResults[selectedIdx].url.replace(/\.html$/, '').replace(/\/index$/, '');
        window.location.href = `${path}?q=${encodeURIComponent(input.value)}`;
        closeModal();
      } else if (e.key === 'Escape') {
        closeModal();
      }
    });

    backdrop.addEventListener('click', closeModal);

    // Global shortcuts
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openModal();
      }
      if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
        e.preventDefault();
        openModal();
      }
    });

    showEmpty();
  }

  // Highlight search terms with animation on page load
  function highlightSearchTerms() {
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    
    if (!q || q.length < 2) return;
    
    const terms = q.toLowerCase().split(/\s+/).filter(t => t.length >= 2);
    if (terms.length === 0) return;
    
    const content = document.querySelector('[data-pagefind-body]');
    if (!content) return;
    
    const walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    
    while (walker.nextNode()) {
      const node = walker.currentNode as Text;
      const txt = node.textContent?.toLowerCase() || '';
      if (terms.some(t => txt.includes(t))) {
        nodes.push(node);
      }
    }
    
    let firstMark: HTMLElement | null = null;
    
    nodes.forEach(node => {
      let html = node.textContent || '';
      let matched = false;
      
      terms.forEach(term => {
        const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp(`(${escaped})`, 'gi');
        if (re.test(html)) {
          matched = true;
          html = html.replace(re, '<mark class="search-match">$1</mark>');
        }
      });
      
      if (matched) {
        const span = document.createElement('span');
        span.innerHTML = html;
        node.parentNode?.replaceChild(span, node);
        if (!firstMark) firstMark = span.querySelector('mark');
      }
    });
    
    // Scroll and animate
    if (firstMark) {
      setTimeout(() => {
        const y = firstMark!.getBoundingClientRect().top + window.scrollY - 120;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }, 100);
      
      // Add pulse animation
      setTimeout(() => {
        document.querySelectorAll('.search-match').forEach(el => {
          el.classList.add('search-match-pulse');
        });
      }, 400);
      
      // Remove pulse after animation
      setTimeout(() => {
        document.querySelectorAll('.search-match-pulse').forEach(el => {
          el.classList.remove('search-match-pulse');
        });
      }, 2500);
    }
    
    // Clean URL
    window.history.replaceState({}, '', window.location.pathname);
  }

  initCommandPalette();
  highlightSearchTerms();
  
  document.addEventListener('astro:after-swap', () => {
    initCommandPalette();
    highlightSearchTerms();
  });
</script>

<style is:global>
  /* Search highlight on page */
  .search-match {
    background: hsl(var(--a) / 0.2);
    color: hsl(var(--a));
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 600;
  }
  
  .search-match-pulse {
    animation: matchPulse 2s ease-out;
  }
  
  @keyframes matchPulse {
    0% { 
      background: hsl(var(--a) / 0.6);
      box-shadow: 0 0 0 6px hsl(var(--a) / 0.25);
    }
    100% { 
      background: hsl(var(--a) / 0.2);
      box-shadow: 0 0 0 0 hsl(var(--a) / 0);
    }
  }
</style>
