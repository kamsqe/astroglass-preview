---
/**
 * Command Palette Component
 * 
 * Keyboard-activated search overlay (⌘K / Ctrl+K).
 * Integrates with Pagefind for instant search results.
 */
import { keyboardShortcuts } from '../../config/docs';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
---

<!-- Backdrop -->
<div id="command-palette-backdrop" class="command-palette-backdrop"></div>

<!-- Palette -->
<div id="command-palette" class="command-palette" role="dialog" aria-label="Search documentation">
  <div class="command-palette-header">
    <div class="command-palette-input-wrapper">
      <svg class="command-palette-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        type="text" 
        id="command-palette-input"
        class="command-palette-input" 
        placeholder="Search documentation..."
        autocomplete="off"
        aria-label="Search"
      />
      <kbd class="command-palette-shortcut">ESC</kbd>
    </div>
  </div>
  
  <div id="command-palette-results" class="command-palette-results">
    <div class="command-palette-empty">
      <p>Type to search the documentation</p>
      <div class="command-palette-hints">
        <div class="hint"><kbd>/</kbd> or <kbd>⌘K</kbd> to open</div>
        <div class="hint"><kbd>↑↓</kbd> to navigate</div>
        <div class="hint"><kbd>↵</kbd> to select</div>
      </div>
    </div>
  </div>
</div>

<style>
  .command-palette-header {
    padding: 4px;
    border-bottom: 1px solid rgba(var(--color-base-content-rgb, 0 0 0), 0.1);
  }

  .command-palette-input-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
  }

  .command-palette-icon {
    width: 20px;
    height: 20px;
    opacity: 0.4;
    flex-shrink: 0;
  }

  .command-palette-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 1rem;
    outline: none;
  }

  .command-palette-shortcut {
    font-size: 0.7rem;
    padding: 4px 8px;
    background: rgba(var(--color-base-content-rgb, 0 0 0), 0.08);
    border-radius: 4px;
    font-family: ui-monospace, monospace;
  }

  .command-palette-results {
    max-height: 400px;
    overflow-y: auto;
    padding: 8px;
  }

  .command-palette-empty {
    padding: 32px 16px;
    text-align: center;
    color: rgba(var(--color-base-content-rgb, 0 0 0), 0.5);
  }

  .command-palette-hints {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
    font-size: 0.75rem;
  }

  .hint kbd {
    font-size: 0.65rem;
    padding: 2px 6px;
    margin-right: 4px;
    background: rgba(var(--color-base-content-rgb, 0 0 0), 0.08);
    border-radius: 3px;
    font-family: ui-monospace, monospace;
  }

  .command-palette-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.1s;
  }

  .command-palette-item:hover,
  .command-palette-item.is-selected {
    background: rgba(var(--color-accent-rgb, 59 130 246), 0.1);
  }

  .command-palette-item-title {
    font-weight: 600;
  }

  .command-palette-item-excerpt {
    font-size: 0.85rem;
    opacity: 0.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .command-palette-item-path {
    font-size: 0.7rem;
    opacity: 0.5;
    font-family: ui-monospace, monospace;
  }

  .command-palette-loading {
    padding: 32px;
    text-align: center;
    color: rgba(var(--color-base-content-rgb, 0 0 0), 0.5);
  }

  .command-palette-no-results {
    padding: 32px 16px;
    text-align: center;
    color: rgba(var(--color-base-content-rgb, 0 0 0), 0.5);
  }
</style>

<script>
  let pagefind: any = null;
  let selectedIndex = 0;
  let results: any[] = [];

  async function initCommandPalette() {
    const backdrop = document.getElementById('command-palette-backdrop');
    const palette = document.getElementById('command-palette');
    const input = document.getElementById('command-palette-input') as HTMLInputElement;
    const resultsContainer = document.getElementById('command-palette-results');

    if (!backdrop || !palette || !input || !resultsContainer) return;

    // Load Pagefind dynamically at runtime (not at build time)
    try {
      const pagefindUrl = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ pagefindUrl);
      await pagefind.init();
    } catch (e) {
      console.warn('Pagefind not available, search disabled');
    }

    function openPalette() {
      backdrop.classList.add('is-open');
      palette.classList.add('is-open');
      input.focus();
      document.body.style.overflow = 'hidden';
    }

    function closePalette() {
      backdrop.classList.remove('is-open');
      palette.classList.remove('is-open');
      input.value = '';
      selectedIndex = 0;
      results = [];
      document.body.style.overflow = '';
      renderResults([]);
    }

    function renderResults(items: any[]) {
      if (items.length === 0) {
        resultsContainer.innerHTML = `
          <div class="command-palette-empty">
            <p>Type to search the documentation</p>
            <div class="command-palette-hints">
              <div class="hint"><kbd>/</kbd> or <kbd>⌘K</kbd> to open</div>
              <div class="hint"><kbd>↑↓</kbd> to navigate</div>
              <div class="hint"><kbd>↵</kbd> to select</div>
            </div>
          </div>
        `;
        return;
      }

      resultsContainer.innerHTML = items.map((item, i) => `
        <a 
          href="${item.url}" 
          class="command-palette-item ${i === selectedIndex ? 'is-selected' : ''}"
          data-index="${i}"
        >
          <span class="command-palette-item-title">${item.meta?.title || 'Untitled'}</span>
          ${item.excerpt ? `<span class="command-palette-item-excerpt">${item.excerpt}</span>` : ''}
          <span class="command-palette-item-path">${item.url}</span>
        </a>
      `).join('');

      // Click handlers
      resultsContainer.querySelectorAll('.command-palette-item').forEach((el) => {
        el.addEventListener('click', () => closePalette());
      });
    }

    // Search handler
    let searchTimeout: ReturnType<typeof setTimeout>;
    input.addEventListener('input', async () => {
      clearTimeout(searchTimeout);
      const query = input.value.trim();

      if (!query) {
        results = [];
        renderResults([]);
        return;
      }

      if (!pagefind) return;

      searchTimeout = setTimeout(async () => {
        resultsContainer.innerHTML = '<div class="command-palette-loading">Searching...</div>';
        
        try {
          const search = await pagefind.search(query);
          results = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
          selectedIndex = 0;
          
          if (results.length === 0) {
            resultsContainer.innerHTML = '<div class="command-palette-no-results">No results found</div>';
          } else {
            renderResults(results);
          }
        } catch (e) {
          resultsContainer.innerHTML = '<div class="command-palette-no-results">Search error</div>';
        }
      }, 150);
    });

    // Keyboard navigation
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, results.length - 1);
        renderResults(results);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        renderResults(results);
      } else if (e.key === 'Enter' && results[selectedIndex]) {
        e.preventDefault();
        window.location.href = results[selectedIndex].url;
        closePalette();
      } else if (e.key === 'Escape') {
        closePalette();
      }
    });

    // Close on backdrop click
    backdrop.addEventListener('click', closePalette);

    // Global keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      // ⌘K or Ctrl+K
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openPalette();
      }
      // / key when not in input
      if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        openPalette();
      }
    });
  }

  initCommandPalette();
  document.addEventListener('astro:after-swap', initCommandPalette);
</script>
