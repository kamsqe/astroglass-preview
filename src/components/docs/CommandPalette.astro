---
/**
 * Command Palette Component
 * 
 * Premium keyboard-activated search overlay (⌘K / Ctrl+K).
 * Integrates with Pagefind for instant search results.
 */
import { useTranslations } from '../../utils/i18n';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'ru');
---

<!-- Backdrop -->
<div id="command-palette-backdrop" class="command-palette-backdrop"></div>

<!-- Palette -->
<div id="command-palette" class="command-palette" role="dialog" aria-label="Search documentation">
  <div class="command-palette-header">
    <div class="command-palette-input-wrapper">
      <svg class="command-palette-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        type="text" 
        id="command-palette-input"
        class="command-palette-input" 
        placeholder={t('docs.searchPlaceholder') || 'Search documentation...'}
        autocomplete="off"
        aria-label="Search"
      />
      <kbd class="command-palette-shortcut">ESC</kbd>
    </div>
  </div>
  
  <div id="command-palette-results" class="command-palette-results">
    <div class="command-palette-empty">
      <div class="command-palette-empty-icon">🔍</div>
      <p>{t('docs.typeToSearch') || 'Type to search'}</p>
      <div class="command-palette-hints">
        <div class="hint"><kbd>⌘K</kbd> open</div>
        <div class="hint"><kbd>↑↓</kbd> navigate</div>
        <div class="hint"><kbd>↵</kbd> go</div>
      </div>
    </div>
  </div>
</div>

<style>
  .command-palette-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .command-palette-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .command-palette {
    position: fixed;
    top: 15%;
    left: 50%;
    transform: translateX(-50%) translateY(-20px) scale(0.95);
    width: calc(100% - 32px);
    max-width: 640px;
    background: linear-gradient(
      145deg,
      rgba(var(--color-base-100-rgb, 255 255 255), 0.98),
      rgba(var(--color-base-100-rgb, 255 255 255), 0.92)
    );
    border: 1px solid rgba(var(--color-base-content-rgb, 0 0 0), 0.1);
    border-radius: 20px;
    box-shadow: 
      0 25px 50px -12px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(var(--color-accent-rgb, 59 130 246), 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
    z-index: 9999;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .command-palette.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .command-palette-header {
    border-bottom: 1px solid rgba(var(--color-base-content-rgb, 0 0 0), 0.08);
    background: rgba(var(--color-base-content-rgb, 0 0 0), 0.02);
  }

  .command-palette-input-wrapper {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
  }

  .command-palette-icon {
    width: 22px;
    height: 22px;
    opacity: 0.35;
    flex-shrink: 0;
    color: hsl(var(--a));
  }

  .command-palette-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 1.125rem;
    font-weight: 500;
    outline: none;
    color: inherit;
  }

  .command-palette-input::placeholder {
    color: rgba(var(--color-base-content-rgb, 0 0 0), 0.35);
  }

  .command-palette-shortcut {
    font-size: 0.7rem;
    padding: 5px 10px;
    background: rgba(var(--color-base-content-rgb, 0 0 0), 0.06);
    border: 1px solid rgba(var(--color-base-content-rgb, 0 0 0), 0.08);
    border-radius: 6px;
    font-family: ui-monospace, monospace;
    font-weight: 600;
  }

  .command-palette-results {
    max-height: 420px;
    overflow-y: auto;
    padding: 12px;
  }

  .command-palette-empty {
    padding: 48px 24px;
    text-align: center;
    color: rgba(var(--color-base-content-rgb, 0 0 0), 0.45);
  }

  .command-palette-empty-icon {
    font-size: 2.5rem;
    margin-bottom: 12px;
    opacity: 0.5;
  }

  .command-palette-empty p {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 20px;
  }

  .command-palette-hints {
    display: flex;
    justify-content: center;
    gap: 20px;
    font-size: 0.8rem;
  }

  .hint {
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.6;
  }

  .hint kbd {
    font-size: 0.7rem;
    padding: 3px 7px;
    background: rgba(var(--color-base-content-rgb, 0 0 0), 0.06);
    border: 1px solid rgba(var(--color-base-content-rgb, 0 0 0), 0.08);
    border-radius: 5px;
    font-family: ui-monospace, monospace;
    font-weight: 600;
  }

  .command-palette-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    margin-bottom: 4px;
  }

  .command-palette-item:hover,
  .command-palette-item.is-selected {
    background: rgba(var(--color-accent-rgb, 59 130 246), 0.08);
    border-color: rgba(var(--color-accent-rgb, 59 130 246), 0.15);
    transform: translateX(4px);
  }

  .command-palette-item.is-selected {
    background: rgba(var(--color-accent-rgb, 59 130 246), 0.12);
  }

  .command-palette-item-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: hsl(var(--bc));
  }

  .command-palette-item.is-selected .command-palette-item-title,
  .command-palette-item:hover .command-palette-item-title {
    color: hsl(var(--a));
  }

  .command-palette-item-excerpt {
    font-size: 0.85rem;
    opacity: 0.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
  }

  .command-palette-item-path {
    font-size: 0.7rem;
    opacity: 0.4;
    font-family: ui-monospace, monospace;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .command-palette-item-path::before {
    content: '→';
    opacity: 0.5;
  }

  .command-palette-loading {
    padding: 48px;
    text-align: center;
    color: rgba(var(--color-base-content-rgb, 0 0 0), 0.45);
    font-weight: 500;
  }

  .command-palette-loading::before {
    content: '⏳';
    display: block;
    font-size: 2rem;
    margin-bottom: 12px;
    animation: pulse 1s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .command-palette-no-results {
    padding: 48px 24px;
    text-align: center;
    color: rgba(var(--color-base-content-rgb, 0 0 0), 0.45);
  }

  .command-palette-no-results::before {
    content: '😕';
    display: block;
    font-size: 2.5rem;
    margin-bottom: 12px;
  }

  /* Dark mode adjustments */
  [data-theme="midnight"] .command-palette,
  [data-theme="pacific"] .command-palette,
  [data-theme="nordic"] .command-palette {
    background: linear-gradient(
      145deg,
      rgba(20, 25, 35, 0.98),
      rgba(15, 20, 30, 0.95)
    );
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 
      0 25px 50px -12px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
</style>

<script>
  let pagefind: any = null;
  let selectedIndex = 0;
  let results: any[] = [];

  async function initCommandPalette() {
    const backdrop = document.getElementById('command-palette-backdrop');
    const palette = document.getElementById('command-palette');
    const input = document.getElementById('command-palette-input') as HTMLInputElement;
    const resultsContainer = document.getElementById('command-palette-results');

    if (!backdrop || !palette || !input || !resultsContainer) return;

    // Load Pagefind dynamically at runtime (not at build time)
    try {
      const pagefindUrl = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ pagefindUrl);
      await pagefind.init();
    } catch (e) {
      console.warn('Pagefind not available, search disabled');
    }

    function openPalette() {
      backdrop.classList.add('is-open');
      palette.classList.add('is-open');
      input.focus();
      document.body.style.overflow = 'hidden';
    }

    function closePalette() {
      backdrop.classList.remove('is-open');
      palette.classList.remove('is-open');
      input.value = '';
      selectedIndex = 0;
      results = [];
      document.body.style.overflow = '';
      renderResults([]);
    }

    function renderResults(items: any[]) {
      if (items.length === 0) {
        resultsContainer.innerHTML = `
          <div class="command-palette-empty">
            <div class="command-palette-empty-icon">🔍</div>
            <p>Type to search</p>
            <div class="command-palette-hints">
              <div class="hint"><kbd>⌘K</kbd> open</div>
              <div class="hint"><kbd>↑↓</kbd> navigate</div>
              <div class="hint"><kbd>↵</kbd> go</div>
            </div>
          </div>
        `;
        return;
      }

      resultsContainer.innerHTML = items.map((item, i) => `
        <a 
          href="${item.url}" 
          class="command-palette-item ${i === selectedIndex ? 'is-selected' : ''}"
          data-index="${i}"
        >
          <span class="command-palette-item-title">${item.meta?.title || 'Untitled'}</span>
          ${item.excerpt ? `<span class="command-palette-item-excerpt">${item.excerpt}</span>` : ''}
          <span class="command-palette-item-path">${item.url}</span>
        </a>
      `).join('');

      // Click handlers
      resultsContainer.querySelectorAll('.command-palette-item').forEach((el) => {
        el.addEventListener('click', () => closePalette());
      });
    }

    // Search handler
    let searchTimeout: ReturnType<typeof setTimeout>;
    input.addEventListener('input', async () => {
      clearTimeout(searchTimeout);
      const query = input.value.trim();

      if (!query) {
        results = [];
        renderResults([]);
        return;
      }

      if (!pagefind) return;

      searchTimeout = setTimeout(async () => {
        resultsContainer.innerHTML = '<div class="command-palette-loading">Searching...</div>';
        
        try {
          const search = await pagefind.search(query);
          results = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
          selectedIndex = 0;
          
          if (results.length === 0) {
            resultsContainer.innerHTML = '<div class="command-palette-no-results">No results found</div>';
          } else {
            renderResults(results);
          }
        } catch (e) {
          resultsContainer.innerHTML = '<div class="command-palette-no-results">Search error</div>';
        }
      }, 150);
    });

    // Keyboard navigation
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, results.length - 1);
        renderResults(results);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        renderResults(results);
      } else if (e.key === 'Enter' && results[selectedIndex]) {
        e.preventDefault();
        window.location.href = results[selectedIndex].url;
        closePalette();
      } else if (e.key === 'Escape') {
        closePalette();
      }
    });

    // Close on backdrop click
    backdrop.addEventListener('click', closePalette);

    // Global keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      // ⌘K or Ctrl+K
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openPalette();
      }
      // / key when not in input
      if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        openPalette();
      }
    });
  }

  initCommandPalette();
  document.addEventListener('astro:after-swap', initCommandPalette);
</script>
