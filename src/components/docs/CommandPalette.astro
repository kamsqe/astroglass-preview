---
/**
 * Command Palette - Premium Documentation Search
 * Fixed: Locale filtering, cache invalidation, improved visuals
 */
import { useTranslations } from '../../utils/i18n';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'ru');

// Generate proper base path for links
const docsBase = locale === 'en' ? '/docs' : `/${locale}/docs`;
---

<!-- Backdrop with blur -->
<div id="search-overlay" class="search-overlay"></div>

<!-- Search Dialog -->
<div id="search-dialog" class="search-dialog" role="dialog" aria-label="Search documentation" data-locale={locale}>
  <!-- Input Section -->
  <div class="search-header">
    <div class="search-input-wrapper">
      <svg class="search-icon" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
      </svg>
      <div class="search-spinner"></div>
      <input
        id="search-input"
        type="text"
        placeholder={t('docs.searchPlaceholder') || 'Search documentation...'}
        autocomplete="off"
        spellcheck="false"
      />
      <button id="search-clear" class="search-clear" type="button" aria-label="Clear search">
        <svg viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
      </button>
      <kbd class="search-kbd">ESC</kbd>
    </div>
  </div>

  <!-- Results Container -->
  <div id="search-results" class="search-results">
    <!-- Initial State -->
    <div class="search-initial" id="search-initial">
      <!-- Recent Searches -->
      <div class="search-section" id="recent-section">
        <div class="search-section-header">
          <span class="search-section-title">{t('docs.recentSearches') || 'Recent'}</span>
          <button class="search-clear-btn" id="clear-recent">{t('docs.clear') || 'Clear'}</button>
        </div>
        <div class="search-recent-list" id="recent-list"></div>
      </div>
      
      <!-- Quick Links -->
      <div class="search-section">
        <div class="search-section-header">
          <span class="search-section-title">{t('docs.quickLinks') || 'Quick Links'}</span>
        </div>
        <div class="search-quick-links">
          <a href={`${docsBase}/getting-started`} class="search-quick-link" data-quick-link>
            <svg class="quick-link-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span>{t('docs.gettingStarted') || 'Getting Started'}</span>
          </a>
          <a href={docsBase} class="search-quick-link" data-quick-link>
            <svg class="quick-link-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1"/>
              <rect x="14" y="3" width="7" height="7" rx="1"/>
              <rect x="3" y="14" width="7" height="7" rx="1"/>
              <rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            <span>{t('docs.components') || 'Components'}</span>
          </a>
          <a href={`${docsBase}/themes`} class="search-quick-link" data-quick-link>
            <svg class="quick-link-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
            <span>{t('docs.themes') || 'Themes'}</span>
          </a>
        </div>
      </div>

      <!-- Keyboard hints -->
      <div class="search-hints">
        <span><kbd>↑↓</kbd> {t('docs.navigate') || 'Navigate'}</span>
        <span><kbd>↵</kbd> {t('docs.open') || 'Open'}</span>
        <span><kbd>esc</kbd> {t('docs.close') || 'Close'}</span>
      </div>
    </div>

    <!-- Loading Skeleton -->
    <div class="search-loading" id="search-loading">
      <div class="skeleton-item"><div class="skeleton-icon"></div><div class="skeleton-content"><div class="skeleton-title"></div><div class="skeleton-meta"></div></div></div>
      <div class="skeleton-item"><div class="skeleton-icon"></div><div class="skeleton-content"><div class="skeleton-title"></div><div class="skeleton-meta"></div></div></div>
      <div class="skeleton-item"><div class="skeleton-icon"></div><div class="skeleton-content"><div class="skeleton-title"></div><div class="skeleton-meta"></div></div></div>
    </div>

    <!-- Search Results List -->
    <div class="search-list" id="search-list"></div>

    <!-- Empty State -->
    <div class="search-empty" id="search-empty">
      <svg class="empty-icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="26" cy="26" r="16" opacity="0.3"/>
        <path d="M38 38l14 14" stroke-width="4" stroke-linecap="round" opacity="0.3"/>
        <path d="M26 20v12M20 26h12" stroke-linecap="round"/>
      </svg>
      <p class="empty-title">{t('docs.noResults') || 'No results found'}</p>
      <p class="empty-hint">{t('docs.tryDifferent') || 'Try different keywords or check spelling'}</p>
    </div>
  </div>

  <!-- Footer -->
  <div class="search-footer">
    <span class="result-count" id="result-count"></span>
  </div>
</div>

<style>
  /* ========== OVERLAY ========== */
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .search-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* ========== DIALOG ========== */
  .search-dialog {
    position: fixed;
    top: 12%;
    left: 50%;
    transform: translateX(-50%) translateY(-10px) scale(0.98);
    width: min(560px, calc(100vw - 32px));
    max-height: 70vh;
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--bc) / 0.1);
    border-radius: 16px;
    box-shadow: 
      0 20px 50px -10px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 hsl(var(--bc) / 0.05);
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: 
      opacity 0.15s ease,
      visibility 0.15s ease,
      transform 0.25s cubic-bezier(0.32, 0.72, 0, 1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .search-dialog.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  /* ========== INPUT ========== */
  .search-header {
    padding: 16px 18px;
    border-bottom: 1px solid hsl(var(--bc) / 0.08);
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
  }

  .search-icon {
    width: 18px;
    height: 18px;
    color: hsl(var(--bc) / 0.4);
    flex-shrink: 0;
    transition: opacity 0.15s;
  }

  .search-dialog.is-searching .search-icon {
    opacity: 0;
  }

  .search-spinner {
    position: absolute;
    left: 0;
    width: 18px;
    height: 18px;
    border: 2px solid hsl(var(--a) / 0.2);
    border-top-color: hsl(var(--a));
    border-radius: 50%;
    opacity: 0;
    animation: spin 0.6s linear infinite;
  }

  .search-dialog.is-searching .search-spinner {
    opacity: 1;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  #search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 16px;
    font-weight: 500;
    color: hsl(var(--bc));
    caret-color: hsl(var(--a));
    min-width: 0;
  }

  #search-input::placeholder {
    color: hsl(var(--bc) / 0.35);
    font-weight: 400;
  }

  .search-clear {
    width: 20px;
    height: 20px;
    padding: 0;
    background: none;
    border: none;
    color: hsl(var(--bc) / 0.3);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s;
  }

  .search-clear.visible {
    opacity: 1;
  }

  .search-clear:hover {
    color: hsl(var(--bc) / 0.6);
  }

  .search-clear svg {
    width: 100%;
    height: 100%;
  }

  .search-kbd {
    font-size: 10px;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 600;
    padding: 4px 8px;
    background: hsl(var(--bc) / 0.05);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 5px;
    color: hsl(var(--bc) / 0.4);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  /* ========== RESULTS AREA ========== */
  .search-results {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    min-height: 180px;
    max-height: 380px;
  }

  /* Initial state */
  .search-initial {
    padding: 14px 18px;
  }

  .search-initial.hidden {
    display: none;
  }

  .search-section {
    margin-bottom: 18px;
  }

  .search-section:last-of-type {
    margin-bottom: 0;
  }

  .search-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .search-section-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: hsl(var(--bc) / 0.4);
  }

  .search-clear-btn {
    font-size: 11px;
    font-weight: 500;
    color: hsl(var(--bc) / 0.35);
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 4px;
    transition: all 0.15s ease;
  }

  .search-clear-btn:hover {
    color: hsl(var(--a));
    background: hsl(var(--a) / 0.1);
  }

  /* Recent searches */
  .search-recent-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .recent-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    cursor: pointer;
    color: hsl(var(--bc) / 0.7);
    font-size: 13px;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    transition: background 0.1s;
  }

  .recent-item:hover {
    background: hsl(var(--bc) / 0.05);
    color: hsl(var(--bc));
  }

  .recent-icon {
    width: 14px;
    height: 14px;
    opacity: 0.4;
  }

  /* Quick links */
  .search-quick-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .search-quick-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 14px 10px;
    background: hsl(var(--bc) / 0.03);
    border: 1px solid hsl(var(--bc) / 0.06);
    border-radius: 10px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 500;
    color: hsl(var(--bc) / 0.6);
    transition: all 0.15s ease;
  }

  .search-quick-link:hover {
    background: hsl(var(--a) / 0.08);
    border-color: hsl(var(--a) / 0.15);
    color: hsl(var(--a));
  }

  .quick-link-svg {
    width: 22px;
    height: 22px;
    opacity: 0.7;
  }

  .search-quick-link:hover .quick-link-svg {
    opacity: 1;
  }

  /* Keyboard hints */
  .search-hints {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 14px 0 6px;
    font-size: 11px;
    color: hsl(var(--bc) / 0.35);
  }

  .search-hints span {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .search-hints kbd {
    font-size: 9px;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 600;
    padding: 2px 5px;
    background: hsl(var(--bc) / 0.05);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 4px;
    color: hsl(var(--bc) / 0.4);
  }

  /* ========== LOADING ========== */
  .search-loading {
    display: none;
    padding: 10px 14px;
  }

  .search-loading.visible {
    display: block;
  }

  .skeleton-item {
    display: flex;
    gap: 12px;
    padding: 12px;
    margin-bottom: 4px;
  }

  .skeleton-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: linear-gradient(90deg, hsl(var(--bc) / 0.06) 25%, hsl(var(--bc) / 0.1) 50%, hsl(var(--bc) / 0.06) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.2s infinite;
  }

  .skeleton-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    justify-content: center;
  }

  .skeleton-title {
    height: 12px;
    width: 55%;
    border-radius: 4px;
    background: linear-gradient(90deg, hsl(var(--bc) / 0.06) 25%, hsl(var(--bc) / 0.1) 50%, hsl(var(--bc) / 0.06) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.2s infinite;
  }

  .skeleton-meta {
    height: 10px;
    width: 35%;
    border-radius: 4px;
    background: linear-gradient(90deg, hsl(var(--bc) / 0.04) 25%, hsl(var(--bc) / 0.08) 50%, hsl(var(--bc) / 0.04) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.2s infinite;
  }

  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* ========== RESULTS LIST ========== */
  .search-list {
    display: none;
    padding: 8px 10px;
  }

  .search-list.visible {
    display: block;
  }

  .search-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.1s ease;
    margin-bottom: 2px;
    border-left: 3px solid transparent;
  }

  .search-item:hover,
  .search-item.selected {
    background: hsl(var(--a) / 0.08);
    border-left-color: hsl(var(--a));
  }

  .search-item-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: hsl(var(--bc) / 0.05);
    border-radius: 8px;
    flex-shrink: 0;
    color: hsl(var(--bc) / 0.5);
    transition: all 0.1s ease;
  }

  .search-item-icon svg {
    width: 18px;
    height: 18px;
  }

  .search-item:hover .search-item-icon,
  .search-item.selected .search-item-icon {
    background: hsl(var(--a) / 0.12);
    color: hsl(var(--a));
  }

  .search-item-content {
    flex: 1;
    min-width: 0;
  }

  .search-item-title {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: hsl(var(--bc));
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-item:hover .search-item-title,
  .search-item.selected .search-item-title {
    color: hsl(var(--a));
  }

  .search-item-meta {
    font-size: 11px;
    color: hsl(var(--bc) / 0.45);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-item-arrow {
    width: 16px;
    height: 16px;
    color: hsl(var(--bc) / 0.2);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.1s ease;
  }

  .search-item:hover .search-item-arrow,
  .search-item.selected .search-item-arrow {
    opacity: 1;
    transform: translateX(0);
    color: hsl(var(--a));
  }

  /* ========== EMPTY STATE ========== */
  .search-empty {
    display: none;
    text-align: center;
    padding: 40px 24px;
  }

  .search-empty.visible {
    display: block;
  }

  .empty-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 14px;
    color: hsl(var(--bc) / 0.2);
  }

  .empty-title {
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--bc) / 0.6);
    margin-bottom: 4px;
  }

  .empty-hint {
    font-size: 12px;
    color: hsl(var(--bc) / 0.4);
  }

  /* ========== FOOTER ========== */
  .search-footer {
    padding: 10px 18px;
    border-top: 1px solid hsl(var(--bc) / 0.06);
    font-size: 11px;
    color: hsl(var(--bc) / 0.4);
    min-height: 36px;
  }

  .result-count {
    font-weight: 500;
  }

  /* ========== HIDDEN STATES ========== */
  #recent-section.hidden {
    display: none;
  }
</style>

<script is:inline>
(function() {
  var pagefind = null;
  var results = [];
  var selected = 0;
  var debounceTimer = null;
  var resultsCache = {};

  var STORAGE_KEY = 'docs-recent-searches';
  var MAX_RECENT = 5;

  // Detect current locale from URL
  function getCurrentLocale() {
    var path = window.location.pathname;
    if (path.startsWith('/ru/') || path === '/ru') return 'ru';
    return 'en';
  }

  function getDocsBase() {
    var locale = getCurrentLocale();
    return locale === 'en' ? '/docs' : '/' + locale + '/docs';
  }

  function getRecentSearches() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch (e) {
      return [];
    }
  }

  function saveRecentSearch(query) {
    if (!query || query.length < 2) return;
    var recent = getRecentSearches().filter(function(q) { return q !== query; });
    recent.unshift(query);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(recent.slice(0, MAX_RECENT)));
  }

  function clearRecentSearches() {
    localStorage.removeItem(STORAGE_KEY);
  }

  function getResultIcon(url) {
    if (url.includes('/components') || url.includes('/02-components')) {
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>';
    }
    if (url.includes('/themes') || url.includes('/03-themes')) {
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>';
    }
    if (url.includes('/getting-started') || url.includes('/installation') || url.includes('/01-getting-started')) {
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>';
    }
    if (url.includes('/deployment') || url.includes('/04-deployment')) {
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 004 14.5V5a2 2 0 012-2h14a2 2 0 012 2v9.5a2.5 2.5 0 00-2.5 2.5M4 19.5v.5a2.5 2.5 0 005 0V17h11"/></svg>';
    }
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>';
  }

  function getBreadcrumb(url) {
    var parts = url.replace(/\.html$/, '').split('/').filter(Boolean);
    var docsIdx = parts.indexOf('docs');
    if (docsIdx === -1) return '';
    var relevantParts = parts.slice(docsIdx + 1);
    return relevantParts.map(function(p) {
      return p.charAt(0).toUpperCase() + p.slice(1).replace(/-/g, ' ').replace(/^\d+-/, '');
    }).join(' / ');
  }

  function init() {
    var overlay = document.getElementById('search-overlay');
    var dialog = document.getElementById('search-dialog');
    var input = document.getElementById('search-input');
    var clearBtn = document.getElementById('search-clear');
    var searchList = document.getElementById('search-list');
    var searchLoading = document.getElementById('search-loading');
    var searchEmpty = document.getElementById('search-empty');
    var searchInitial = document.getElementById('search-initial');
    var recentSection = document.getElementById('recent-section');
    var recentList = document.getElementById('recent-list');
    var clearRecentBtn = document.getElementById('clear-recent');
    var resultCount = document.getElementById('result-count');

    if (!overlay || !dialog || !input) return;

    // Clear cache on init (handles page navigation)
    resultsCache = {};

    // Preload Pagefind immediately
    loadPagefind();

    function loadPagefind() {
      if (pagefind) return Promise.resolve();
      return new Promise(function(resolve) {
        (new Function('return import("/pagefind/pagefind.js")'))()
          .then(function(pf) {
            pagefind = pf;
            return pagefind.init();
          })
          .then(resolve)
          .catch(function(e) {
            console.warn('Pagefind not available:', e);
            resolve();
          });
      });
    }

    function renderRecentSearches() {
      var recent = getRecentSearches();
      if (!recentList || !recentSection) return;
      
      if (recent.length === 0) {
        recentSection.classList.add('hidden');
        return;
      }

      recentSection.classList.remove('hidden');
      recentList.innerHTML = recent.map(function(q) {
        return '<button class="recent-item" data-query="' + q + '">' +
          '<svg class="recent-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">' +
          '<path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>' +
          '</svg>' + q + '</button>';
      }).join('');

      recentList.querySelectorAll('.recent-item').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var query = btn.getAttribute('data-query') || '';
          input.value = query;
          updateClearButton();
          performSearch(query);
        });
      });
    }

    function updateClearButton() {
      if (clearBtn) {
        if (input.value.length > 0) {
          clearBtn.classList.add('visible');
        } else {
          clearBtn.classList.remove('visible');
        }
      }
    }

    function showInitial() {
      if (searchInitial) searchInitial.classList.remove('hidden');
      if (searchList) searchList.classList.remove('visible');
      if (searchLoading) searchLoading.classList.remove('visible');
      if (searchEmpty) searchEmpty.classList.remove('visible');
      if (resultCount) resultCount.textContent = '';
      renderRecentSearches();
    }

    function showLoading() {
      dialog.classList.add('is-searching');
      if (searchInitial) searchInitial.classList.add('hidden');
      if (searchList) searchList.classList.remove('visible');
      if (searchLoading) searchLoading.classList.add('visible');
      if (searchEmpty) searchEmpty.classList.remove('visible');
    }

    function showEmpty() {
      dialog.classList.remove('is-searching');
      if (searchInitial) searchInitial.classList.add('hidden');
      if (searchList) searchList.classList.remove('visible');
      if (searchLoading) searchLoading.classList.remove('visible');
      if (searchEmpty) searchEmpty.classList.add('visible');
      if (resultCount) resultCount.textContent = '0 results';
    }

    function showResults() {
      dialog.classList.remove('is-searching');
      if (searchInitial) searchInitial.classList.add('hidden');
      if (searchList) searchList.classList.add('visible');
      if (searchLoading) searchLoading.classList.remove('visible');
      if (searchEmpty) searchEmpty.classList.remove('visible');
    }

    function renderResults() {
      if (!searchList) return;
      
      var query = encodeURIComponent(input.value.trim());
      var docsBase = getDocsBase();
      
      searchList.innerHTML = results.map(function(r, i) {
        var title = (r.meta && r.meta.title) || 'Untitled';
        var icon = getResultIcon(r.url);
        var breadcrumb = getBreadcrumb(r.url);
        var url = r.url.replace(/\.html$/, '').replace(/\/index$/, '');
        
        return '<a href="' + url + '?q=' + query + '" class="search-item ' + (i === selected ? 'selected' : '') + '" data-idx="' + i + '">' +
          '<div class="search-item-icon">' + icon + '</div>' +
          '<div class="search-item-content">' +
          '<span class="search-item-title">' + title + '</span>' +
          '<span class="search-item-meta">' + breadcrumb + '</span>' +
          '</div>' +
          '<svg class="search-item-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">' +
          '<path d="M9 5l7 7-7 7"/>' +
          '</svg></a>';
      }).join('');

      if (resultCount) {
        resultCount.textContent = results.length + ' result' + (results.length !== 1 ? 's' : '');
      }

      searchList.querySelectorAll('.search-item').forEach(function(el) {
        el.addEventListener('click', function() {
          saveRecentSearch(input.value.trim());
          close();
        });
      });

      showResults();
    }

    function performSearch(query) {
      if (!query || query.length < 2) {
        showInitial();
        return;
      }

      var currentLocale = getCurrentLocale();
      var cacheKey = query + '-' + currentLocale;
      
      if (resultsCache[cacheKey]) {
        results = resultsCache[cacheKey];
        selected = 0;
        if (results.length === 0) {
          showEmpty();
        } else {
          renderResults();
        }
        return;
      }

      if (!pagefind) {
        loadPagefind().then(function() {
          if (pagefind) doSearch();
        });
        return;
      }

      doSearch();

      function doSearch() {
        showLoading();

        pagefind.search(query)
          .then(function(res) {
            return Promise.all(res.results.slice(0, 12).map(function(r) { return r.data(); }));
          })
          .then(function(data) {
            // Filter by locale
            results = data.filter(function(r) {
              if (currentLocale === 'en') {
                // English: include /docs/ but exclude /ru/docs/
                return r.url.includes('/docs/') && !r.url.includes('/ru/');
              } else {
                // Other locales: include /{locale}/docs/
                return r.url.includes('/' + currentLocale + '/docs/');
              }
            }).slice(0, 8);
            
            resultsCache[cacheKey] = results;
            selected = 0;

            if (results.length === 0) {
              showEmpty();
            } else {
              renderResults();
            }
          })
          .catch(function(e) {
            console.error('Search error:', e);
            showEmpty();
          });
      }
    }

    function open() {
      overlay.classList.add('is-open');
      dialog.classList.add('is-open');
      input.value = '';
      updateClearButton();
      input.focus();
      showInitial();
      document.body.style.overflow = 'hidden';
    }

    function close() {
      overlay.classList.remove('is-open');
      dialog.classList.remove('is-open');
      dialog.classList.remove('is-searching');
      results = [];
      selected = 0;
      document.body.style.overflow = '';
    }

    // Input handler
    input.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      updateClearButton();
      var q = input.value.trim();
      
      if (!q || q.length < 2) {
        showInitial();
        return;
      }

      debounceTimer = setTimeout(function() { performSearch(q); }, 120);
    });

    // Clear button
    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        input.value = '';
        updateClearButton();
        showInitial();
        input.focus();
      });
    }

    // Keyboard navigation
    input.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selected = Math.min(selected + 1, results.length - 1);
        renderResults();
        scrollSelectedIntoView();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selected = Math.max(selected - 1, 0);
        renderResults();
        scrollSelectedIntoView();
      } else if (e.key === 'Enter' && results[selected]) {
        e.preventDefault();
        saveRecentSearch(input.value.trim());
        var url = results[selected].url.replace(/\.html$/, '').replace(/\/index$/, '');
        window.location.href = url + '?q=' + encodeURIComponent(input.value.trim());
        close();
      } else if (e.key === 'Escape') {
        close();
      }
    });

    function scrollSelectedIntoView() {
      var selectedEl = searchList && searchList.querySelector('.search-item.selected');
      if (selectedEl) selectedEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    // Clear recent
    if (clearRecentBtn) {
      clearRecentBtn.addEventListener('click', function() {
        clearRecentSearches();
        renderRecentSearches();
      });
    }

    // Quick links
    document.querySelectorAll('[data-quick-link]').forEach(function(link) {
      link.addEventListener('click', function() { close(); });
    });

    // Close handlers
    overlay.addEventListener('click', close);

    // Global shortcuts
    document.addEventListener('keydown', function(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        open();
      }
      if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes((document.activeElement && document.activeElement.tagName) || '')) {
        e.preventDefault();
        open();
      }
    });

    showInitial();
  }

  // Highlight on page load
  function highlightOnLoad() {
    var params = new URLSearchParams(window.location.search);
    var query = params.get('q') || params.get('highlight');
    if (!query || query.length < 2) return;

    var article = document.querySelector('article') || document.querySelector('.prose');
    if (!article) return;

    var searchTerm = query.toLowerCase();
    var walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT);
    var matchNode = null;

    while (walker.nextNode()) {
      var text = (walker.currentNode.textContent || '').toLowerCase();
      if (text.includes(searchTerm)) {
        matchNode = walker.currentNode;
        break;
      }
    }

    if (matchNode && matchNode.parentElement) {
      var el = matchNode.parentElement;
      
      // Scroll to the matched element
      setTimeout(function() {
        var rect = el.getBoundingClientRect();
        var scrollY = window.scrollY + rect.top - 140;
        window.scrollTo({ top: scrollY, behavior: 'smooth' });
      }, 100);

      // Subtle highlight animation on the element
      setTimeout(function() {
        el.classList.add('search-match-highlight');
      }, 400);

      setTimeout(function() {
        el.classList.remove('search-match-highlight');
      }, 2500);

      // Clean URL
      history.replaceState(null, '', window.location.pathname);
    }
  }

  init();
  highlightOnLoad();

  document.addEventListener('astro:after-swap', function() {
    resultsCache = {}; // Clear cache on navigation
    init();
    highlightOnLoad();
  });
})();
</script>

<style is:global>
  .search-match-highlight {
    background: linear-gradient(90deg, transparent, hsl(var(--a) / 0.15), transparent);
    background-size: 200% 100%;
    animation: highlightSweep 1.5s ease-out;
    border-radius: 4px;
  }

  @keyframes highlightSweep {
    0% { 
      background-position: 100% 0;
      box-shadow: 0 0 0 2px hsl(var(--a) / 0.2);
    }
    50% {
      background-position: 0% 0;
    }
    100% { 
      background-position: -100% 0;
      box-shadow: 0 0 0 0 transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-match-highlight {
      animation: none;
      background: hsl(var(--a) / 0.1);
    }
  }
</style>
