---
/**
 * Command Palette Component
 * 
 * Premium keyboard-activated search overlay (⌘K / Ctrl+K).
 * Scoped to documentation content only via Pagefind filtering.
 * Theme-aware styling for all color modes.
 */
import { useTranslations } from '../../utils/i18n';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'ru');
const searchPlaceholder = t('docs.searchPlaceholder') || 'Search documentation...';
---

<!-- Backdrop -->
<div id="command-palette-backdrop" class="cp-backdrop"></div>

<!-- Palette -->
<div id="command-palette" class="cp-modal" role="dialog" aria-label="Search documentation">
  <div class="cp-header">
    <svg class="cp-search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input 
      type="text" 
      id="command-palette-input"
      class="cp-input" 
      placeholder={searchPlaceholder}
      autocomplete="off"
      aria-label="Search"
    />
    <kbd class="cp-esc">ESC</kbd>
  </div>
  
  <div id="command-palette-results" class="cp-results"></div>
</div>

<style>
  /* ===== BACKDROP ===== */
  .cp-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .cp-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* ===== MODAL ===== */
  .cp-modal {
    position: fixed;
    top: 12%;
    left: 50%;
    transform: translateX(-50%) translateY(-10px) scale(0.98);
    width: calc(100% - 20px);
    max-width: 560px;
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--bc) / 0.12);
    border-radius: 16px;
    box-shadow: 0 20px 60px -15px rgba(0, 0, 0, 0.35);
    z-index: 9999;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .cp-modal.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  /* ===== HEADER ===== */
  .cp-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid hsl(var(--bc) / 0.08);
  }

  .cp-search-icon {
    width: 20px;
    height: 20px;
    color: hsl(var(--a));
    opacity: 0.7;
    flex-shrink: 0;
  }

  .cp-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 16px; /* Prevents iOS zoom */
    font-weight: 500;
    outline: none;
    color: hsl(var(--bc));
    min-width: 0;
  }

  .cp-input::placeholder {
    color: hsl(var(--bc) / 0.4);
  }

  .cp-esc {
    font-size: 10px;
    padding: 4px 8px;
    background: hsl(var(--bc) / 0.06);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 5px;
    font-family: ui-monospace, monospace;
    font-weight: 600;
    color: hsl(var(--bc) / 0.45);
    flex-shrink: 0;
  }

  /* ===== RESULTS ===== */
  .cp-results {
    max-height: 55vh;
    overflow-y: auto;
    padding: 8px;
  }

  /* Empty state */
  .cp-empty {
    padding: 32px 16px;
    text-align: center;
    color: hsl(var(--bc) / 0.45);
  }

  .cp-empty-text {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 16px;
  }

  .cp-hints {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 11px;
  }

  .cp-hint {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .cp-hint kbd {
    font-size: 10px;
    padding: 2px 5px;
    background: hsl(var(--bc) / 0.06);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-weight: 600;
  }

  /* Result items */
  .cp-item {
    display: block;
    padding: 10px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s ease;
    text-decoration: none;
    margin-bottom: 2px;
  }

  .cp-item:hover,
  .cp-item.selected {
    background: hsl(var(--a) / 0.08);
  }

  .cp-item.selected {
    background: hsl(var(--a) / 0.12);
  }

  .cp-item-title {
    display: block;
    font-weight: 600;
    font-size: 14px;
    color: hsl(var(--bc));
    margin-bottom: 3px;
  }

  .cp-item:hover .cp-item-title,
  .cp-item.selected .cp-item-title {
    color: hsl(var(--a));
  }

  .cp-item-excerpt {
    display: block;
    font-size: 12px;
    color: hsl(var(--bc) / 0.55);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cp-item-excerpt mark {
    background: hsl(var(--a) / 0.2);
    color: hsl(var(--a));
    padding: 0 2px;
    border-radius: 2px;
  }

  /* Loading & no results */
  .cp-loading, .cp-no-results {
    padding: 32px 16px;
    text-align: center;
    color: hsl(var(--bc) / 0.45);
    font-size: 13px;
    font-weight: 500;
  }
</style>

<script>
  let pagefind: any = null;
  let selectedIndex = 0;
  let results: any[] = [];

  function initCommandPalette() {
    const backdrop = document.getElementById('command-palette-backdrop');
    const modal = document.getElementById('command-palette');
    const input = document.getElementById('command-palette-input') as HTMLInputElement;
    const resultsEl = document.getElementById('command-palette-results');

    if (!backdrop || !modal || !input || !resultsEl) return;

    // Load Pagefind at runtime only (not bundled)
    (async () => {
      try {
        const pagefindPath = '/pagefind/pagefind.js';
        pagefind = await (new Function(`return import("${pagefindPath}")`))();
        await pagefind.init();
      } catch (e) {
        console.warn('Pagefind not loaded');
      }
    })();

    function open() {
      backdrop.classList.add('is-open');
      modal.classList.add('is-open');
      input.focus();
      document.body.style.overflow = 'hidden';
      renderEmpty();
    }

    function close() {
      backdrop.classList.remove('is-open');
      modal.classList.remove('is-open');
      input.value = '';
      selectedIndex = 0;
      results = [];
      document.body.style.overflow = '';
    }

    function renderEmpty() {
      resultsEl.innerHTML = `
        <div class="cp-empty">
          <p class="cp-empty-text">Type to search the docs</p>
          <div class="cp-hints">
            <span class="cp-hint"><kbd>⌘K</kbd> open</span>
            <span class="cp-hint"><kbd>↑↓</kbd> navigate</span>
            <span class="cp-hint"><kbd>↵</kbd> go</span>
          </div>
        </div>
      `;
    }

    function renderResults() {
      if (results.length === 0) {
        resultsEl.innerHTML = `<div class="cp-no-results">No results found</div>`;
        return;
      }

      resultsEl.innerHTML = results.map((r, i) => {
        const title = r.meta?.title || 'Untitled';
        const excerpt = r.excerpt || '';
        const url = r.url.replace(/\.html$/, '').replace(/\/index$/, '');
        
        return `
          <a href="${url}?q=${encodeURIComponent(input.value)}" 
             class="cp-item ${i === selectedIndex ? 'selected' : ''}" 
             data-idx="${i}">
            <span class="cp-item-title">${title}</span>
            ${excerpt ? `<span class="cp-item-excerpt">${excerpt}</span>` : ''}
          </a>
        `;
      }).join('');

      resultsEl.querySelectorAll('.cp-item').forEach(el => {
        el.addEventListener('click', close);
      });
    }

    // Search
    let timeout: any;
    input.addEventListener('input', () => {
      clearTimeout(timeout);
      const q = input.value.trim();
      
      if (!q || q.length < 2) {
        results = [];
        renderEmpty();
        return;
      }

      if (!pagefind) return;

      timeout = setTimeout(async () => {
        resultsEl.innerHTML = `<div class="cp-loading">Searching...</div>`;
        
        try {
          const search = await pagefind.search(q);
          const all = await Promise.all(search.results.slice(0, 12).map((r: any) => r.data()));
          
          // Filter to docs only
          results = all.filter((r: any) => r.url.includes('/docs/')).slice(0, 6);
          selectedIndex = 0;
          renderResults();
        } catch (e) {
          resultsEl.innerHTML = `<div class="cp-no-results">Search error</div>`;
        }
      }, 120);
    });

    // Keyboard nav
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, results.length - 1);
        renderResults();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        renderResults();
      } else if (e.key === 'Enter' && results[selectedIndex]) {
        e.preventDefault();
        const url = results[selectedIndex].url.replace(/\.html$/, '').replace(/\/index$/, '');
        window.location.href = `${url}?q=${encodeURIComponent(input.value)}`;
        close();
      } else if (e.key === 'Escape') {
        close();
      }
    });

    backdrop.addEventListener('click', close);

    // Global shortcuts
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        open();
      }
      if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes((document.activeElement?.tagName || ''))) {
        e.preventDefault();
        open();
      }
    });

    renderEmpty();
  }

  // Highlight search terms on page load
  function highlightTerms() {
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    
    if (!q || q.length < 2) return;
    
    const terms = q.toLowerCase().split(/\s+/).filter(t => t.length >= 2);
    if (terms.length === 0) return;
    
    const content = document.querySelector('[data-pagefind-body]');
    if (!content) return;
    
    // Find and highlight text
    const walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    
    while (walker.nextNode()) {
      const node = walker.currentNode as Text;
      const text = node.textContent?.toLowerCase() || '';
      if (terms.some(t => text.includes(t))) {
        nodes.push(node);
      }
    }
    
    let firstMark: HTMLElement | null = null;
    
    nodes.forEach(node => {
      let html = node.textContent || '';
      let matched = false;
      
      terms.forEach(term => {
        const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp(`(${escaped})`, 'gi');
        if (re.test(html)) {
          matched = true;
          html = html.replace(re, '<mark class="search-hl">$1</mark>');
        }
      });
      
      if (matched) {
        const span = document.createElement('span');
        span.innerHTML = html;
        node.parentNode?.replaceChild(span, node);
        if (!firstMark) firstMark = span.querySelector('mark');
      }
    });
    
    // Scroll to first match
    if (firstMark) {
      setTimeout(() => {
        const y = firstMark!.getBoundingClientRect().top + window.scrollY - 150;
        window.scrollTo({ top: y, behavior: 'smooth' });
        
        // Pulse animation
        document.querySelectorAll('.search-hl').forEach(el => {
          el.classList.add('search-hl-pulse');
        });
        
        // Remove pulse after animation
        setTimeout(() => {
          document.querySelectorAll('.search-hl-pulse').forEach(el => {
            el.classList.remove('search-hl-pulse');
          });
        }, 2000);
      }, 150);
    }
    
    // Clean URL
    window.history.replaceState({}, '', window.location.pathname);
  }

  initCommandPalette();
  highlightTerms();
  
  document.addEventListener('astro:after-swap', () => {
    initCommandPalette();
    highlightTerms();
  });
</script>

<style is:global>
  /* Search highlight styles */
  .search-hl {
    background: hsl(var(--a) / 0.2);
    color: hsl(var(--a));
    padding: 1px 4px;
    border-radius: 3px;
    font-weight: 600;
  }
  
  .search-hl-pulse {
    animation: searchPulse 2s ease-out;
  }
  
  @keyframes searchPulse {
    0% { 
      background: hsl(var(--a) / 0.5);
      box-shadow: 0 0 0 4px hsl(var(--a) / 0.3);
    }
    100% { 
      background: hsl(var(--a) / 0.2);
      box-shadow: 0 0 0 0 hsl(var(--a) / 0);
    }
  }
</style>
