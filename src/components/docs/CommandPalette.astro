---
/**
 * Command Palette - Premium Documentation Search with Fuse.js
 * Features: Fuzzy search, match highlighting, grouped results, mobile-first
 */
import { useTranslations } from '../../utils/i18n';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'ru');
const docsBase = locale === 'en' ? '/docs' : `/${locale}/docs`;
---

<!-- Backdrop with blur -->
<div id="search-overlay" class="search-overlay"></div>

<!-- Search Dialog -->
<div id="search-dialog" class="search-dialog" role="dialog" aria-label="Search documentation" data-locale={locale}>
  <!-- Mobile swipe handle -->
  <div class="swipe-handle mobile-only">
    <div class="swipe-handle-bar"></div>
  </div>
  
  <!-- Input Section -->
  <div class="search-header">
    <div class="search-input-wrapper">
      <svg class="search-icon" style="width:18px;height:18px" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
      </svg>
      <div class="search-spinner"></div>
      <input
        id="search-input"
        type="text"
        placeholder={t('docs.searchPlaceholder') || 'Search documentation...'}
        autocomplete="off"
        spellcheck="false"
      />
      <button id="search-clear" class="search-clear" type="button" aria-label="Clear search">
        <svg style="width:20px;height:20px" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
      </button>
      <kbd class="search-kbd desktop-only">ESC</kbd>
    </div>
    <!-- Mobile close button -->
    <button id="mobile-close" class="mobile-close mobile-only">
      <svg style="width:24px;height:24px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Results Container -->
  <div id="search-results" class="search-results">
    <!-- Initial State -->
    <div class="search-initial" id="search-initial">
      <!-- Recent Searches -->
      <div class="search-section" id="recent-section">
        <div class="search-section-header">
          <span class="search-section-title">{t('docs.recentSearches') || 'Recent'}</span>
          <button class="search-clear-btn" id="clear-recent">{t('docs.clear') || 'Clear'}</button>
        </div>
        <div class="search-recent-list" id="recent-list"></div>
      </div>
      
      <!-- Quick Links -->
      <div class="search-section">
        <div class="search-section-header">
          <span class="search-section-title">{t('docs.quickLinks') || 'Quick Links'}</span>
        </div>
        <div class="search-quick-links">
          <a href={`${docsBase}/getting-started`} class="search-quick-link" data-quick-link>
            <span class="quick-link-icon">⚡</span>
            <span>{t('docs.gettingStarted') || 'Getting Started'}</span>
          </a>
          <a href={docsBase} class="search-quick-link" data-quick-link>
            <span class="quick-link-icon">🧩</span>
            <span>{t('docs.components') || 'Components'}</span>
          </a>
          <a href={`${docsBase}/themes`} class="search-quick-link" data-quick-link>
            <span class="quick-link-icon">🎨</span>
            <span>{t('docs.themes') || 'Themes'}</span>
          </a>
        </div>
      </div>

      <!-- Keyboard hints (desktop only) -->
      <div class="search-hints desktop-only" style="display: none;">
        <!-- Removed per user request -->
      </div>
    </div>

    <!-- Loading State -->
    <div class="search-loading" id="search-loading">
      <div class="loading-text">Loading search index...</div>
      <div class="loading-bar"><div class="loading-progress"></div></div>
    </div>

    <!-- Search Results List -->
    <div class="search-list" id="search-list"></div>

    <!-- Empty State -->
    <div class="search-empty" id="search-empty">
      <div class="empty-icon">🔍</div>
      <p class="empty-title">{t('docs.noResults') || 'No results found'}</p>
      <p class="empty-hint">{t('docs.tryDifferent') || 'Try different keywords'}</p>
      
      <!-- Did you mean? suggestions -->
      <div class="did-you-mean" id="did-you-mean">
        <span class="did-you-mean-label">{t('docs.didYouMean') || 'Did you mean?'}</span>
        <div class="did-you-mean-list" id="did-you-mean-list"></div>
      </div>
      
      <div class="empty-suggestions">
        <span>Try:</span>
        <button class="suggestion-btn" data-suggestion="hero">hero</button>
        <button class="suggestion-btn" data-suggestion="pricing">pricing</button>
        <button class="suggestion-btn" data-suggestion="theme">theme</button>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="search-footer">
    <span class="result-count" id="result-count"></span>
    <div class="search-hints-inline desktop-only">
      <span><kbd>↑↓</kbd> Navigate</span>
      <span><kbd>↵</kbd> Open</span>
      <span><kbd>esc</kbd> Close</span>
    </div>
  </div>
</div>

<style>
  /* ========== RESPONSIVE HELPERS ========== */
  .desktop-only { display: flex; }
  .mobile-only { display: none; }
  
  @media (max-width: 640px) {
    .desktop-only { display: none !important; }
    .mobile-only { display: flex !important; }
  }

  /* ========== OVERLAY ========== */
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none; /* Prevent clicks when hidden */
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .search-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto; /* Re-enable clicks */
  }

  /* ========== DIALOG - Desktop ========== */
  .search-dialog {
    position: fixed;
    top: 12%;
    left: 50%;
    transform: translateX(-50%) translateY(-10px) scale(0.98);
    width: min(580px, calc(100vw - 32px));
    max-height: 70vh;
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--bc) / 0.1);
    border-radius: 16px;
    box-shadow: 
      0 25px 60px -12px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 hsl(var(--bc) / 0.05);
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: 
      opacity 0.15s ease,
      visibility 0.15s ease,
      transform 0.25s cubic-bezier(0.32, 0.72, 0, 1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .search-dialog.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  /* ========== DIALOG - Mobile (Full Screen Bottom Sheet) ========== */
  @media (max-width: 640px) {
    .search-dialog {
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      transform: translateY(100%);
      width: 100%;
      max-height: 90vh;
      border-radius: 20px 20px 0 0;
      padding-bottom: env(safe-area-inset-bottom, 0);
    }
    .search-dialog.is-open {
      transform: translateY(0);
    }
    
    /* Larger touch targets on mobile */
    .search-item {
      padding: 14px 16px;
      margin-bottom: 6px;
    }
    
    .search-quick-link {
      padding: 18px 14px;
    }
    
    .recent-item {
      padding: 12px 14px;
    }
    
    .suggestion-btn {
      padding: 8px 14px;
      min-height: 36px;
    }
  }

  /* ========== SWIPE HANDLE ========== */
  .swipe-handle {
    display: flex;
    justify-content: center;
    padding: 10px 0 6px;
    cursor: grab;
    touch-action: none;
  }

  .swipe-handle:active {
    cursor: grabbing;
  }

  .swipe-handle-bar {
    width: 40px;
    height: 5px;
    background: hsl(var(--bc) / 0.15);
    border-radius: 3px;
    transition: background 0.15s ease;
  }

  .swipe-handle:active .swipe-handle-bar {
    background: hsl(var(--bc) / 0.3);
  }

  /* ========== INPUT ========== */
  .search-header {
    padding: 16px 18px;
    border-bottom: 1px solid hsl(var(--bc) / 0.08);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    position: relative;
  }

  .search-icon {
    color: hsl(var(--bc) / 0.4);
    flex-shrink: 0;
    transition: opacity 0.15s;
  }

  .search-dialog.is-searching .search-icon {
    opacity: 0;
  }

  .search-spinner {
    position: absolute;
    left: 0;
    width: 18px;
    height: 18px;
    border: 2px solid hsl(var(--a) / 0.2);
    border-top-color: hsl(var(--a));
    border-radius: 50%;
    opacity: 0;
    animation: spin 0.6s linear infinite;
  }

  .search-dialog.is-searching .search-spinner {
    opacity: 1;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  #search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 16px;
    font-weight: 500;
    color: hsl(var(--bc));
    caret-color: hsl(var(--a));
    min-width: 0;
  }

  #search-input::placeholder {
    color: hsl(var(--bc) / 0.35);
    font-weight: 400;
  }

  /* Typing glow effect */
  .search-input-wrapper::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 10px;
    background: linear-gradient(135deg, hsl(var(--a) / 0.15), hsl(var(--a) / 0.05));
    opacity: 0;
    z-index: -1;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  #search-input:focus + .search-clear ~ .search-kbd ~ .search-input-wrapper::after,
  .search-dialog.has-query .search-input-wrapper::after {
    opacity: 1;
  }

  .search-clear {
    padding: 0;
    background: none;
    border: none;
    color: hsl(var(--bc) / 0.3);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s;
  }

  .search-clear.visible {
    opacity: 1;
  }

  .search-clear:hover {
    color: hsl(var(--bc) / 0.6);
  }

  .search-kbd {
    font-size: 10px;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 600;
    padding: 4px 8px;
    background: hsl(var(--bc) / 0.05);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 5px;
    color: hsl(var(--bc) / 0.4);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .mobile-close {
    background: none;
    border: none;
    color: hsl(var(--bc) / 0.5);
    padding: 8px;
    margin: -8px;
    cursor: pointer;
  }

  /* ========== RESULTS AREA ========== */
  .search-results {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    min-height: 180px;
    max-height: 400px;
  }

  @media (max-width: 640px) {
    .search-results {
      max-height: calc(90vh - 140px);
    }
  }

  /* Initial state */
  .search-initial {
    padding: 16px 18px;
  }

  .search-initial.hidden {
    display: none;
  }

  .search-section {
    margin-bottom: 20px;
  }

  .search-section:last-of-type {
    margin-bottom: 0;
  }

  .search-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .search-section-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: hsl(var(--bc) / 0.4);
  }

  .search-clear-btn {
    font-size: 11px;
    font-weight: 500;
    color: hsl(var(--bc) / 0.35);
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 4px;
    transition: all 0.15s ease;
  }

  .search-clear-btn:hover {
    color: hsl(var(--a));
    background: hsl(var(--a) / 0.1);
  }

  /* Recent searches */
  .search-recent-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .recent-item {
    display: flex;
    align-items: center;
    gap: 12px !important;
    padding: 8px 12px !important;
    border-radius: 8px;
    cursor: pointer;
    color: hsl(var(--bc) / 0.7);
    font-size: 13px !important;
    font-weight: 500;
    background: transparent !important;
    border: none !important;
    width: 100%;
    text-align: left;
    transition: all 0.2s ease;
  }

  .recent-item:hover {
    background: hsl(var(--bc) / 0.04) !important;
    color: hsl(var(--bc));
  }

  .recent-icon {
    width: 16px !important;
    height: 16px !important;
    opacity: 0.3 !important;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }
  
  .recent-item:hover .recent-icon {
    opacity: 0.7 !important;
  }
  
  .recent-text {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Quick links */
  .search-quick-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  @media (max-width: 640px) {
    .search-quick-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .search-quick-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px 12px;
    background: hsl(var(--bc) / 0.03);
    border: 1px solid hsl(var(--bc) / 0.06);
    border-radius: 12px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 500;
    color: hsl(var(--bc) / 0.6);
    transition: all 0.15s ease;
  }

  .search-quick-link:hover {
    background: hsl(var(--a) / 0.08);
    border-color: hsl(var(--a) / 0.15);
    color: hsl(var(--a));
    transform: translateY(-2px);
  }

  .quick-link-icon {
    font-size: 22px;
  }

  /* Keyboard hints */
  .search-hints {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 16px 0 8px;
    font-size: 11px;
    color: hsl(var(--bc) / 0.35);
  }

  .search-hints span {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .search-hints kbd {
    font-size: 9px;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 600;
    padding: 2px 5px;
    background: hsl(var(--bc) / 0.05);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 4px;
    color: hsl(var(--bc) / 0.4);
  }

  /* ========== LOADING ========== */
  .search-loading {
    display: none;
    padding: 40px 18px;
    text-align: center;
  }

  .search-loading.visible {
    display: block;
  }

  .loading-text {
    font-size: 13px;
    color: hsl(var(--bc) / 0.5);
    margin-bottom: 12px;
  }

  .loading-bar {
    height: 4px;
    background: hsl(var(--bc) / 0.1);
    border-radius: 2px;
    overflow: hidden;
    max-width: 200px;
    margin: 0 auto;
  }

  .loading-progress {
    height: 100%;
    width: 40%;
    background: hsl(var(--a));
    border-radius: 2px;
    animation: loadingSlide 1s ease infinite;
  }

  @keyframes loadingSlide {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(350%); }
  }

  /* ========== RESULTS LIST ========== */
  .search-list {
    display: none;
    padding: 8px 12px;
  }

  .search-list.visible {
    display: block;
  }

  /* Section groups */
  .result-group {
    margin-bottom: 16px;
    animation: groupFadeIn 0.25s ease forwards;
  }

  @keyframes groupFadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .result-group:last-child {
    margin-bottom: 0;
  }

  .result-group-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    margin-bottom: 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: hsl(var(--bc) / 0.5);
    background: hsl(var(--bc) / 0.03);
    border-radius: 8px;
    border-bottom: 1px solid hsl(var(--bc) / 0.05);
  }

  .result-group-icon {
    font-size: 14px;
    transition: transform 0.2s ease;
  }

  .result-group:hover .result-group-icon {
    transform: scale(1.1);
  }

  /* Result item - Force transparency and no border initially */
  .search-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px !important;
    border-radius: 12px !important;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    margin-bottom: 6px;
    background: transparent !important;
    border: 1px solid transparent !important;
    opacity: 0;
    transform: translateY(8px);
    animation: staggerFadeIn 0.3s ease forwards;
  }

  /* Stagger animation delays (set via JS style attribute) */
  @keyframes staggerFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .search-item:hover,
  .search-item.selected {
    background: hsl(var(--bc) / 0.03) !important;
    border-color: hsl(var(--bc) / 0.05) !important;
    transform: translateY(0) !important;
    box-shadow: none !important;
  }

  .search-item.selected {
    background: hsl(var(--a) / 0.04) !important;
    border-color: hsl(var(--a) / 0.15) !important;
  }

  /* Stagger animation delays (set via JS style attribute) */
  @keyframes staggerFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .search-item:hover,
  .search-item.selected {
    background: hsl(var(--a) / 0.06);
    border-color: hsl(var(--a) / 0.2);
    transform: translateY(-1px);
  }

  .search-item.selected {
    background: hsl(var(--a) / 0.08);
    border-color: hsl(var(--a) / 0.3);
    box-shadow: 0 4px 12px hsl(var(--a) / 0.12);
  }


  .search-item-icon {
    font-size: 18px;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: hsl(var(--bc) / 0.05);
    border-radius: 8px;
    transition: all 0.1s ease;
  }

  .search-item:hover .search-item-icon,
  .search-item.selected .search-item-icon {
    background: hsl(var(--a) / 0.12);
  }

  .search-item-content {
    flex: 1;
    min-width: 0;
  }

  .search-item-title {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--bc));
    margin-bottom: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-item:hover .search-item-title,
  .search-item.selected .search-item-title {
    color: hsl(var(--a));
  }

  .search-item-snippet {
    font-size: 12px;
    color: hsl(var(--bc) / 0.55);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-item-breadcrumb {
    font-size: 11px;
    color: hsl(var(--bc) / 0.35);
    margin-top: 4px;
  }

  .search-item-arrow {
    color: hsl(var(--bc) / 0.2);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.1s ease;
    align-self: center;
  }

  .search-item:hover .search-item-arrow,
  .search-item.selected .search-item-arrow {
    opacity: 1;
    transform: translateX(0);
    color: hsl(var(--a));
  }

  /* Match highlight */
  .search-item-snippet :global(mark) {
    background: hsl(var(--a) / 0.2);
    color: hsl(var(--a));
    padding: 0.1em 0.2em;
    border-radius: 3px;
    font-weight: 600;
  }

  /* Relevance badge */
  .search-item-badge {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 6px;
    border-radius: 4px;
    background: hsl(var(--a) / 0.12);
    color: hsl(var(--a));
    flex-shrink: 0;
  }

  /* ========== EMPTY STATE ========== */
  .search-empty {
    display: none;
    text-align: center;
    padding: 40px 24px;
  }

  .search-empty.visible {
    display: block;
  }

  .empty-icon {
    font-size: 48px;
    margin-bottom: 12px;
    opacity: 0.5;
  }

  .empty-title {
    font-size: 15px;
    font-weight: 600;
    color: hsl(var(--bc) / 0.6);
    margin-bottom: 4px;
  }

  .empty-hint {
    font-size: 13px;
    color: hsl(var(--bc) / 0.4);
    margin-bottom: 16px;
  }

  /* Did you mean? */
  .did-you-mean {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding: 12px 16px;
    background: hsl(var(--a) / 0.05);
    border: 1px solid hsl(var(--a) / 0.1);
    border-radius: 10px;
  }

  .did-you-mean.visible {
    display: flex;
  }

  .did-you-mean-label {
    font-size: 12px;
    font-weight: 600;
    color: hsl(var(--a) / 0.8);
  }

  .did-you-mean-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .did-you-mean-btn {
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--a) / 0.2);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 500;
    color: hsl(var(--a));
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .did-you-mean-btn:hover {
    background: hsl(var(--a) / 0.1);
    border-color: hsl(var(--a) / 0.3);
    transform: translateY(-1px);
  }

  .empty-suggestions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 12px;
    color: hsl(var(--bc) / 0.4);
  }

  .suggestion-btn {
    background: hsl(var(--bc) / 0.05);
    border: 1px solid hsl(var(--bc) / 0.1);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    color: hsl(var(--bc) / 0.7);
    cursor: pointer;
    transition: all 0.15s;
  }

  .suggestion-btn:hover {
    background: hsl(var(--a) / 0.1);
    border-color: hsl(var(--a) / 0.2);
    color: hsl(var(--a));
  }

  /* ========== FOOTER ========== */
  .search-footer {
    padding: 10px 18px;
    border-top: 1px solid hsl(var(--bc) / 0.06);
    font-size: 11px;
    color: hsl(var(--bc) / 0.4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
  }

  .result-count {
    font-weight: 500;
  }

  .search-hints-inline {
    display: flex;
    gap: 16px;
    font-size: 10px;
    color: hsl(var(--bc) / 0.35);
  }

  .search-hints-inline span {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .search-hints-inline kbd {
    font-size: 9px;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 600;
    padding: 2px 4px;
    background: hsl(var(--bc) / 0.05);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 3px;
    color: hsl(var(--bc) / 0.4);
  }

  /* ========== HIDDEN STATES ========== */
  #recent-section.hidden {
    display: none;
  }
</style>

<script is:inline>
(function() {
  var Fuse = null;
  var searchIndex = null;
  var fuse = null;
  var results = [];
  var selected = 0;
  var debounceTimer = null;

  var STORAGE_KEY = 'docs-recent-searches';
  var MAX_RECENT = 5;

  // Detect current locale from URL
  function getCurrentLocale() {
    var path = window.location.pathname;
    if (path.startsWith('/ru/') || path === '/ru') return 'ru';
    return 'en';
  }

  function getDocsBase() {
    var locale = getCurrentLocale();
    return locale === 'en' ? '/docs' : '/' + locale + '/docs';
  }

  function getRecentSearches() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch (e) {
      return [];
    }
  }

  function saveRecentSearch(query) {
    if (!query || query.length < 2) return;
    var recent = getRecentSearches().filter(function(q) { return q !== query; });
    recent.unshift(query);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(recent.slice(0, MAX_RECENT)));
  }

  function clearRecentSearches() {
    localStorage.removeItem(STORAGE_KEY);
  }

  // Extract snippet around matched text
  function extractSnippet(content, query, maxLength) {
    maxLength = maxLength || 80;
    var lowerContent = content.toLowerCase();
    var lowerQuery = query.toLowerCase();
    var words = lowerQuery.split(/\s+/);
    
    // Find first matching word position
    var matchPos = -1;
    for (var i = 0; i < words.length; i++) {
      var pos = lowerContent.indexOf(words[i]);
      if (pos !== -1) {
        matchPos = pos;
        break;
      }
    }
    
    if (matchPos === -1) {
      return content.slice(0, maxLength) + '...';
    }
    
    // Extract snippet around match
    var start = Math.max(0, matchPos - 30);
    var end = Math.min(content.length, matchPos + maxLength - 30);
    var snippet = content.slice(start, end);
    
    // Add ellipsis
    if (start > 0) snippet = '...' + snippet;
    if (end < content.length) snippet = snippet + '...';
    
    // Highlight matching words
    words.forEach(function(word) {
      if (word.length < 2) return;
      var regex = new RegExp('(' + word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
      snippet = snippet.replace(regex, '<mark>$1</mark>');
    });
    
    return snippet;
  }

  function init() {
    var overlay = document.getElementById('search-overlay');
    var dialog = document.getElementById('search-dialog');
    var input = document.getElementById('search-input');
    var clearBtn = document.getElementById('search-clear');
    var mobileCloseBtn = document.getElementById('mobile-close');
    var searchList = document.getElementById('search-list');
    var searchLoading = document.getElementById('search-loading');
    var searchEmpty = document.getElementById('search-empty');
    var searchInitial = document.getElementById('search-initial');
    var recentSection = document.getElementById('recent-section');
    var recentList = document.getElementById('recent-list');
    var clearRecentBtn = document.getElementById('clear-recent');
    var resultCount = document.getElementById('result-count');

    if (!overlay || !dialog || !input) return;

    // Load Fuse.js and search index
    function loadSearch() {
      if (Fuse && searchIndex) return Promise.resolve();
      
      showLoading(true); // Silent loading (don't hide initial content)
      var locale = getCurrentLocale();
      
      return Promise.all([
        import('https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.mjs'),
        fetch('/search/' + locale + '.json').then(function(r) { return r.json(); })
      ]).then(function(results) {
        Fuse = results[0].default;
        searchIndex = results[1];
        
        fuse = new Fuse(searchIndex, {
          keys: [
            { name: 'title', weight: 0.5 },
            { name: 'headings', weight: 0.25 },
            { name: 'description', weight: 0.15 },
            { name: 'content', weight: 0.1 }
          ],
          threshold: 0.35,
          distance: 1000,
          ignoreLocation: true,
          includeScore: true,
          includeMatches: true,
          minMatchCharLength: 2
        });
        
        hideLoading();
      }).catch(function(e) {
        console.error('Error loading search:', e);
        hideLoading();
      });
    }

    function renderRecentSearches() {
      var recent = getRecentSearches();
      if (!recentList || !recentSection) return;
      
      if (recent.length === 0) {
        recentSection.classList.add('hidden');
        return;
      }

      recentSection.classList.remove('hidden');
      recentList.innerHTML = recent.map(function(q) {
        return '<button class="recent-item" data-query="' + q + '" style="display:flex;align-items:center;gap:12px;padding:8px 12px;width:100%;background:transparent;border:none;cursor:pointer;text-align:left;">' +
          '<svg class="recent-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16" style="width:16px;height:16px;opacity:0.5;flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>' + 
          '<span class="recent-text" style="font-size:13px;font-weight:500;color:currentColor;">' + q + '</span>' +
          '</button>';
      }).join('');

      recentList.querySelectorAll('.recent-item').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var query = btn.getAttribute('data-query') || '';
          input.value = query;
          updateClearButton();
          performSearch(query);
        });
      });
    }

    function updateClearButton() {
      if (clearBtn) {
        if (input.value.length > 0) {
          clearBtn.classList.add('visible');
          dialog.classList.add('has-query');
        } else {
          clearBtn.classList.remove('visible');
          dialog.classList.remove('has-query');
        }
      }
    }

    function showInitial() {
      if (searchInitial) searchInitial.classList.remove('hidden');
      if (searchList) searchList.classList.remove('visible');
      if (searchLoading) searchLoading.classList.remove('visible');
      if (searchEmpty) searchEmpty.classList.remove('visible');
      if (resultCount) resultCount.textContent = '';
      renderRecentSearches();
    }

    function showLoading(silent) {
      if (!silent) {
        dialog.classList.add('is-searching');
        if (searchInitial) searchInitial.classList.add('hidden');
        if (searchList) searchList.classList.remove('visible');
        if (searchEmpty) searchEmpty.classList.remove('visible');
      }
      if (searchLoading) searchLoading.classList.add('visible');
    }
    
    function hideLoading() {
      dialog.classList.remove('is-searching');
      if (searchLoading) searchLoading.classList.remove('visible');
    }

    function showEmpty(query) {
      dialog.classList.remove('is-searching');
      if (searchInitial) searchInitial.classList.add('hidden');
      if (searchList) searchList.classList.remove('visible');
      if (searchLoading) searchLoading.classList.remove('visible');
      if (searchEmpty) searchEmpty.classList.add('visible');
      if (resultCount) resultCount.textContent = '0 results';
      
      // Generate "Did you mean?" suggestions with looser matching
      var didYouMean = document.getElementById('did-you-mean');
      var didYouMeanList = document.getElementById('did-you-mean-list');
      
      if (didYouMean && didYouMeanList && fuse && query) {
        // Search with much higher threshold (looser matching)
        var looseFuse = new Fuse(searchIndex, {
          keys: ['title'],
          threshold: 0.6,
          distance: 200,
          includeScore: true
        });
        
        var suggestions = looseFuse.search(query)
          .filter(function(r) { return r.score > 0.3; }) // Only show suggestions that aren't too close (those would have matched)
          .slice(0, 3)
          .map(function(r) { return r.item.title; });
        
        if (suggestions.length > 0) {
          didYouMean.classList.add('visible');
          didYouMeanList.innerHTML = suggestions.map(function(title) {
            return '<button class="did-you-mean-btn" data-suggestion="' + title + '">' + title + '</button>';
          }).join('');
          
          // Add click handlers
          didYouMeanList.querySelectorAll('.did-you-mean-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var suggestion = btn.getAttribute('data-suggestion') || '';
              input.value = suggestion;
              updateClearButton();
              performSearch(suggestion);
            });
          });
        } else {
          didYouMean.classList.remove('visible');
        }
      } else if (didYouMean) {
        didYouMean.classList.remove('visible');
      }
    }

    function showResults() {
      dialog.classList.remove('is-searching');
      if (searchInitial) searchInitial.classList.add('hidden');
      if (searchList) searchList.classList.add('visible');
      if (searchLoading) searchLoading.classList.remove('visible');
      if (searchEmpty) searchEmpty.classList.remove('visible');
    }

    function renderResults(query) {
      if (!searchList) return;
      
      // Group results by section
      var groups = {};
      results.forEach(function(r, i) {
        var section = r.item.section;
        if (!groups[section]) {
          groups[section] = {
            icon: r.item.sectionIcon,
            order: r.item.sectionOrder,
            items: []
          };
        }
        groups[section].items.push({ result: r, index: i });
      });
      
      // Sort groups by order
      var sortedSections = Object.keys(groups).sort(function(a, b) {
        return groups[a].order - groups[b].order;
      });
      
      var html = '';
      var globalIndex = 0;
      
      sortedSections.forEach(function(section) {
        var group = groups[section];
        html += '<div class="result-group">';
        html += '<div class="result-group-header">';
        html += '<span class="result-group-icon">' + group.icon + '</span>';
        html += '<span>' + section + '</span>';
        html += '</div>';
        
        group.items.forEach(function(item) {
          var r = item.result;
          var isSelected = globalIndex === selected;
          var score = r.score || 0;
          var badge = score < 0.15 ? '<span class="search-item-badge">Best Match</span>' : '';
          var snippet = extractSnippet(r.item.content || r.item.description, query);
          
          html += '<a href="' + r.item.url + '?q=' + encodeURIComponent(query) + '" class="search-item ' + (isSelected ? 'selected' : '') + '" data-idx="' + globalIndex + '" style="animation-delay: ' + (globalIndex * 40) + 'ms; display:flex; gap:12px; padding:12px 14px; align-items:flex-start;">';
          html += '<div class="search-item-icon" style="flex-shrink:0;">' + r.item.sectionIcon + '</div>';
          html += '<div class="search-item-content">';
          html += '<span class="search-item-title">' + r.item.title + '</span>';
          html += '<div class="search-item-snippet">' + snippet + '</div>';
          html += '</div>';
          html += badge;
          html += '<svg class="search-item-arrow" style="width:16px;height:16px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>';
          html += '</a>';
          
          globalIndex++;
        });
        
        html += '</div>';
      });
      
      searchList.innerHTML = html;

      if (resultCount) {
        resultCount.textContent = results.length + ' result' + (results.length !== 1 ? 's' : '');
      }

      searchList.querySelectorAll('.search-item').forEach(function(el) {
        el.addEventListener('click', function() {
          saveRecentSearch(input.value.trim());
          close();
        });
      });

      showResults();
    }

    function performSearch(query) {
      if (!query || query.length < 2) {
        showInitial();
        return;
      }

      if (!fuse) {
        loadSearch().then(function() {
          if (fuse) doSearch();
        });
        return;
      }

      doSearch();

      function doSearch() {
        results = fuse.search(query).slice(0, 10);
        selected = 0;

        if (results.length === 0) {
          showEmpty(query);
        } else {
          renderResults(query);
        }
      }
    }

    function open() {
      overlay.classList.add('is-open');
      dialog.classList.add('is-open');
      input.value = '';
      updateClearButton();
      input.focus();
      showInitial();
      document.body.style.overflow = 'hidden';
      
      // Preload search index
      loadSearch();
    }

    function close() {
      overlay.classList.remove('is-open');
      dialog.classList.remove('is-open');
      dialog.classList.remove('is-searching');
      results = [];
      selected = 0;
      document.body.style.overflow = '';
    }

    // Input handler
    input.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      updateClearButton();
      var q = input.value.trim();
      
      if (!q || q.length < 2) {
        showInitial();
        return;
      }

      debounceTimer = setTimeout(function() { performSearch(q); }, 100);
    });

    // Clear button
    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        input.value = '';
        updateClearButton();
        showInitial();
        input.focus();
      });
    }

    // Mobile close button
    if (mobileCloseBtn) {
      mobileCloseBtn.addEventListener('click', close);
    }

    // Keyboard navigation
    // Keyboard navigation (Window level to trap events even if focus is lost)
    function handleKeydown(e) {
      if (!dialog.classList.contains('is-open')) return;
      
      if (e.key === 'ArrowDown') {
        e.preventDefault(); // Stop page scroll
        if (results.length > 0) {
          selected = Math.min(selected + 1, results.length - 1);
          renderResults(input.value.trim()); // Re-render with new selection
          scrollSelectedIntoView();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault(); // Stop page scroll
        if (results.length > 0) {
          selected = Math.max(selected - 1, 0);
          renderResults(input.value.trim());
          scrollSelectedIntoView();
        }
      } else if (e.key === 'Enter') {
        if (results.length > 0 && results[selected]) {
          e.preventDefault();
          saveRecentSearch(input.value.trim());
          var url = results[selected].item.url + '?q=' + encodeURIComponent(input.value.trim());
          if (e.shiftKey) {
            window.open(url, '_blank');
          } else {
            window.location.href = url;
          }
          close();
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        close();
      }
    }
    
    // Attach to window instead of input
    window.addEventListener('keydown', handleKeydown);

    // Clean up input listener (kept only for typing)
    // input.addEventListener('keydown', ...) removed

    function scrollSelectedIntoView() {
      var selectedEl = searchList && searchList.querySelector('.search-item.selected');
      if (selectedEl) selectedEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    // Clear recent
    if (clearRecentBtn) {
      clearRecentBtn.addEventListener('click', function() {
        clearRecentSearches();
        renderRecentSearches();
      });
    }

    // Suggestion buttons
    document.querySelectorAll('.suggestion-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var suggestion = btn.getAttribute('data-suggestion') || '';
        input.value = suggestion;
        updateClearButton();
        performSearch(suggestion);
      });
    });

    // Quick links
    document.querySelectorAll('[data-quick-link]').forEach(function(link) {
      link.addEventListener('click', function() { close(); });
    });

    // Search trigger buttons (desktop + mobile)
    var desktopTrigger = document.getElementById('docs-search-trigger');
    var mobileTrigger = document.getElementById('mobile-search-btn');
    
    if (desktopTrigger) {
      desktopTrigger.addEventListener('click', function(e) {
        e.preventDefault();
        open();
      });
    }
    
    if (mobileTrigger) {
      mobileTrigger.addEventListener('click', function(e) {
        e.preventDefault();
        open();
      });
    }

    // Close handlers
    overlay.addEventListener('click', close);

    // Global shortcuts
    document.addEventListener('keydown', function(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        open();
      }
      if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes((document.activeElement && document.activeElement.tagName) || '')) {
        e.preventDefault();
        open();
      }
    });

    // ========== MOBILE SWIPE-TO-CLOSE ==========
    var touchStartY = 0;
    var touchCurrentY = 0;
    var isDragging = false;
    var dragThreshold = 80; // Pixels to swipe down to close

    function handleTouchStart(e) {
      if (window.innerWidth > 640) return; // Only on mobile
      var header = dialog.querySelector('.search-header');
      var swipeHandle = dialog.querySelector('.swipe-handle');
      var isValidTarget = (header && header.contains(e.target)) || (swipeHandle && swipeHandle.contains(e.target));
      if (!isValidTarget) return; // Only drag from header or swipe handle
      
      touchStartY = e.touches[0].clientY;
      isDragging = true;
      dialog.style.transition = 'none';
    }

    function handleTouchMove(e) {
      if (!isDragging || window.innerWidth > 640) return;
      
      touchCurrentY = e.touches[0].clientY;
      var deltaY = touchCurrentY - touchStartY;
      
      if (deltaY > 0) {
        // Swiping down - translate dialog
        dialog.style.transform = 'translateY(' + deltaY + 'px)';
        
        // Update opacity based on drag distance
        var opacity = Math.max(0.3, 1 - (deltaY / 300));
        overlay.style.opacity = opacity;
      }
    }

    function handleTouchEnd() {
      if (!isDragging || window.innerWidth > 640) return;
      isDragging = false;
      
      var deltaY = touchCurrentY - touchStartY;
      dialog.style.transition = '';
      overlay.style.transition = '';
      
      if (deltaY > dragThreshold) {
        // Close the dialog
        close();
      } else {
        // Snap back
        dialog.style.transform = '';
        overlay.style.opacity = '';
      }
      
      touchStartY = 0;
      touchCurrentY = 0;
    }

    dialog.addEventListener('touchstart', handleTouchStart, { passive: true });
    dialog.addEventListener('touchmove', handleTouchMove, { passive: true });
    dialog.addEventListener('touchend', handleTouchEnd, { passive: true });

    showInitial();
  }

  // Highlight on page load with improved section detection
  function highlightOnLoad() {
    var params = new URLSearchParams(window.location.search);
    var query = params.get('q') || params.get('highlight');
    if (!query || query.length < 2) return;

    setTimeout(function() {
      var article = document.querySelector('article') || document.querySelector('.prose') || document.querySelector('main');
      if (!article) return;

      var words = query.toLowerCase().split(/\s+/).filter(function(w) { return w.length >= 2; });
      var queryLower = query.toLowerCase();
      var matchEl = null;
      var matchType = 'none'; // 'heading-exact', 'heading-words', 'content'

      // Strategy 1: Find exact match in headings (h1-h6)
      var headings = article.querySelectorAll('h1, h2, h3, h4, h5, h6');
      for (var i = 0; i < headings.length; i++) {
        var h = headings[i];
        var text = (h.textContent || '').toLowerCase();
        if (text.includes(queryLower)) {
          matchEl = h;
          matchType = 'heading-exact';
          break;
        }
      }

      // Strategy 2: Find word matches in headings
      if (!matchEl) {
        for (var i = 0; i < headings.length; i++) {
          var h = headings[i];
          var text = (h.textContent || '').toLowerCase();
          var hasMatch = words.some(function(word) { return text.includes(word); });
          if (hasMatch) {
            matchEl = h;
            matchType = 'heading-words';
            break;
          }
        }
      }

      // Strategy 3: Find in any text content
      if (!matchEl) {
        var walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT);
        while (walker.nextNode()) {
          var text = (walker.currentNode.textContent || '').toLowerCase();
          var hasMatch = words.some(function(word) { return text.includes(word); });
          if (hasMatch) {
            matchEl = walker.currentNode.parentElement;
            matchType = 'content';
            break;
          }
        }
      }

      if (matchEl) {
        // Calculate scroll position with header offset
        var headerHeight = 80;
        var extraPadding = matchType.startsWith('heading') ? 40 : 100;
        var rect = matchEl.getBoundingClientRect();
        var scrollY = window.scrollY + rect.top - headerHeight - extraPadding;
        
        window.scrollTo({ top: Math.max(0, scrollY), behavior: 'smooth' });

        // Apply highlight with delay for scroll completion
        setTimeout(function() {
          matchEl.classList.add('search-match-highlight');
          
          // Also add a ring effect for headings
          if (matchType.startsWith('heading')) {
            matchEl.classList.add('search-match-heading');
          }
        }, 400);

        // Remove highlight
        setTimeout(function() {
          matchEl.classList.remove('search-match-highlight');
          matchEl.classList.remove('search-match-heading');
        }, 3000);

        // Clean up URL
        history.replaceState(null, '', window.location.pathname);
      }
    }, 350);
  }

  init();
  highlightOnLoad();

  document.addEventListener('astro:after-swap', function() {
    Fuse = null;
    searchIndex = null;
    fuse = null;
    init();
    highlightOnLoad();
  });
})();
</script>

<style is:global>
  /* ========== SEARCH RESULT HIGHLIGHT ========== */
  /* NO LAYOUT SHIFT: Use overlay instead of changing properties */
  
  .search-match-highlight,
  .search-match-heading {
    position: relative;
    /* Do NOT change display property here to avoid layout shifts */
  }

  /* The actual shimmer effect is an overlay */
  .search-match-highlight::after,
  .search-match-heading::after {
    content: '';
    position: absolute;
    inset: -2px; /* Slight expansion */
    background: linear-gradient(
      90deg, 
      transparent 0%,
      hsl(var(--a) / 0.05) 40%,
      hsl(var(--a) / 0.1) 50%,
      hsl(var(--a) / 0.05) 60%,
      transparent 100%
    );
    background-size: 200% 100%;
    border-radius: 4px;
    z-index: 10;
