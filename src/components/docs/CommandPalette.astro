---
/**
 * Command Palette - Search with proper scroll-to-section
 */
import { useTranslations } from '../../utils/i18n';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'ru');
---

<div id="search-overlay" class="search-overlay"></div>

<div id="search-dialog" class="search-dialog" role="dialog">
  <div class="search-input-wrapper">
    <svg class="search-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
    </svg>
    <input
      id="search-input"
      type="text"
      placeholder="Search..."
      autocomplete="off"
      spellcheck="false"
    />
    <kbd class="search-kbd">ESC</kbd>
  </div>

  <div id="search-results" class="search-results">
    <div class="search-hint">
      <span>Type to search documentation</span>
      <div class="search-hint-keys">
        <span><kbd>↑↓</kbd> navigate</span>
        <span><kbd>↵</kbd> open</span>
      </div>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }
  .search-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .search-dialog {
    position: fixed;
    top: 12%;
    left: 50%;
    transform: translateX(-50%) translateY(-8px) scale(0.98);
    width: min(540px, 90vw);
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--bc) / 0.12);
    border-radius: 16px;
    box-shadow: 
      0 25px 50px -12px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 hsl(var(--bc) / 0.04);
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }
  .search-dialog.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  /* Input */
  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid hsl(var(--bc) / 0.08);
  }
  .search-input-icon {
    width: 18px;
    height: 18px;
    color: hsl(var(--bc) / 0.35);
    flex-shrink: 0;
  }
  #search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 16px;
    font-weight: 500;
    color: hsl(var(--bc));
    caret-color: hsl(var(--a));
  }
  #search-input::placeholder {
    color: hsl(var(--bc) / 0.4);
    font-weight: 400;
  }
  .search-kbd {
    font-size: 10px;
    font-family: system-ui, sans-serif;
    font-weight: 600;
    padding: 4px 8px;
    background: hsl(var(--bc) / 0.06);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 6px;
    color: hsl(var(--bc) / 0.45);
    text-transform: uppercase;
  }

  /* Results area */
  .search-results {
    max-height: 340px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Hint (empty state) */
  .search-hint {
    padding: 40px 24px;
    text-align: center;
  }
  .search-hint > span {
    display: block;
    font-size: 14px;
    color: hsl(var(--bc) / 0.45);
    margin-bottom: 16px;
  }
  .search-hint-keys {
    display: flex;
    justify-content: center;
    gap: 20px;
    font-size: 12px;
    color: hsl(var(--bc) / 0.35);
  }
  .search-hint-keys span {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .search-hint-keys kbd {
    font-size: 10px;
    font-family: system-ui, sans-serif;
    font-weight: 600;
    padding: 2px 6px;
    background: hsl(var(--bc) / 0.05);
    border: 1px solid hsl(var(--bc) / 0.08);
    border-radius: 4px;
    color: hsl(var(--bc) / 0.4);
  }

  /* Loading & no results */
  .search-loading,
  .search-empty {
    padding: 40px 24px;
    text-align: center;
    font-size: 14px;
    color: hsl(var(--bc) / 0.4);
  }

  /* Results list */
  .search-list {
    padding: 8px;
  }
  .search-item {
    display: block;
    padding: 12px 16px;
    border-radius: 10px;
    text-decoration: none;
    margin-bottom: 4px;
    transition: background 0.12s ease;
    cursor: pointer;
  }
  .search-item:last-child {
    margin-bottom: 0;
  }
  .search-item:hover,
  .search-item.selected {
    background: hsl(var(--a) / 0.08);
  }
  .search-item-title {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--bc));
    margin-bottom: 4px;
    line-height: 1.3;
  }
  .search-item:hover .search-item-title,
  .search-item.selected .search-item-title {
    color: hsl(var(--a));
  }
  .search-item-snippet {
    display: block;
    font-size: 12px;
    color: hsl(var(--bc) / 0.55);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-item-snippet :global(mark) {
    background: hsl(var(--wa) / 0.25);
    color: inherit;
    padding: 0 2px;
    border-radius: 2px;
  }
  .search-item-url {
    display: block;
    font-size: 11px;
    color: hsl(var(--bc) / 0.3);
    font-family: ui-monospace, monospace;
    margin-top: 4px;
  }
</style>

<script>
  let pagefind: any = null;
  let results: any[] = [];
  let selected = 0;

  function init() {
    const overlay = document.getElementById('search-overlay');
    const dialog = document.getElementById('search-dialog');
    const input = document.getElementById('search-input') as HTMLInputElement;
    const resultsEl = document.getElementById('search-results');
    
    if (!overlay || !dialog || !input || !resultsEl) return;

    // Load pagefind
    (async () => {
      try {
        pagefind = await (new Function(`return import("/pagefind/pagefind.js")`))();
        await pagefind.init();
      } catch {}
    })();

    const showHint = () => {
      resultsEl.innerHTML = `
        <div class="search-hint">
          <span>Type to search documentation</span>
          <div class="search-hint-keys">
            <span><kbd>↑↓</kbd> navigate</span>
            <span><kbd>↵</kbd> open</span>
          </div>
        </div>
      `;
    };

    const open = () => {
      overlay.classList.add('is-open');
      dialog.classList.add('is-open');
      input.value = '';
      input.focus();
      showHint();
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      overlay.classList.remove('is-open');
      dialog.classList.remove('is-open');
      results = [];
      selected = 0;
      document.body.style.overflow = '';
    };

    const render = () => {
      if (!results.length) {
        resultsEl.innerHTML = `<div class="search-empty">No results found</div>`;
        return;
      }
      
      const query = encodeURIComponent(input.value.trim());
      resultsEl.innerHTML = `<div class="search-list">${results.map((r, i) => {
        const title = r.meta?.title || 'Untitled';
        const snippet = (r.excerpt || '').replace(/<[^>]+>/g, '').slice(0, 100);
        const url = r.url.replace(/\.html$/, '').replace(/\/index$/, '');
        return `
          <a href="${url}?highlight=${query}" class="search-item ${i === selected ? 'selected' : ''}" data-idx="${i}">
            <span class="search-item-title">${title}</span>
            ${snippet ? `<span class="search-item-snippet">${snippet}...</span>` : ''}
            <span class="search-item-url">${url}</span>
          </a>
        `;
      }).join('')}</div>`;
      
      resultsEl.querySelectorAll('.search-item').forEach(el => {
        el.addEventListener('click', close);
      });
    };

    // Search
    let debounce: any;
    input.addEventListener('input', () => {
      clearTimeout(debounce);
      const q = input.value.trim();
      if (!q || q.length < 2) { results = []; showHint(); return; }
      if (!pagefind) return;
      
      debounce = setTimeout(async () => {
        resultsEl.innerHTML = `<div class="search-loading">Searching...</div>`;
        try {
          const res = await pagefind.search(q);
          const data = await Promise.all(res.results.slice(0, 10).map((r: any) => r.data()));
          results = data.filter((r: any) => r.url.includes('/docs/')).slice(0, 6);
          selected = 0;
          render();
        } catch {
          resultsEl.innerHTML = `<div class="search-empty">Search error</div>`;
        }
      }, 100);
    });

    // Keyboard
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selected = Math.min(selected + 1, results.length - 1);
        render();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selected = Math.max(selected - 1, 0);
        render();
      } else if (e.key === 'Enter' && results[selected]) {
        e.preventDefault();
        const url = results[selected].url.replace(/\.html$/, '').replace(/\/index$/, '');
        window.location.href = `${url}?highlight=${encodeURIComponent(input.value.trim())}`;
        close();
      } else if (e.key === 'Escape') {
        close();
      }
    });

    overlay.addEventListener('click', close);

    // Global shortcuts
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); open(); }
      if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
        e.preventDefault();
        open();
      }
    });

    showHint();
  }

  // Highlight section on page load
  function highlightOnLoad() {
    const params = new URLSearchParams(window.location.search);
    const query = params.get('highlight');
    if (!query || query.length < 2) return;

    // Find article content only (skip header)
    const article = document.querySelector('[data-pagefind-body] article') || 
                    document.querySelector('[data-pagefind-body] .prose') ||
                    document.querySelector('article');
    if (!article) return;

    const searchTerm = query.toLowerCase();
    
    // Find all text nodes in article that contain the search term
    const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT);
    let matchNode: Node | null = null;
    
    while (walker.nextNode()) {
      const text = walker.currentNode.textContent?.toLowerCase() || '';
      if (text.includes(searchTerm)) {
        matchNode = walker.currentNode;
        break;
      }
    }

    if (!matchNode) return;

    // Find the closest heading BEFORE this match
    let current = matchNode.parentElement;
    let targetSection: HTMLElement | null = null;
    
    // Walk up and look for headings
    while (current && current !== article) {
      // Check if this element itself is a heading
      if (/^H[2-4]$/.test(current.tagName)) {
        targetSection = current;
        break;
      }
      
      // Look for a preceding sibling heading
      let sibling = current.previousElementSibling;
      while (sibling) {
        if (/^H[2-4]$/.test(sibling.tagName)) {
          targetSection = sibling as HTMLElement;
          break;
        }
        sibling = sibling.previousElementSibling;
      }
      if (targetSection) break;
      
      current = current.parentElement;
    }

    // If no heading found, use the match's parent paragraph/div
    if (!targetSection) {
      targetSection = matchNode.parentElement;
    }

    if (!targetSection) return;

    // Scroll to section
    setTimeout(() => {
      const rect = targetSection!.getBoundingClientRect();
      const scrollY = window.scrollY + rect.top - 120;
      window.scrollTo({ top: scrollY, behavior: 'smooth' });
    }, 150);

    // Pulse animation
    setTimeout(() => {
      targetSection!.classList.add('search-highlight-pulse');
    }, 500);

    setTimeout(() => {
      targetSection!.classList.remove('search-highlight-pulse');
    }, 2000);

    // Clean URL
    history.replaceState(null, '', window.location.pathname);
  }

  init();
  highlightOnLoad();
  
  document.addEventListener('astro:after-swap', () => {
    init();
    highlightOnLoad();
  });
</script>

<style is:global>
  .search-highlight-pulse {
    animation: searchPulse 1.5s ease-out;
    border-radius: 8px;
  }
  
  @keyframes searchPulse {
    0% {
      background-color: hsl(var(--a) / 0.25);
      box-shadow: 0 0 0 4px hsl(var(--a) / 0.2);
    }
    100% {
      background-color: transparent;
      box-shadow: 0 0 0 0 transparent;
    }
  }
</style>
