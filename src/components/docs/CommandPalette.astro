---
/**
 * Command Palette Component
 * 
 * Premium keyboard-activated search overlay (⌘K / Ctrl+K).
 * Clean, minimal design inspired by Spotlight/Raycast.
 */
import { useTranslations } from '../../utils/i18n';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'ru');
---

<!-- Backdrop -->
<div id="search-backdrop" class="search-backdrop"></div>

<!-- Search Modal -->
<div id="search-modal" class="search-modal" role="dialog" aria-modal="true">
  <!-- Search Input -->
  <div class="search-header">
    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/>
      <path d="m21 21-4.35-4.35"/>
    </svg>
    <input 
      type="text" 
      id="search-input"
      class="search-field" 
      placeholder={t('docs.searchPlaceholder') || 'Search docs...'}
      autocomplete="off"
      spellcheck="false"
    />
    <div class="search-hint">
      <kbd>esc</kbd>
    </div>
  </div>
  
  <!-- Results -->
  <div id="search-body" class="search-body">
    <div class="search-empty">
      <span class="search-empty-hint">Start typing to search</span>
      <div class="search-shortcuts">
        <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
        <span><kbd>↵</kbd> to select</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Backdrop */
  .search-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
  }
  .search-backdrop.active {
    opacity: 1;
    visibility: visible;
  }

  /* Modal */
  .search-modal {
    position: fixed;
    top: 20%;
    left: 50%;
    transform: translateX(-50%) scale(0.95);
    width: min(520px, calc(100vw - 40px));
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--bc) / 0.15);
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.15s ease;
    overflow: hidden;
  }
  .search-modal.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) scale(1);
  }

  /* Header */
  .search-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid hsl(var(--bc) / 0.1);
  }
  .search-icon {
    width: 18px;
    height: 18px;
    color: hsl(var(--bc) / 0.4);
    flex-shrink: 0;
  }
  .search-field {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-size: 15px;
    color: hsl(var(--bc));
  }
  .search-field::placeholder {
    color: hsl(var(--bc) / 0.4);
  }
  .search-hint kbd {
    font-size: 11px;
    font-family: system-ui, sans-serif;
    padding: 3px 8px;
    background: hsl(var(--bc) / 0.08);
    border-radius: 4px;
    color: hsl(var(--bc) / 0.5);
    text-transform: uppercase;
    font-weight: 500;
  }

  /* Body */
  .search-body {
    max-height: 320px;
    overflow-y: auto;
  }

  /* Empty State */
  .search-empty {
    padding: 32px 20px;
    text-align: center;
  }
  .search-empty-hint {
    display: block;
    font-size: 13px;
    color: hsl(var(--bc) / 0.4);
    margin-bottom: 16px;
  }
  .search-shortcuts {
    display: flex;
    justify-content: center;
    gap: 20px;
    font-size: 12px;
    color: hsl(var(--bc) / 0.35);
  }
  .search-shortcuts span {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .search-shortcuts kbd {
    font-size: 10px;
    padding: 2px 5px;
    background: hsl(var(--bc) / 0.06);
    border-radius: 3px;
    font-family: system-ui;
  }

  /* Loading */
  .search-loading {
    padding: 32px;
    text-align: center;
    font-size: 13px;
    color: hsl(var(--bc) / 0.4);
  }

  /* No Results */
  .search-no-results {
    padding: 32px 20px;
    text-align: center;
    font-size: 13px;
    color: hsl(var(--bc) / 0.4);
  }

  /* Results */
  .search-results {
    padding: 6px;
  }
  .search-result {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    margin-bottom: 2px;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.1s ease;
  }
  .search-result:hover,
  .search-result[data-selected="true"] {
    background: hsl(var(--a) / 0.1);
  }
  .search-result-title {
    font-size: 13px;
    font-weight: 600;
    color: hsl(var(--bc));
    line-height: 1.3;
  }
  .search-result:hover .search-result-title,
  .search-result[data-selected="true"] .search-result-title {
    color: hsl(var(--a));
  }
  .search-result-snippet {
    font-size: 12px;
    color: hsl(var(--bc) / 0.5);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-result-snippet :global(mark) {
    background: hsl(var(--wa) / 0.3);
    color: inherit;
    padding: 0 2px;
    border-radius: 2px;
  }
  .search-result-path {
    font-size: 10px;
    color: hsl(var(--bc) / 0.3);
    font-family: ui-monospace, monospace;
    margin-top: 2px;
  }
</style>

<script>
  let pagefind: any = null;
  let results: any[] = [];
  let selectedIndex = 0;

  function init() {
    const backdrop = document.getElementById('search-backdrop');
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    const body = document.getElementById('search-body');

    if (!backdrop || !modal || !input || !body) return;

    // Load Pagefind
    (async () => {
      try {
        pagefind = await (new Function(`return import("/pagefind/pagefind.js")`))();
        await pagefind.init();
      } catch (e) {
        console.warn('Pagefind not available');
      }
    })();

    const showEmpty = () => {
      body.innerHTML = `
        <div class="search-empty">
          <span class="search-empty-hint">Start typing to search</span>
          <div class="search-shortcuts">
            <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
            <span><kbd>↵</kbd> to select</span>
          </div>
        </div>
      `;
    };

    const open = () => {
      backdrop.classList.add('active');
      modal.classList.add('active');
      input.value = '';
      input.focus();
      showEmpty();
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      backdrop.classList.remove('active');
      modal.classList.remove('active');
      results = [];
      selectedIndex = 0;
      document.body.style.overflow = '';
    };

    const render = () => {
      if (results.length === 0) {
        body.innerHTML = `<div class="search-no-results">No results found</div>`;
        return;
      }

      body.innerHTML = `<div class="search-results">${results.map((r, i) => {
        const title = r.meta?.title || 'Untitled';
        const snippet = r.excerpt || '';
        const path = r.url.replace(/\.html$/, '').replace(/\/index$/, '');
        return `
          <a href="${path}#search-target" 
             class="search-result" 
             data-selected="${i === selectedIndex}"
             data-index="${i}">
            <span class="search-result-title">${title}</span>
            ${snippet ? `<span class="search-result-snippet">${snippet}</span>` : ''}
            <span class="search-result-path">${path}</span>
          </a>
        `;
      }).join('')}</div>`;

      body.querySelectorAll('.search-result').forEach(el => {
        el.addEventListener('click', (e) => {
          close();
        });
      });
    };

    // Search
    let timeout: any;
    input.addEventListener('input', () => {
      clearTimeout(timeout);
      const q = input.value.trim();
      
      if (!q || q.length < 2) {
        results = [];
        showEmpty();
        return;
      }

      if (!pagefind) return;

      timeout = setTimeout(async () => {
        body.innerHTML = `<div class="search-loading">Searching...</div>`;
        
        try {
          const search = await pagefind.search(q);
          const data = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
          results = data.filter((r: any) => r.url.includes('/docs/')).slice(0, 5);
          selectedIndex = 0;
          render();
        } catch (e) {
          body.innerHTML = `<div class="search-no-results">Search error</div>`;
        }
      }, 80);
    });

    // Keyboard
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, results.length - 1);
        render();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        render();
      } else if (e.key === 'Enter' && results[selectedIndex]) {
        e.preventDefault();
        const url = results[selectedIndex].url.replace(/\.html$/, '').replace(/\/index$/, '');
        window.location.href = `${url}#search-target`;
        close();
      } else if (e.key === 'Escape') {
        close();
      }
    });

    backdrop.addEventListener('click', close);

    // Global shortcuts
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        open();
      }
      if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
        e.preventDefault();
        open();
      }
    });

    showEmpty();
  }

  // Section highlight on navigation
  function highlightSection() {
    if (window.location.hash !== '#search-target') return;
    
    // Find the main content area
    const content = document.querySelector('[data-pagefind-body]');
    if (!content) return;
    
    // Pulse the article header (title area) as visual feedback
    const header = content.querySelector('header');
    if (header) {
      header.classList.add('search-section-pulse');
      
      // Scroll to top of content
      setTimeout(() => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }, 50);
      
      // Remove after animation
      setTimeout(() => {
        header.classList.remove('search-section-pulse');
      }, 1200);
    }
    
    // Clean URL
    history.replaceState(null, '', window.location.pathname);
  }

  init();
  highlightSection();
  
  document.addEventListener('astro:after-swap', () => {
    init();
    highlightSection();
  });
</script>

<style is:global>
  /* Section pulse animation */
  .search-section-pulse {
    animation: sectionPulse 1s ease-out;
    border-radius: 12px;
  }
  
  @keyframes sectionPulse {
    0% {
      background: hsl(var(--a) / 0.15);
      box-shadow: 0 0 0 4px hsl(var(--a) / 0.2);
    }
    100% {
      background: transparent;
      box-shadow: 0 0 0 0 hsl(var(--a) / 0);
    }
  }
</style>
