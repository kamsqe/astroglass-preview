---
/**
 * Command Palette Component
 * 
 * Premium keyboard-activated search overlay (⌘K / Ctrl+K).
 * Scoped to documentation content only via Pagefind filtering.
 * Theme-aware styling for all color modes.
 */
import { useTranslations } from '../../utils/i18n';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'ru');
---

<!-- Backdrop -->
<div id="command-palette-backdrop" class="command-palette-backdrop"></div>

<!-- Palette -->
<div id="command-palette" class="command-palette" role="dialog" aria-label="Search documentation">
  <div class="command-palette-header">
    <div class="command-palette-input-wrapper">
      <svg class="command-palette-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        type="text" 
        id="command-palette-input"
        class="command-palette-input" 
        placeholder={t('docs.searchPlaceholder') || 'Search documentation...'}
        autocomplete="off"
        aria-label="Search"
      />
      <kbd class="command-palette-shortcut">ESC</kbd>
    </div>
  </div>
  
  <div id="command-palette-results" class="command-palette-results">
    <div class="command-palette-empty">
      <div class="command-palette-empty-icon">🔍</div>
      <p class="command-palette-empty-text">{t('docs.typeToSearch') || 'Type to search the docs'}</p>
      <div class="command-palette-hints">
        <div class="hint"><kbd>⌘K</kbd> open</div>
        <div class="hint"><kbd>↑↓</kbd> navigate</div>
        <div class="hint"><kbd>↵</kbd> go</div>
      </div>
    </div>
  </div>
</div>

<style>
  .command-palette-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .command-palette-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .command-palette {
    position: fixed;
    top: 10%;
    left: 50%;
    transform: translateX(-50%) translateY(-20px) scale(0.95);
    width: calc(100% - 24px);
    max-width: 600px;
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--bc) / 0.15);
    border-radius: 16px;
    box-shadow: 
      0 25px 50px -12px rgba(0, 0, 0, 0.4),
      0 0 0 1px hsl(var(--a) / 0.05);
    z-index: 9999;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  }

  @media (min-width: 640px) {
    .command-palette {
      top: 15%;
      width: calc(100% - 32px);
      border-radius: 20px;
    }
  }

  .command-palette.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .command-palette-header {
    border-bottom: 1px solid hsl(var(--bc) / 0.1);
    background: hsl(var(--bc) / 0.02);
  }

  .command-palette-input-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
  }

  @media (min-width: 640px) {
    .command-palette-input-wrapper {
      padding: 16px 20px;
      gap: 14px;
    }
  }

  .command-palette-icon {
    width: 20px;
    height: 20px;
    color: hsl(var(--a));
    opacity: 0.6;
    flex-shrink: 0;
  }

  .command-palette-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 1rem;
    font-weight: 500;
    outline: none;
    color: hsl(var(--bc));
  }

  @media (min-width: 640px) {
    .command-palette-input {
      font-size: 1.125rem;
    }
  }

  .command-palette-input::placeholder {
    color: hsl(var(--bc) / 0.4);
  }

  .command-palette-shortcut {
    font-size: 0.65rem;
    padding: 4px 8px;
    background: hsl(var(--bc) / 0.08);
    border: 1px solid hsl(var(--bc) / 0.1);
    border-radius: 6px;
    font-family: ui-monospace, monospace;
    font-weight: 600;
    color: hsl(var(--bc) / 0.5);
  }

  .command-palette-results {
    max-height: 60vh;
    overflow-y: auto;
    padding: 8px;
  }

  @media (min-width: 640px) {
    .command-palette-results {
      max-height: 420px;
      padding: 12px;
    }
  }

  .command-palette-empty {
    padding: 40px 20px;
    text-align: center;
  }

  .command-palette-empty-icon {
    font-size: 2rem;
    margin-bottom: 12px;
    opacity: 0.6;
  }

  .command-palette-empty-text {
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 20px;
    color: hsl(var(--bc) / 0.5);
  }

  .command-palette-hints {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 0.75rem;
  }

  .hint {
    display: flex;
    align-items: center;
    gap: 5px;
    color: hsl(var(--bc) / 0.4);
  }

  .hint kbd {
    font-size: 0.65rem;
    padding: 2px 6px;
    background: hsl(var(--bc) / 0.08);
    border: 1px solid hsl(var(--bc) / 0.1);
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-weight: 600;
  }

  .command-palette-item {
    display: block;
    padding: 12px 14px;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    border: 1px solid transparent;
    margin-bottom: 4px;
    background: transparent;
  }

  .command-palette-item:hover,
  .command-palette-item.is-selected {
    background: hsl(var(--a) / 0.08);
    border-color: hsl(var(--a) / 0.15);
  }

  .command-palette-item.is-selected {
    background: hsl(var(--a) / 0.12);
  }

  .command-palette-item-title {
    display: block;
    font-weight: 700;
    font-size: 0.9rem;
    color: hsl(var(--bc));
    margin-bottom: 4px;
  }

  .command-palette-item.is-selected .command-palette-item-title,
  .command-palette-item:hover .command-palette-item-title {
    color: hsl(var(--a));
  }

  .command-palette-item-excerpt {
    display: block;
    font-size: 0.8rem;
    color: hsl(var(--bc) / 0.6);
    line-height: 1.5;
    margin-bottom: 6px;
  }

  .command-palette-item-excerpt mark {
    background: hsl(var(--a) / 0.2);
    color: hsl(var(--a));
    padding: 0.1em 0.2em;
    border-radius: 3px;
    font-weight: 600;
  }

  .command-palette-item-path {
    display: block;
    font-size: 0.7rem;
    color: hsl(var(--bc) / 0.35);
    font-family: ui-monospace, monospace;
  }

  .command-palette-loading {
    padding: 40px;
    text-align: center;
    color: hsl(var(--bc) / 0.5);
    font-weight: 500;
    font-size: 0.9rem;
  }

  .command-palette-no-results {
    padding: 40px 20px;
    text-align: center;
    color: hsl(var(--bc) / 0.5);
  }

  .command-palette-no-results-icon {
    font-size: 2rem;
    margin-bottom: 12px;
    opacity: 0.6;
  }

  .command-palette-no-results-text {
    font-size: 0.9rem;
    font-weight: 500;
  }
</style>

<script>
  let pagefind: any = null;
  let selectedIndex = 0;
  let results: any[] = [];

  async function initCommandPalette() {
    const backdrop = document.getElementById('command-palette-backdrop');
    const palette = document.getElementById('command-palette');
    const input = document.getElementById('command-palette-input') as HTMLInputElement;
    const resultsContainer = document.getElementById('command-palette-results');

    if (!backdrop || !palette || !input || !resultsContainer) return;

    // Load Pagefind dynamically at runtime
    try {
      const pagefindUrl = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ pagefindUrl);
      await pagefind.init();
    } catch (e) {
      console.warn('Pagefind not available, search disabled');
    }

    function openPalette() {
      backdrop.classList.add('is-open');
      palette.classList.add('is-open');
      input.focus();
      document.body.style.overflow = 'hidden';
    }

    function closePalette() {
      backdrop.classList.remove('is-open');
      palette.classList.remove('is-open');
      input.value = '';
      selectedIndex = 0;
      results = [];
      document.body.style.overflow = '';
      renderEmpty();
    }

    function renderEmpty() {
      resultsContainer.innerHTML = `
        <div class="command-palette-empty">
          <div class="command-palette-empty-icon">🔍</div>
          <p class="command-palette-empty-text">Type to search the docs</p>
          <div class="command-palette-hints">
            <div class="hint"><kbd>⌘K</kbd> open</div>
            <div class="hint"><kbd>↑↓</kbd> navigate</div>
            <div class="hint"><kbd>↵</kbd> go</div>
          </div>
        </div>
      `;
    }

    function renderResults(items: any[]) {
      if (items.length === 0) {
        renderEmpty();
        return;
      }

      resultsContainer.innerHTML = items.map((item, i) => {
        // Clean up the URL path for display
        const displayPath = item.url
          .replace(/\/index\.html$/, '/')
          .replace(/\.html$/, '');
        
        // Format the title nicely
        const title = item.meta?.title || item.url.split('/').filter(Boolean).pop() || 'Untitled';
        
        return `
          <a 
            href="${item.url}${window.location.search ? '?highlight=' + encodeURIComponent(input.value) : ''}" 
            class="command-palette-item ${i === selectedIndex ? 'is-selected' : ''}"
            data-index="${i}"
          >
            <span class="command-palette-item-title">${title}</span>
            ${item.excerpt ? `<span class="command-palette-item-excerpt">${item.excerpt}</span>` : ''}
            <span class="command-palette-item-path">${displayPath}</span>
          </a>
        `;
      }).join('');

      // Click handlers
      resultsContainer.querySelectorAll('.command-palette-item').forEach((el) => {
        el.addEventListener('click', () => closePalette());
      });
    }

    // Search handler with docs-only filtering
    let searchTimeout: ReturnType<typeof setTimeout>;
    input.addEventListener('input', async () => {
      clearTimeout(searchTimeout);
      const query = input.value.trim();

      if (!query) {
        results = [];
        renderEmpty();
        return;
      }

      if (!pagefind) return;

      searchTimeout = setTimeout(async () => {
        resultsContainer.innerHTML = '<div class="command-palette-loading">Searching...</div>';
        
        try {
          const search = await pagefind.search(query);
          
          // Filter results to only include docs pages
          const allResults = await Promise.all(
            search.results.slice(0, 15).map((r: any) => r.data())
          );
          
          // Filter to docs-only (pages with /docs/ in URL)
          results = allResults.filter((r: any) => 
            r.url.includes('/docs/')
          ).slice(0, 8);
          
          selectedIndex = 0;
          
          if (results.length === 0) {
            resultsContainer.innerHTML = `
              <div class="command-palette-no-results">
                <div class="command-palette-no-results-icon">😕</div>
                <p class="command-palette-no-results-text">No results found in docs</p>
              </div>
            `;
          } else {
            renderResults(results);
          }
        } catch (e) {
          resultsContainer.innerHTML = `
            <div class="command-palette-no-results">
              <div class="command-palette-no-results-icon">⚠️</div>
              <p class="command-palette-no-results-text">Search error</p>
            </div>
          `;
        }
      }, 150);
    });

    // Keyboard navigation
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, results.length - 1);
        renderResults(results);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        renderResults(results);
      } else if (e.key === 'Enter' && results[selectedIndex]) {
        e.preventDefault();
        const url = results[selectedIndex].url;
        window.location.href = url + '?highlight=' + encodeURIComponent(input.value);
        closePalette();
      } else if (e.key === 'Escape') {
        closePalette();
      }
    });

    // Close on backdrop click
    backdrop.addEventListener('click', closePalette);

    // Global keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      // ⌘K or Ctrl+K
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openPalette();
      }
      // / key when not in input
      if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        openPalette();
      }
    });
  }

  // Highlight search terms on page load with animation
  function highlightSearchTerms() {
    const urlParams = new URLSearchParams(window.location.search);
    const highlight = urlParams.get('highlight');
    
    if (highlight && highlight.length > 2) {
      const terms = highlight.toLowerCase().split(/\s+/).filter(t => t.length > 2);
      const mainContent = document.querySelector('[data-pagefind-body]');
      
      if (mainContent && terms.length > 0) {
        const walker = document.createTreeWalker(mainContent, NodeFilter.SHOW_TEXT);
        const textNodes: Text[] = [];
        
        while (walker.nextNode()) {
          const node = walker.currentNode as Text;
          if (node.textContent && terms.some(t => node.textContent!.toLowerCase().includes(t))) {
            textNodes.push(node);
          }
        }
        
        let firstHighlight: Element | null = null;
        
        textNodes.forEach(node => {
          let html = node.textContent || '';
          let hasMatch = false;
          
          terms.forEach(term => {
            const regex = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
            if (regex.test(html)) {
              hasMatch = true;
              html = html.replace(regex, '<mark class="search-highlight-pulse">$1</mark>');
            }
          });
          
          if (hasMatch) {
            const span = document.createElement('span');
            span.innerHTML = html;
            node.parentNode?.replaceChild(span, node);
            
            if (!firstHighlight) {
              firstHighlight = span.querySelector('mark');
            }
          }
        });
        
        // Smooth scroll to first highlight with offset
        if (firstHighlight) {
          setTimeout(() => {
            const rect = firstHighlight!.getBoundingClientRect();
            const scrollTop = window.pageYOffset + rect.top - (window.innerHeight / 3);
            
            window.scrollTo({
              top: scrollTop,
              behavior: 'smooth'
            });
          }, 200);
          
          // Remove pulse animation after it completes
          setTimeout(() => {
            document.querySelectorAll('.search-highlight-pulse').forEach(el => {
              el.classList.remove('search-highlight-pulse');
              el.classList.add('search-highlight');
            });
          }, 2500);
        }
        
        // Clean URL without reloading (remove ?highlight param)
        const cleanUrl = window.location.pathname + window.location.hash;
        window.history.replaceState({}, '', cleanUrl);
      }
    }
  }

  initCommandPalette();
  highlightSearchTerms();
  document.addEventListener('astro:after-swap', () => {
    initCommandPalette();
    highlightSearchTerms();
  });
</script>
