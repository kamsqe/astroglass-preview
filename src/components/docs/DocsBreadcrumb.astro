---
/**
 * Docs Breadcrumb Component
 * 
 * Display navigation breadcrumbs for documentation pages.
 * Helps users understand their location in the docs hierarchy.
 */

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="docs-breadcrumb" aria-label="Breadcrumb">
  <ol class="breadcrumb-list">
    {items.map((item, index) => (
      <li class="breadcrumb-item">
        {item.href ? (
          <a href={item.href} class="breadcrumb-link">
            {index === 0 ? (
              <span class="breadcrumb-home">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span class="sr-only">{item.label}</span>
              </span>
            ) : (
              item.label
            )}
          </a>
        ) : (
          <span class="breadcrumb-current" aria-current="page">{item.label}</span>
        )}
        {index < items.length - 1 && (
          <svg class="breadcrumb-separator" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .docs-breadcrumb {
    margin-bottom: 1.5rem;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .breadcrumb-link {
    color: rgba(var(--color-base-content-rgb, 0 0 0), 0.5);
    text-decoration: none;
    transition: color 0.2s;
    padding: 4px;
    border-radius: 4px;
  }

  .breadcrumb-link:hover {
    color: var(--color-accent, #3b82f6);
    background: rgba(var(--color-accent-rgb, 59 130 246), 0.05);
  }

  .breadcrumb-home {
    display: flex;
    align-items: center;
  }

  .breadcrumb-separator {
    width: 1rem;
    height: 1rem;
    opacity: 0.3;
    flex-shrink: 0;
  }

  .breadcrumb-current {
    color: rgba(var(--color-base-content-rgb, 0 0 0), 0.8);
    font-weight: 500;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .breadcrumb-list {
      font-size: 0.8rem;
    }
    
    /* Hide middle items on very small screens */
    .breadcrumb-item:not(:first-child):not(:last-child) {
      display: none;
    }
    
    /* Show ellipsis */
    .breadcrumb-item:first-child:not(:last-child)::after {
      content: '...';
      margin: 0 0.25rem;
      opacity: 0.3;
    }
  }
</style>
