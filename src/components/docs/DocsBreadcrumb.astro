---
/**
 * Docs Breadcrumb Component
 * 
 * Display navigation breadcrumbs for documentation pages.
 * Helps users understand their location in the docs hierarchy.
 */

import '../../styles/components/docs/DocsBreadcrumb.css';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="c-docs-breadcrumb" aria-label="Breadcrumb">
  <ol class="c-docs-breadcrumb__list">
    {items.map((item, index) => (
      <li class="c-docs-breadcrumb__item">
        {item.href ? (
          <a href={item.href} class="c-docs-breadcrumb__link">
            {index === 0 ? (
              <span class="c-docs-breadcrumb__home">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span class="sr-only">{item.label}</span>
              </span>
            ) : (
              item.label
            )}
          </a>
        ) : (
          <span class="c-docs-breadcrumb__current" aria-current="page">{item.label}</span>
        )}
        {index < items.length - 1 && (
          <svg class="c-docs-breadcrumb__separator" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
      </li>
    ))}
  </ol>
</nav>
