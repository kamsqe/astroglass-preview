---
/**
 * Docs Search Trigger
 * Simple button that opens the CommandPalette.
 * The actual search is handled by CommandPalette.
 */
import { useTranslations } from '../../utils/i18n';

interface Props {
  locale: 'en' | 'ru';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button
  type="button"
  id="docs-search-trigger"
  class="flex items-center gap-2 px-3 py-2 rounded-xl bg-base-content/[0.03] border border-base-content/10 text-base-content/40 text-sm hover:border-accent/30 hover:text-accent transition-all duration-300 w-full"
  aria-label="Search documentation"
>
  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
  </svg>
  <span class="flex-1 text-left">{t('docs.searchDocs') || 'Search docs...'}</span>
  <kbd class="hidden sm:inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-base-content/5 text-[10px] font-mono">⌘K</kbd>
</button>

<script is:inline>
  (function() {
    function init() {
      const trigger = document.getElementById('docs-search-trigger');
      const backdrop = document.getElementById('command-palette-backdrop');
      const palette = document.getElementById('command-palette');
      const input = document.getElementById('command-palette-input');
      
      if (!trigger || !palette) return;

      trigger.addEventListener('click', () => {
        if (backdrop) backdrop.classList.add('is-open');
        palette.classList.add('is-open');
        if (input) input.focus();
        document.body.style.overflow = 'hidden';
      });
    }

    init();
    document.addEventListener('astro:after-swap', init);
  })();
</script>
