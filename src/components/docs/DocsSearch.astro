---
/**
 * Docs Search Trigger
 * Button that opens the Command Palette search dialog
 */
import { useTranslations } from '../../utils/i18n';

interface Props {
  locale: 'en' | 'ru';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button
  type="button"
  id="docs-search-trigger"
  class="search-trigger group"
  aria-label="Search documentation"
>
  <svg class="search-trigger-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
  </svg>
  <span class="search-trigger-text">{t('docs.searchDocs') || 'Search...'}</span>
  <kbd class="search-trigger-kbd">⌘K</kbd>
</button>

<style>
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    border-radius: 10px;
    background: hsl(var(--bc) / 0.03);
    border: 1px solid hsl(var(--bc) / 0.08);
    color: hsl(var(--bc));
    cursor: pointer;
    transition: all 0.15s ease;
  }
  
  .search-trigger:hover {
    background: hsl(var(--bc) / 0.05);
    border-color: hsl(var(--a) / 0.2);
  }
  
  .search-trigger:focus-visible {
    outline: none;
    border-color: hsl(var(--a) / 0.5);
    box-shadow: 0 0 0 3px hsl(var(--a) / 0.1);
  }

  .search-trigger-icon {
    width: 16px;
    height: 16px;
    opacity: 0.4;
    flex-shrink: 0;
    transition: opacity 0.15s;
  }

  .search-trigger:hover .search-trigger-icon {
    opacity: 0.6;
  }

  .search-trigger-text {
    flex: 1;
    text-align: left;
    font-size: 13px;
    opacity: 0.5;
    transition: opacity 0.15s;
  }

  .search-trigger:hover .search-trigger-text {
    opacity: 0.7;
  }

  .search-trigger-kbd {
    font-size: 10px;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 6px;
    background: hsl(var(--bc) / 0.05);
    border: 1px solid hsl(var(--bc) / 0.08);
    color: hsl(var(--bc) / 0.45);
    opacity: 0.8;
    transition: opacity 0.15s;
  }

  .search-trigger:hover .search-trigger-kbd {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .search-trigger-kbd {
      display: none;
    }
  }
</style>

<script is:inline>
  (function() {
    function init() {
      var trigger = document.getElementById('docs-search-trigger');
      var overlay = document.getElementById('search-overlay');
      var dialog = document.getElementById('search-dialog');
      var input = document.getElementById('search-input');
      
      if (!trigger || !dialog) return;

      trigger.addEventListener('click', function() {
        if (overlay) overlay.classList.add('is-open');
        dialog.classList.add('is-open');
        if (input) input.focus();
        document.body.style.overflow = 'hidden';
      });
    }

    init();
    document.addEventListener('astro:after-swap', init);
  })();
</script>
