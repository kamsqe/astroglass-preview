---
/**
 * Docs Search Component
 * Loads Pagefind at runtime for static docs search.
 */
import { useTranslations } from '../../utils/i18n';

interface Props {
  locale: 'en' | 'ru';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button
  type="button"
  id="docs-search-trigger"
  class="flex items-center gap-2 px-3 py-2 rounded-xl bg-base-content/[0.03] border border-base-content/10 text-base-content/40 text-sm hover:border-accent/30 hover:text-accent transition-all duration-300 w-full"
>
  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
  </svg>
  <span class="flex-1 text-left">{t('docs.searchDocs') || 'Search...'}</span>
  <kbd class="hidden sm:inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-base-content/5 text-[10px] font-mono">⌘K</kbd>
</button>

<div id="docs-search-modal" class="fixed inset-0 z-[100] hidden items-start justify-center pt-[15vh] px-4 bg-black/50 backdrop-blur-sm">
  <div class="w-full max-w-2xl bg-base-100 rounded-2xl shadow-2xl border border-base-content/10 overflow-hidden">
    <div class="p-4 border-b border-base-content/10 flex gap-3">
      <svg class="w-5 h-5 text-base-content/30 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input
        type="text"
        id="docs-search-input"
        placeholder="Search documentation..."
        class="flex-1 bg-transparent text-lg focus:outline-none"
        autocomplete="off"
      />
    </div>
    <div id="docs-search-results" class="max-h-[60vh] overflow-y-auto p-2"></div>
  </div>
</div>

<script is:inline>
  (function() {
    let pagefind = null;

    async function loadPagefind() {
      if (pagefind) return pagefind;
      try {
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
        return pagefind;
      } catch (e) {
        console.warn('Pagefind not found (dev mode?)');
        return null;
      }
    }

    function init() {
      const trigger = document.getElementById('docs-search-trigger');
      const modal = document.getElementById('docs-search-modal');
      const input = document.getElementById('docs-search-input');
      const results = document.getElementById('docs-search-results');

      if (!trigger || !modal) return;

      const open = () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        input.focus();
        loadPagefind();
      };

      const close = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      trigger.addEventListener('click', open);
      modal.addEventListener('click', e => { if(e.target === modal) close(); });
      window.addEventListener('keydown', e => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); open(); }
        if (e.key === 'Escape') close();
      });

      input.addEventListener('input', async e => {
        const pf = await loadPagefind();
        if (!pf) return;
        const search = await pf.search(e.target.value);
        const data = await Promise.all(search.results.slice(0, 5).map(r => r.data()));
        
        results.innerHTML = data.map(r => `
          <a href="${r.url}" class="block p-3 rounded-lg hover:bg-base-content/5 transition-colors group">
            <div class="font-bold text-sm mb-1 group-hover:text-accent">${r.meta.title}</div>
            <div class="text-xs text-base-content/60 truncate">${r.excerpt}</div>
          </a>
        `).join('');
      });
    }

    init();
    document.addEventListener('astro:after-swap', init);
  })();
</script>
