---
/**
 * Hero V3 - Minimalist Editorial (Refined)
 * Elegant, large typography with heavy focus on white space.
 * Better mobile scaling and CTA visibility.
 */
import { getLocaleFromUrl, useTranslations } from '../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const words = t('hero.title').split(' ');
---

<section class="relative min-h-screen flex items-center justify-center text-center px-4 pt-[calc(100px+var(--nav-offset))] pb-24 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
     <!-- Massive Background Glow -->
     <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] md:w-[900px] h-[600px] md:h-[900px] bg-[hsl(var(--glow-color))] opacity-[var(--glow-intensity,0.08)] blur-[200px] rounded-full animate-pulse-slow"></div>
  </div>

  <div class="relative z-10 w-full max-w-5xl">
    <!-- Badge -->
    <div class="animate-fade-in opacity-0" style="animation-fill-mode: forwards;">
      <span class="visionary-badge inline-flex items-center gap-4 text-accent font-bold text-[10px] sm:text-[11px] tracking-[0.4em] sm:tracking-[0.5em] uppercase mb-8 md:mb-12">
        <span class="w-6 sm:w-8 h-px bg-accent/30"></span>
        {t('hero.visionary')}
        <span class="w-6 sm:w-8 h-px bg-accent/30"></span>
      </span>
    </div>

    <!-- Headline with responsive scaling -->
    <h1 class="text-4xl sm:text-6xl md:text-8xl xl:text-[10rem] font-extralight tracking-tight text-base-content mb-10 md:mb-16 animate-reveal leading-[1.1] md:leading-none">
      {words.map((word, i) => (
        <span 
          class={`title-word inline-block ${i === 1 ? 'font-black italic text-accent' : ''}`}
          style={`animation-delay: ${i * 0.1}s`}
        >{word}&nbsp;</span>
      ))}
    </h1>

    <!-- Decorative line -->
    <div class="w-24 md:w-32 h-px bg-gradient-to-r from-transparent via-accent to-transparent mx-auto mb-10 md:mb-16 animate-width-grow"></div>

    <!-- Subtitle - direct statement, no quotes -->
    <p class="hero-subtitle text-lg sm:text-xl md:text-2xl text-base-content/40 max-w-xl md:max-w-2xl mx-auto mb-12 md:mb-20 font-light leading-relaxed animate-fade-in opacity-0" style="animation-delay: 0.5s; animation-fill-mode: forwards;">
      {t('hero.subtitle')}
    </p>

    <!-- CTA with better visibility -->
    <div class="flex flex-col items-center gap-8 md:gap-12 animate-fade-in opacity-0" style="animation-delay: 0.8s; animation-fill-mode: forwards;">
        <a href="#explore" class="btn-minimal group relative py-4 md:py-5 px-10 md:px-14 border border-base-content/10 bg-base-content/[0.02] hover:bg-accent/10 hover:border-accent/30 rounded-full backdrop-blur-sm transition-all duration-700">
            <span class="btn-text text-sm font-black tracking-[0.3em] md:tracking-[0.4em] uppercase text-base-content group-hover:text-accent transition-colors duration-500 flex items-center gap-3">
              {t('hero.cta')}
              <svg class="w-4 h-4 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
        </a>
        
        <!-- Scroll indicator -->
        <div class="flex flex-col items-center gap-3 text-base-content/30">
          <span class="text-[10px] uppercase tracking-widest">{t('hero.scrollToExplore')}</span>
          <svg class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
        </div>
    </div>
  </div>

  <!-- Simplified particles (2 on mobile, 4 on desktop) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="particle p1"></div>
    <div class="particle p2"></div>
    <div class="particle p3 hidden md:block"></div>
    <div class="particle p4 hidden md:block"></div>
  </div>
</section>

<style>
  .visionary-badge, .title-word, .hero-subtitle, .btn-minimal, .btn-text {
    transition: all 1200ms cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateZ(0);
  }

  .title-word {
    opacity: 0;
    animation: word-reveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes word-reveal {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .title-word:hover {
    transform: scale(1.05);
  }

  .hero-subtitle:hover {
    color: hsl(var(--bc) / 0.6);
  }

  .btn-minimal:hover {
    transform: scale(1.05);
    box-shadow: 0 15px 30px -10px rgba(0,0,0,0.15);
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes reveal {
    from { opacity: 0; transform: translateY(30px) scale(0.98); filter: blur(10px); }
    to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }

  @keyframes width-grow {
    from { width: 0; opacity: 0; }
    to { width: 128px; opacity: 1; }
  }

  @keyframes drift {
    0% { transform: translate(0, 0) rotate(0deg); }
    100% { transform: translate(100px, -100px) rotate(30deg); }
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.08; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 0.12; transform: translate(-50%, -50%) scale(1.1); }
  }

  .animate-fade-in {
    animation: fade-in 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-reveal {
    animation: reveal 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-width-grow {
    animation: width-grow 2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  .animate-pulse-slow {
    animation: pulse-slow 10s ease-in-out infinite;
  }

  .particle {
    position: absolute;
    background: radial-gradient(circle, hsl(var(--a) / 0.1) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(40px);
    animation: drift 20s infinite alternate ease-in-out;
    will-change: transform;
  }

  .p1 { width: 300px; height: 300px; top: -5%; left: -5%; animation-delay: 0s; }
  .p2 { width: 350px; height: 350px; bottom: -5%; right: -5%; animation-delay: -5s; }
  .p3 { width: 250px; height: 250px; top: 40%; right: 10%; animation-delay: -10s; }
  .p4 { width: 280px; height: 280px; bottom: 20%; left: 10%; animation-delay: -15s; }
</style>
