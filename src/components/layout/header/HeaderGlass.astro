---
/**
 * Header V2 - Clean Minimal Header
 */
import { getLocaleFromUrl, useTranslations } from '../../../utils/i18n';
import { buildNavLinks } from '../../../config/navigation';
import LanguageSwitcher from '../../ui/LanguageSwitcher.astro';
import { Button } from '../../ui/button';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const navLinks = buildNavLinks(locale, t);
const homeHref = locale === 'en' ? '/' : `/${locale}/`;
---

<header class="header-v2">
  <div class="header-v2-container">
    <div class="header-v2-inner">
      <a href={homeHref} class="logo-v2">
        <span class="logo-v2-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
        </span>
        <span class="logo-v2-text">{t('siteName')}</span>
      </a>

      <nav class="nav-v2">
        {navLinks.map((link) => (
          link.children ? (
            <div class="dropdown-v2" data-dropdown-v2>
              <button 
                type="button"
                class="nav-v2-item h-auto font-normal hover:bg-transparent" 
                aria-expanded="false"
              >
                {link.label}
                <svg class="nav-v2-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="dropdown-v2-menu">
                {link.children.map((child) => (
                  <a href={child.href} class="dropdown-v2-item justify-start w-full h-auto font-normal px-4 py-2 hover:bg-accent/10">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={link.href} class="nav-v2-item h-auto font-normal hover:bg-transparent">
              {link.label}
            </a>
          )
        ))}
      </nav>

      <div class="header-v2-actions">
        <LanguageSwitcher />
      </div>

      <div class="header-v2-mobile-actions">
        <button type="button" class="hamburger-v2" id="hamburger-v2" aria-label={t('nav.openMenu')}>
          <span class="hamburger-v2-line"></span>
          <span class="hamburger-v2-line"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<div class="mobile-panel-v2" id="mobile-panel-v2">
  <div class="mobile-panel-v2-content">
    <nav class="mobile-panel-v2-nav">
      {navLinks.map((link) => (
        link.children ? (
          <div class="accordion-v2" data-accordion>
            <button type="button" class="accordion-v2-trigger">
              <svg class="accordion-v2-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {link.icon.paths.map((p) => <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={p} />)}
              </svg>
              <span class="accordion-v2-label">{link.label}</span>
              <svg class="accordion-v2-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="accordion-v2-panel">
              <div class="accordion-v2-panel-inner">
                {link.children.map((child) => (
                  <a href={child.href} class="accordion-v2-link">{child.label}</a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={link.href} class="mobile-link-v2">
            <svg class="accordion-v2-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              {link.icon.paths.map((p) => <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={p} />)}
            </svg>
            <span>{link.label}</span>
          </a>
        )
      ))}
    </nav>
    <div class="mobile-panel-v2-footer">
      <span class="mobile-panel-v2-label">{t('languageSwitcher.label')}</span>
      <LanguageSwitcher variant="mobile" />
    </div>
  </div>
</div>

<script>
  function initHeaderV2() {
    const hamburger = document.getElementById('hamburger-v2');
    const panel = document.getElementById('mobile-panel-v2');
    const themeToggles = document.querySelectorAll('#theme-toggle-v2, #theme-toggle-v2-mobile');
    
    if (!hamburger || !panel) return;

    function closePanel() {
      panel.classList.remove('is-open');
      hamburger.classList.remove('is-active');
      document.body.style.overflow = '';
    }

    function openPanel() {
      panel.classList.add('is-open');
      hamburger.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }

    // Clone to remove old listeners
    const newHamburger = hamburger.cloneNode(true) as HTMLElement;
    hamburger.parentNode?.replaceChild(newHamburger, hamburger);

    newHamburger.addEventListener('click', () => {
      panel.classList.contains('is-open') ? closePanel() : openPanel();
    });

    panel.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closePanel);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) closePanel();
    });

    // Desktop dropdowns
    document.querySelectorAll('[data-dropdown-v2]').forEach(dropdown => {
      const trigger = dropdown.querySelector('.nav-v2-item');
      if (!trigger) return;
      
      const newTrigger = trigger.cloneNode(true) as HTMLElement;
      trigger.parentNode?.replaceChild(newTrigger, trigger);
      
      newTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        document.querySelectorAll('[data-dropdown-v2].is-open').forEach(d => {
          if (d !== dropdown) d.classList.remove('is-open');
        });
        dropdown.classList.toggle('is-open');
      });
    });

    document.addEventListener('click', () => {
      document.querySelectorAll('[data-dropdown-v2].is-open').forEach(d => d.classList.remove('is-open'));
    });

    // Mobile accordions
    document.querySelectorAll('[data-accordion]').forEach(accordion => {
      const trigger = accordion.querySelector('.accordion-v2-trigger');
      if (!trigger) return;
      
      const newTrigger = trigger.cloneNode(true) as HTMLElement;
      trigger.parentNode?.replaceChild(newTrigger, trigger);
      
      newTrigger.addEventListener('click', () => {
        accordion.classList.toggle('is-open');
      });
    });
  }

  initHeaderV2();
  document.addEventListener('astro:after-swap', initHeaderV2);
</script>
