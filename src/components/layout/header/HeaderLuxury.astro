---
/**
 * HeaderLuxury — Editorial Bottom Sheet Navigation
 *
 * Desktop: elegant vertical sidebar.
 * Mobile: "Editorial" bottom sheet with drill-down interactions.
 */
import { getLocaleFromUrl, useTranslations } from '../../../utils/i18n';
import { buildLuxuryNavLinks } from '../../../config/luxuryNavigation';
import ThemeSwitcher from '../../ui/ThemeSwitcher.astro';
import LanguageSwitcher from '../../ui/LanguageSwitcher.astro';
import LuxurySidebarStructure from './LuxurySidebarStructure.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const navLinks = buildLuxuryNavLinks(locale, t);
const activeLink = Astro.url.pathname;
const homeHref = locale === 'en' ? '/' : `/${locale}/`;

// Language Logic: Preserve current path
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\/(ru|en)/, '');
const finalPath = cleanPath || '/';
const enPath = finalPath;
const ruPath = `/ru${finalPath === '/' ? '' : finalPath}`;

import '../../../styles/components/header/HeaderLuxury.css';
---

<!-- Mobile Header Bar -->
<div class="luxury-mobile-bar">
  <a href={homeHref} class="luxury-logo">
    <span class="luxury-logo-inner">LG</span>
  </a>
  
  <button type="button" class="hamburger-btn" id="menu-toggle-luxury" aria-label="Toggle menu">
    <div class="hamburger-icon">
      <span></span>
      <span></span>
    </div>
  </button>
</div>

<!-- Desktop Sidebar (Unchanged) -->
<div class="luxury-desktop-wrapper hidden lg:block">
  <!-- Desktop: The Architectural Spine -->
  <LuxurySidebarStructure />
</div>

<!-- Mobile (Unchanged) -->
<div class="luxury-mobile-bar"></div>

<!-- Mobile Navigation (Editorial Design) -->
<nav class="luxury-mobile-menu" id="luxury-mobile-menu">
  <!-- Backdrop (Click to close) -->
  <div class="luxury-backdrop" id="luxury-menu-backdrop"></div>

  <div class="luxury-sheet">
    
    <div class="luxury-nav-container">
      <!-- Main Panel (Simplified for Luxury: Flat List) -->
      <div class="luxury-panel is-active" id="panel-main">
        {navLinks.map((link) => (
           <a 
             href={link.href} 
             class="luxury-big-link"
           >
             <span>{link.label}</span>
             {link.type === 'page' && 
             <span class="luxury-arrow">
               <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                 <line x1="7" y1="17" x2="17" y2="7"></line>
                 <polyline points="7 7 17 7 17 17"></polyline>
               </svg>
             </span>
           }
           </a>
        ))}
      </div>
    </div>

    <!-- Editorial Context Controls -->
    <div class="luxury-sheet-footer">
      <div class="luxury-controls-row">
        
        <!-- Theme Control -->
        <div class="luxury-control-group">
          <span class="luxury-control-label">{t('themeSwitcher.label') || 'Theme'}</span>
          <button class="luxury-control-trigger" data-toggle-control="theme">
            <span class="luxury-control-value" id="current-theme-label">Default</span>
            <span class="text-xs opacity-50">↓</span>
          </button>
          <div class="luxury-control-list" id="theme-list">
             <button class="luxury-control-option" data-set-theme="tahoe">Tahoe</button>
             <button class="luxury-control-option" data-set-theme="abyss">Abyss</button>
             <button class="luxury-control-option" data-set-theme="solaris">Solaris</button>
             <button class="luxury-control-option" data-set-theme="nordic">Nordic</button>
             <button class="luxury-control-option" data-set-theme="neonoir">NeoNoir</button>
             <button class="luxury-control-option" data-set-theme="synthwave">Synthwave</button>
          </div>
        </div>

        <!-- Language Control -->
        <div class="luxury-control-group items-end">
          <span class="luxury-control-label">{t('languageSwitcher.label') || 'Language'}</span>
          <button class="luxury-control-trigger" data-toggle-control="lang">
            <span class="luxury-control-value">{locale === 'en' ? 'English' : 'Русский'}</span>
            <span class="text-xs opacity-50">↓</span>
          </button>
          <div class="luxury-control-list" id="lang-list">
             <a href={enPath} class={`luxury-control-option ${locale === 'en' ? 'is-selected' : ''}`}>
               English
             </a>
             <a href={ruPath} class={`luxury-control-option ${locale === 'ru' ? 'is-selected' : ''}`}>
               Русский
             </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</nav>

<script>
  function initHeaderLuxury() {
    const nav = document.getElementById('luxury-mobile-menu');
    const toggleBtn = document.getElementById('menu-toggle-luxury');
    const backdrop = document.getElementById('luxury-menu-backdrop');
    
    // Safety check
    if (!nav || !toggleBtn) return;

    // Helper to update labels
    const updateControlLabel = (theme: string) => {
       const label = document.getElementById('current-theme-label');
       if (label) {
         label.innerText = theme.charAt(0).toUpperCase() + theme.slice(1);
       }
       document.querySelectorAll('[data-set-theme]').forEach(el => {
          if (el.getAttribute('data-set-theme') === theme) {
            el.classList.add('is-selected');
          } else {
            el.classList.remove('is-selected');
          }
       });
    };

    // Initialize current label
    const html = document.documentElement;
    const currentTheme = html.getAttribute('data-theme') || 'tahoe';
    updateControlLabel(currentTheme);

    // --- Core Open/Close Logic ---

    const openMenu = () => {
      nav.classList.add('is-open');
      toggleBtn.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      nav.classList.remove('is-open');
      toggleBtn.classList.remove('is-active');
      document.body.style.overflow = '';
      
      // Reset internal states (controls)
      document.querySelectorAll('.luxury-control-group').forEach(g => g.classList.remove('is-open'));
    };

    const toggleMenu = (e: Event) => {
      e.stopPropagation();
      const isOpen = nav.classList.contains('is-open');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    };

    // --- Event Listeners ---
    
    // 1. Toggle Button
    // Clone to remove old listeners
    const newToggleBtn = toggleBtn.cloneNode(true) as HTMLElement;
    toggleBtn.parentNode?.replaceChild(newToggleBtn, toggleBtn);
    newToggleBtn.addEventListener('click', toggleMenu);

    // 2. Backdrop Click
    // Clone backdrop if it exists to clean potential old listeners
    if (backdrop) {
       const newBackdrop = backdrop.cloneNode(true) as HTMLElement;
       backdrop.parentNode?.replaceChild(newBackdrop, backdrop);
       newBackdrop.addEventListener('click', closeMenu);
    }

    // 3. Links (Close on click)
    nav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // 4. Escape Key
    // Unique handler attachment using global property to prevent stacking
    if (!(window as any).__luxuryEscHandler) {
        (window as any).__luxuryEscHandler = (e: KeyboardEvent) => {
             const nav = document.getElementById('luxury-mobile-menu');
             if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
                 // Close logic duplicated here because we might not have access to the closure
                 nav.classList.remove('is-open');
                 document.getElementById('menu-toggle-luxury')?.classList.remove('is-active');
                 document.body.style.overflow = '';
             }
        };
        document.addEventListener('keydown', (window as any).__luxuryEscHandler);
    }

    // --- Controls Logic (Theme/Lang) ---
    nav.querySelectorAll('[data-toggle-control]').forEach(trigger => {
        // Clone to clean
        const newTrigger = trigger.cloneNode(true) as HTMLElement;
        trigger.parentNode?.replaceChild(newTrigger, trigger);
        
        newTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const group = newTrigger.closest('.luxury-control-group');
          const wasOpen = group?.classList.contains('is-open');
          
          // Close all first
          document.querySelectorAll('.luxury-control-group').forEach(g => g.classList.remove('is-open'));

          if (!wasOpen) {
            group?.classList.add('is-open');
          }
        });
    });
    
    // Close controls when clicking anywhere else in the sheet
    const sheet = nav.querySelector('.luxury-sheet');
    if (sheet) {
        // Idempotency check for sheet listener not strictly needed if we clone/replace, 
        // but sheet is large. We'll use a data attribute on the nav to track if we attached global-ish listeners
        // actually, simpler: just remove old listener if we can, but anonymous functions make it hard.
        // We'll trust that `initHeaderLuxury` runs on fresh DOM parts usually.
        // For robustness, we can add a click listener to the sheet that delegated.
        // But let's just add it.
        const handleSheetClick = (e: Event) => {
            const target = e.target as HTMLElement;
            if (!target.closest('.luxury-control-group')) {
                document.querySelectorAll('.luxury-control-group').forEach(g => g.classList.remove('is-open'));
            }
        };
        // To prevent stacking on re-init without navigation (rare but possible), we could check a flag
        // or just accept it. Given Astro view transitions replace body, valid re-init is fine.
        sheet.addEventListener('click', handleSheetClick);
    }


    // --- Theme Selection Logic ---
    nav.querySelectorAll('[data-set-theme]').forEach(option => {
       option.addEventListener('click', (e) => {
         const theme = (e.currentTarget as HTMLElement).dataset.setTheme;
         if (theme) {
            const html = document.documentElement;
            html.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            updateControlLabel(theme);
         }
       });
    });
  }

  // Run on load
  initHeaderLuxury();
  
  // Run on view transitions
  document.addEventListener('astro:after-swap', initHeaderLuxury);
</script>
