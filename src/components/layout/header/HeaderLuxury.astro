---
/**
 * Header V4 - Floating Pro Sidebar (Right)
 * A clean, high-end vertical navigation system.
 */
import { getLocaleFromUrl, useTranslations } from '../../../utils/i18n';
import { buildNavLinks } from '../../../config/navigation';
import MobileNav from '../../layout/MobileNav.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const navLinks = buildNavLinks(locale, t);
const activeLink = Astro.url.pathname;
const homeHref = locale === 'en' ? '/' : `/${locale}/`;
import '../../../styles/components/header/HeaderLuxury.css';
---


<!-- Mobile Header (Visible only on mobile) -->
<div class="lg:hidden fixed top-0 left-0 right-0 z-50 px-4 py-4 flex justify-between items-center pointer-events-none">
  <div class="pointer-events-auto">
    <a href={homeHref} class="v4-logo">
      <div class="logo-inner">LG</div>
    </a>
  </div>
  
  <button type="button" class="hamburger-btn pointer-events-auto" id="menu-toggle" aria-label="Toggle menu">
    <div class="hamburger-icon">
      <span></span>
      <span></span>
    </div>
  </button>
</div>

<!-- Desktop Sidebar (Right Only - wait, original comments said Right but CSS says Left: 40px? Assuming Left based on CSS) -->
<aside class="v4-sidebar hidden lg:flex">
  <div class="v4-container backdrop-blur-3xl border border-base-content/10 shadow-[0_30px_100px_rgba(0,0,0,0.3)]">
    <div class="v4-top">
      <a href={homeHref} class="v4-logo">
        <div class="logo-inner">LG</div>
      </a>
    </div>

    <nav class="v4-nav">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class={`v4-link group ${activeLink === link.href ? 'is-active' : ''}`}
        >
          <div class="v4-icon-wrap">
            <svg class="v4-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
               {link.icon.paths.map(p => <path stroke-linecap="round" stroke-linejoin="round" d={p} />)}
            </svg>
          </div>
          <span class="v4-label">{link.label}</span>
          <div class="v4-active-indicator"></div>
        </a>
      ))}
    </nav>

    <div class="v4-bottom">
      <button class="v4-theme-btn theme-toggle-v4" aria-label={t('themeSwitcher.label')}>
        <div class="v4-theme-icons">
           <span class="sun">☀️</span>
           <span class="moon">🌙</span>
        </div>
      </button>
    </div>
  </div>
</aside>

<!-- Mobile Navigation -->
<MobileNav links={navLinks} />

</style>

<script>
  function initHeaderV4() {
    // Theme toggles
    const themeToggles = document.querySelectorAll('.theme-toggle-v4');
    const themes = ['tahoe', 'abyss', 'solaris', 'nordic', 'neonoir', 'synthwave'];

    themeToggles.forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const html = document.documentElement;
        const currentTheme = html.getAttribute('data-theme') || 'tahoe';
        let nextIndex = (themes.indexOf(currentTheme) + 1) % themes.length;
        const nextTheme = themes[nextIndex];
        
        html.setAttribute('data-theme', nextTheme);
        localStorage.setItem('theme', nextTheme);
      });
    });

    // Mobile Menu Logic
    const btn = document.getElementById('menu-toggle');
    const nav = document.getElementById('mobile-nav');

    if (btn && nav) {
      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      const toggleMenu = () => {
        if (nav.classList.contains('is-open')) {
          nav.classList.remove('is-open');
          newBtn.classList.remove('is-active');
          document.body.style.overflow = '';
        } else {
          nav.classList.add('is-open');
          newBtn.classList.add('is-active');
          document.body.style.overflow = 'hidden';
        }
      };

      newBtn.addEventListener('click', toggleMenu);
      
      // Close on link click
      nav.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          nav.classList.remove('is-open');
          newBtn.classList.remove('is-active');
          document.body.style.overflow = '';
        });
      });
    }
  }

  initHeaderV4();
  document.addEventListener('astro:after-swap', initHeaderV4);
</script>
