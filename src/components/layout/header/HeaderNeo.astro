---
/**
 * Header V3 - Floating Pill Header
 * A centered, compact floating pill that follows the user.
 */
import { getLocaleFromUrl, useTranslations } from '../../../utils/i18n';
import { buildNavLinks } from '../../../config/navigation';
import LanguageSwitcher from '../../ui/LanguageSwitcher.astro';
import ThemeSwitcher from '../../ui/ThemeSwitcher.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const navLinks = buildNavLinks(locale, t);
const homeHref = locale === 'en' ? '/' : `/${locale}/`;
---

<header class="header-v3">
  <div class="header-v3-pill">
    <a href={homeHref} class="logo-v3" aria-label={t('nav.home')}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
        <path d="M2 17l10 5 10-5"/>
      </svg>
    </a>

    <nav class="nav-v3">
      {navLinks.slice(0, 3).map((link) => (
        <a href={link.href} class="nav-v3-link">{link.label}</a>
      ))}
    </nav>

    <div class="header-v3-divider"></div>

    <div class="header-v3-actions">
       <button type="button" class="action-btn-v3" id="search-toggle-v3" aria-label={t('nav.explore')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
      </button>
      <div class="v3-desktop-only">
        <ThemeSwitcher />
      </div>
      <button type="button" class="burger-v3" id="hamburger-v3" aria-label={t('nav.menu')}>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="overlay-v3" id="overlay-v3">
  <div class="overlay-v3-content">
    <nav class="overlay-v3-nav">
      {navLinks.map((link, i) => (
        <a href={link.href} class="overlay-v3-link" style={`animation-delay: ${i * 0.1}s`}>
          <span class="overlay-v3-number">0{i + 1}</span>
          <span class="overlay-v3-text">{link.label}</span>
        </a>
      ))}
    </nav>
    <div class="overlay-v3-footer">
      <LanguageSwitcher />
      <ThemeSwitcher />
    </div>
  </div>
</div>

<style>
  .header-v3 {
    position: fixed;
    top: 24px;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 20px;
    pointer-events: none;
  }

  .header-v3-pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    background: hsl(var(--b1) / 0.6);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid hsl(var(--bc) / 0.1);
    border-radius: 999px;
    box-shadow: 
      0 10px 30px -10px hsl(var(--shadow-color, 0 0% 0%) / 0.2),
      inset 0 0 0 1px hsl(255 255 255 / 0.1);
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .header-v3-pill:hover {
    background: hsl(var(--b1) / 0.8);
    transform: translateY(-2px);
    box-shadow: 0 15px 40px -12px hsl(var(--shadow-color, 0 0% 0%) / 0.3);
  }

  .logo-v3 {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: hsl(var(--bc));
    color: hsl(var(--b1));
    border-radius: 999px;
    transition: transform 0.3s ease;
  }

  .logo-v3:hover { transform: scale(1.1); }
  .logo-v3 svg { width: 20px; height: 20px; }

  .nav-v3 {
    display: none;
    align-items: center;
    gap: 4px;
  }

  @media (min-width: 768px) {
    .nav-v3 { display: flex; }
  }

  .nav-v3-link {
    padding: 8px 16px;
    font-size: 0.9rem;
    font-weight: 500;
    color: hsl(var(--bc) / 0.6);
    text-decoration: none;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .nav-v3-link:hover {
    color: hsl(var(--bc));
    background: hsl(var(--bc) / 0.05);
  }

  .header-v3-divider {
    width: 1px;
    height: 24px;
    background: hsl(var(--bc) / 0.1);
    margin: auto 4px;
    display: none;
  }
  @media (min-width: 768px) { .header-v3-divider { display: block; } }

  .header-v3-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .action-btn-v3 {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: hsl(var(--bc) / 0.6);
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .action-btn-v3:hover {
    color: hsl(var(--bc));
    background: hsl(var(--bc) / 0.05);
  }

  .action-btn-v3 svg { width: 18px; height: 18px; }

  .v3-desktop-only { display: none; }
  @media (min-width: 1024px) { .v3-desktop-only { display: block; } }

  .burger-v3 {
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: hsl(var(--a));
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .burger-v3 span {
    width: 16px;
    height: 2px;
    background: white;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .burger-v3.is-active { background: hsl(var(--bc)); }
  .burger-v3.is-active span:first-child { transform: translateY(3px) rotate(45deg); }
  .burger-v3.is-active span:last-child { transform: translateY(-3px) rotate(-45deg); }

  /* Overlay */
  .overlay-v3 {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: hsl(var(--b1) / 0.8);
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(40px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .overlay-v3.is-open {
    opacity: 1;
    visibility: visible;
  }

  .overlay-v3-content {
    width: 100%;
    max-width: 600px;
    padding: 40px;
    text-align: center;
  }

  .overlay-v3-nav {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 60px;
  }

  .overlay-v3-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    font-size: 2.5rem;
    font-weight: 800;
    color: hsl(var(--bc));
    text-decoration: none;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .overlay-v3.is-open .overlay-v3-link {
    opacity: 1;
    transform: translateY(0);
  }

  .overlay-v3-number {
    font-size: 1rem;
    font-weight: 500;
    color: hsl(var(--a));
    font-family: monospace;
  }

  .overlay-v3-link:hover .overlay-v3-text {
    transform: translateX(10px);
    color: hsl(var(--a));
  }

  .overlay-v3-text { transition: all 0.3s ease; }

  .overlay-v3-footer {
    display: flex;
    justify-content: center;
    gap: 20px;
    opacity: 0;
    transition: all 0.8s ease 0.4s;
  }

  .overlay-v3.is-open .overlay-v3-footer { opacity: 1; }
</style>

<script>
  function initHeaderV3() {
    const burger = document.getElementById('hamburger-v3');
    const overlay = document.getElementById('overlay-v3');
    
    if (!burger || !overlay) return;

    burger.addEventListener('click', () => {
      const isOpen = overlay.classList.toggle('is-open');
      burger.classList.toggle('is-active');
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    overlay.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        overlay.classList.remove('is-open');
        burger.classList.remove('is-active');
        document.body.style.overflow = '';
      });
    });
  }

  initHeaderV3();
  document.addEventListener('astro:after-swap', initHeaderV3);
</script>
