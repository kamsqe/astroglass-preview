---
/**
 * Link Card Component
 * Visual navigation link.
 */
interface Props {
  title: string;
  href: string;
  icon?: string;
  description?: string;
}

const { title, href, icon, description } = Astro.props;
---

<a href={href} class="group block p-6 rounded-xl border border-white/10 bg-black/20 backdrop-blur-sm hover:border-white/20 hover:bg-white/5 hover:shadow-xl transition-all duration-300 no-underline relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
  <div class="flex items-start gap-4 relative z-10">
    {icon && <div class="text-2xl group-hover:scale-110 transition-transform duration-300 opacity-80 group-hover:opacity-100">{icon}</div>}
    <div>
      <h3 class="text-base font-bold text-white group-hover:text-[hsl(var(--a))] transition-colors m-0">{title}</h3>
      {description && <p class="text-sm text-white/60 mt-1 mb-0 leading-relaxed group-hover:text-white/80">{description}</p>}
    </div>
  </div>
</a>
