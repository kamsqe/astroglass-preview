---
/**
 * CTA V2 - The Confidence Builder (REMARKABLE)
 * Interactive 3-step micro-commitment CTA.
 * Uses psychology of small choices to increase conversion.
 */
import { getLocaleFromUrl, useTranslations } from '../../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const options = [
  { id: 'build', icon: '🚀', label: t('cta.steps.build'), response: t('cta.steps.buildResponse'), cta: t('cta.steps.buildCta') },
  { id: 'scale', icon: '📈', label: t('cta.steps.scale'), response: t('cta.steps.scaleResponse'), cta: t('cta.steps.scaleCta') },
  { id: 'ship', icon: '⚡', label: t('cta.steps.ship'), response: t('cta.steps.shipResponse'), cta: t('cta.steps.shipCta') },
];

const optionsJson = JSON.stringify(options);
---

<section class="relative py-20 lg:py-32 px-4 sm:px-6 overflow-hidden bg-base-100">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-8 sm:mb-12">
      <span class="text-[10px] font-black uppercase tracking-[0.4em] sm:tracking-[0.5em] text-accent mb-4 block">{t('cta.getStarted')}</span>
      <h2 class="text-2xl sm:text-3xl md:text-5xl font-black text-base-content tracking-tight">{t('cta.steps.title')}</h2>
    </div>

    <!-- Interactive Stepper -->
    <div class="cta-v2-stepper relative" data-options={optionsJson}>
      
      <!-- Step Indicators (Desktop) -->
      <div class="hidden lg:flex items-center justify-center gap-4 mb-12">
        <div class="cta-v2-step-indicator flex items-center gap-3" data-step="1">
          <div class="w-8 h-8 rounded-full bg-accent text-base-100 flex items-center justify-center text-sm font-bold">1</div>
          <span class="text-sm text-base-content/60">{t('cta.steps.chooseGoal')}</span>
        </div>
        <div class="w-16 h-px bg-base-content/10 cta-v2-connector"></div>
        <div class="cta-v2-step-indicator flex items-center gap-3 opacity-40" data-step="2">
          <div class="w-8 h-8 rounded-full bg-base-content/10 text-base-content/40 flex items-center justify-center text-sm font-bold">2</div>
          <span class="text-sm text-base-content/40">{t('cta.steps.seeHow')}</span>
        </div>
        <div class="w-16 h-px bg-base-content/10 cta-v2-connector"></div>
        <div class="cta-v2-step-indicator flex items-center gap-3 opacity-40" data-step="3">
          <div class="w-8 h-8 rounded-full bg-base-content/10 text-base-content/40 flex items-center justify-center text-sm font-bold">3</div>
          <span class="text-sm text-base-content/40">{t('cta.steps.getStarted')}</span>
        </div>
      </div>

      <!-- Step 1: Choose Goal -->
      <div class="cta-v2-step cta-v2-step-1">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
          {options.map(opt => (
            <button 
              class="cta-v2-option group p-5 sm:p-6 rounded-xl sm:rounded-2xl bg-base-content/[0.02] border border-base-content/10 text-left hover:bg-base-content/[0.05] hover:border-accent/30 transition-all duration-500"
              data-option={opt.id}
            >
              <span class="text-2xl sm:text-3xl mb-3 sm:mb-4 block group-hover:scale-110 transition-transform duration-500">{opt.icon}</span>
              <p class="text-sm sm:text-base font-bold text-base-content mb-1">{opt.label}</p>
              <p class="text-xs text-base-content/40">{t('cta.steps.tapToSelect')}</p>
            </button>
          ))}
        </div>
      </div>

      <!-- Step 2: Response (hidden initially) -->
      <div class="cta-v2-step cta-v2-step-2 hidden">
        <div class="text-center p-6 sm:p-8 rounded-xl sm:rounded-2xl bg-accent/5 border border-accent/20">
          <div class="cta-v2-response-icon text-3xl sm:text-4xl mb-3 sm:mb-4">🚀</div>
          <p class="cta-v2-response-text text-base sm:text-lg text-base-content font-medium mb-5 sm:mb-6">
            {t('cta.steps.buildResponse')}
          </p>
          <button class="cta-v2-continue px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl bg-base-content/5 text-sm sm:text-base text-base-content/70 font-medium hover:bg-base-content/10 transition-all duration-500">
            {t('cta.steps.continue')}
          </button>
        </div>
      </div>

      <!-- Step 3: Final CTA (hidden initially) -->
      <div class="cta-v2-step cta-v2-step-3 hidden">
        <div class="text-center p-6 sm:p-8 lg:p-12 rounded-xl sm:rounded-2xl bg-base-content/[0.03] border border-base-content/10">
          <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-accent/10 flex items-center justify-center text-2xl sm:text-3xl mx-auto mb-4 sm:mb-6">
            ✨
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-base-content mb-3 sm:mb-4">{t('cta.steps.allSet')}</h3>
          <p class="text-sm sm:text-base text-base-content/50 mb-6 sm:mb-8 max-w-md mx-auto">
            {t('cta.steps.startTrial')}
          </p>
          <a href="#" class="cta-v2-final-btn inline-flex items-center gap-2 px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl bg-accent text-base-100 font-bold text-sm sm:text-base hover:scale-105 active:scale-95 transition-all duration-500">
            <span class="cta-v2-final-btn-text">{t('cta.steps.buildCta')}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <p class="text-xs text-base-content/30 mt-6">{t('cta.noCreditCardRequired')} · {t('cta.cancelAnytime')}</p>
          
          <!-- Restart option -->
          <button class="cta-v2-restart mt-6 text-xs text-base-content/30 hover:text-accent transition-colors duration-300">
            {t('cta.steps.changeGoal')}
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .cta-v2-option {
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .cta-v2-option:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .cta-v2-option.selected {
    background: hsl(var(--a) / 0.1);
    border-color: hsl(var(--a) / 0.3);
  }

  .cta-v2-step {
    transition: all 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-v2-step.hidden {
    display: none;
  }

  .cta-v2-step:not(.hidden) {
    animation: stepFadeIn 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes stepFadeIn {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .cta-v2-step-indicator.active > div:first-child {
    background: hsl(var(--a));
    color: hsl(var(--b1));
  }

  .cta-v2-step-indicator.active {
    opacity: 1;
  }

  .cta-v2-step-indicator.completed > div:first-child {
    background: hsl(var(--su));
    color: hsl(var(--b1));
  }

  .cta-v2-connector.active {
    background: hsl(var(--a) / 0.5);
  }

  /* Breathing animation for idle state */
  .cta-v2-final-btn {
    animation: breathe 3s ease-in-out infinite;
  }

  @keyframes breathe {
    0%, 100% { box-shadow: 0 0 0 0 hsl(var(--a) / 0.2); }
    50% { box-shadow: 0 0 20px 5px hsl(var(--a) / 0.15); }
  }
</style>

<script>
  function initCTAV2() {
    const stepper = document.querySelector('.cta-v2-stepper') as HTMLElement;
    if (!stepper) return;

    const options = JSON.parse(stepper.dataset.options || '[]');
    let selectedOption: any = null;

    const step1 = stepper.querySelector('.cta-v2-step-1');
    const step2 = stepper.querySelector('.cta-v2-step-2');
    const step3 = stepper.querySelector('.cta-v2-step-3');
    const indicators = stepper.querySelectorAll('.cta-v2-step-indicator');
    const connectors = stepper.querySelectorAll('.cta-v2-connector');

    function updateIndicators(currentStep: number) {
      indicators.forEach((ind, i) => {
        const stepNum = i + 1;
        ind.classList.remove('active', 'completed');
        ind.classList.toggle('opacity-40', stepNum > currentStep);
        if (stepNum === currentStep) ind.classList.add('active');
        if (stepNum < currentStep) ind.classList.add('completed');
      });
      connectors.forEach((conn, i) => {
        conn.classList.toggle('active', i < currentStep - 1);
      });
    }

    function goToStep(step: number) {
      step1?.classList.toggle('hidden', step !== 1);
      step2?.classList.toggle('hidden', step !== 2);
      step3?.classList.toggle('hidden', step !== 3);
      updateIndicators(step);
    }

    // Step 1: Option selection
    stepper.querySelectorAll('.cta-v2-option').forEach(btn => {
      btn.addEventListener('click', () => {
        const optionId = (btn as HTMLElement).dataset.option;
        selectedOption = options.find((o: any) => o.id === optionId);
        
        if (!selectedOption) return;

        // Mark as selected
        stepper.querySelectorAll('.cta-v2-option').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');

        // Update step 2 content
        const iconEl = step2?.querySelector('.cta-v2-response-icon');
        const textEl = step2?.querySelector('.cta-v2-response-text');
        if (iconEl) iconEl.textContent = selectedOption.icon;
        if (textEl) textEl.textContent = selectedOption.response;

        // Go to step 2
        setTimeout(() => goToStep(2), 300);
      });
    });

    // Step 2: Continue
    stepper.querySelector('.cta-v2-continue')?.addEventListener('click', () => {
      // Update final CTA button text
      const btnText = step3?.querySelector('.cta-v2-final-btn-text');
      if (btnText && selectedOption) btnText.textContent = selectedOption.cta;
      
      goToStep(3);
    });

    // Restart
    stepper.querySelector('.cta-v2-restart')?.addEventListener('click', () => {
      selectedOption = null;
      stepper.querySelectorAll('.cta-v2-option').forEach(b => b.classList.remove('selected'));
      goToStep(1);
    });

    // Initialize
    goToStep(1);
  }

  initCTAV2();
  document.addEventListener('astro:after-swap', initCTAV2);
</script>
