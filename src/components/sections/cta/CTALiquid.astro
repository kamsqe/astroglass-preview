---
/**
 * CTA V1 - The Journey Echo (REMARKABLE)
 * Story-driven, contextual CTA that adapts based on scroll journey.
 * Features progressive reveal animation and adaptive messaging.
 */
import { getLocaleFromUrl, useTranslations } from '../../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const echoMessages = JSON.stringify([
  t('cta.echo1'),
  t('cta.echo2'),
  t('cta.echo3')
]);
---

<section class="relative py-20 lg:py-32 px-4 sm:px-6 overflow-hidden bg-base-100">
  <!-- Background gradient that shifts -->
  <div class="cta-v1-bg absolute inset-0 opacity-30 pointer-events-none">
    <div class="absolute inset-0 bg-gradient-to-br from-accent/20 via-transparent to-primary/10"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-accent/10 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-5xl mx-auto relative">
    <div class="cta-v1-container lg:grid lg:grid-cols-12 lg:gap-12 items-center" data-echo-messages={echoMessages}>
      
      <!-- Context Line (adapts based on journey) -->
      <div class="lg:col-span-5 mb-8 lg:mb-0">
        <div class="cta-v1-context space-y-4">
          <!-- Eyebrow - changes based on scroll context -->
          <p class="cta-v1-eyebrow text-xs font-bold uppercase tracking-[0.3em] text-accent opacity-0">
            {t('cta.eyebrow')}
          </p>
          
          <!-- Context message -->
          <p class="cta-v1-message text-base text-base-content/50 leading-relaxed opacity-0">
            <span class="cta-v1-message-text">{t('cta.subtitle')}</span>
          </p>
          
          <!-- Social proof micro-stat -->
          <div class="cta-v1-proof flex items-center gap-3 opacity-0">
            <div class="flex -space-x-2">
              <div class="w-8 h-8 rounded-full bg-accent/20 border-2 border-base-100 flex items-center justify-center text-xs">🚀</div>
              <div class="w-8 h-8 rounded-full bg-primary/20 border-2 border-base-100 flex items-center justify-center text-xs">⚡</div>
              <div class="w-8 h-8 rounded-full bg-secondary/20 border-2 border-base-100 flex items-center justify-center text-xs">✨</div>
            </div>
            <p class="text-xs text-base-content/40">{t('cta.proof')}</p>
          </div>
        </div>
      </div>

      <!-- Main CTA Card -->
      <div class="lg:col-span-7">
        <div class="cta-v1-card relative p-6 sm:p-8 lg:p-10 rounded-[1.5rem] sm:rounded-[2rem] bg-base-content/[0.03] border border-base-content/10 backdrop-blur-sm overflow-hidden">
          <!-- Inner glow -->
          <div class="absolute inset-0 bg-gradient-to-br from-accent/5 via-transparent to-transparent pointer-events-none"></div>
          
          <!-- Pull-up handle hint (mobile) -->
          <div class="cta-v1-handle lg:hidden w-12 h-1 bg-base-content/10 rounded-full mx-auto mb-6"></div>
          
          <div class="relative z-10 space-y-6">
            <!-- Headline -->
            <h2 class="cta-v1-headline text-xl sm:text-2xl lg:text-4xl font-black text-base-content tracking-tight opacity-0">
              {t('cta.title')}
            </h2>
            
            <!-- Supporting text -->
            <p class="cta-v1-subtext text-sm sm:text-base text-base-content/50 max-w-md opacity-0">
              {t('cta.trialDays')}. {t('cta.noCreditCardRequired')}.
            </p>
            
            <!-- CTA Buttons -->
            <div class="cta-v1-buttons flex flex-col sm:flex-row gap-3 opacity-0">
              <a href="#" class="cta-v1-primary group relative px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl bg-accent text-base-100 font-bold text-sm sm:text-base text-center overflow-hidden transition-all duration-500 hover:scale-105 active:scale-95">
                <span class="relative z-10">{t('cta.primary')}</span>
                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
              </a>
              <a href="#" class="px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl border border-base-content/10 text-base-content/70 font-medium text-sm sm:text-base text-center hover:bg-base-content/5 hover:border-base-content/20 transition-all duration-500">
                {t('cta.secondary')}
              </a>
            </div>
            
            <!-- Trust line -->
            <p class="cta-v1-trust text-xs text-base-content/30 opacity-0">
              {t('cta.trust')}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-v1-bg {
    transition: opacity 1200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-v1-card {
    transition: all 1200ms cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateZ(0);
  }

  .cta-v1-card:hover {
    border-color: hsl(var(--a) / 0.2);
    box-shadow: 0 20px 60px rgba(0,0,0,0.1);
  }

  /* Progressive reveal animations */
  .cta-v1-eyebrow.revealed {
    animation: ctaReveal 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0ms;
  }

  .cta-v1-message.revealed {
    animation: ctaReveal 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 100ms;
  }

  .cta-v1-proof.revealed {
    animation: ctaReveal 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 200ms;
  }

  .cta-v1-headline.revealed {
    animation: ctaReveal 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 150ms;
  }

  .cta-v1-subtext.revealed {
    animation: ctaReveal 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 250ms;
  }

  .cta-v1-buttons.revealed {
    animation: ctaReveal 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 350ms;
  }

  .cta-v1-trust.revealed {
    animation: ctaReveal 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 450ms;
  }

  @keyframes ctaReveal {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Handle pulse for mobile */
  .cta-v1-handle {
    animation: handlePulse 2s ease-in-out infinite;
  }

  @keyframes handlePulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
  }

  /* Primary button shine */
  .cta-v1-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent, rgba(255,255,255,0.1), transparent);
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .cta-v1-primary:hover::before {
    opacity: 1;
  }
</style>

<script>
  function initCTAV1() {
    const container = document.querySelector('.cta-v1-container') as HTMLElement;
    if (!container) return;

    const elements = [
      '.cta-v1-eyebrow',
      '.cta-v1-message',
      '.cta-v1-proof',
      '.cta-v1-headline',
      '.cta-v1-subtext',
      '.cta-v1-buttons',
      '.cta-v1-trust'
    ];

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          elements.forEach(selector => {
            document.querySelector(selector)?.classList.add('revealed');
          });
          observer.disconnect();
        }
      });
    }, { threshold: 0.3 });

    observer.observe(container);

    // Context-aware messaging based on scroll journey
    const messagesData = container.dataset.echoMessages;
    const messages = messagesData ? JSON.parse(messagesData) : [];

    const messageEl = document.querySelector('.cta-v1-message-text');
    if (messageEl && messages.length > 0) {
      const randomIndex = Math.floor(Math.random() * messages.length);
      messageEl.textContent = messages[randomIndex];
    }
  }

  initCTAV1();
  document.addEventListener('astro:after-swap', initCTAV1);
</script>
