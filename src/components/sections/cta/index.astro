---
import CTALiquid from './CTALiquid.astro';
import CTAGlass from './CTAGlass.astro';
import CTANeo from './CTANeo.astro';
import CTALuxury from './CTALuxury.astro';
import CTAMinimal from './CTAMinimal.astro';

export interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 ? <CTALiquid /> : 
 version === 2 ? <CTAGlass /> : 
 version === 3 ? <CTANeo /> : 
 version === 4 ? <CTALuxury /> : 
 <CTAMinimal />}
