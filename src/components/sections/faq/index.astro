---
import FAQLiquid from './FAQLiquid.astro';
import FAQGlass from './FAQGlass.astro';
import FAQNeo from './FAQNeo.astro';
import FAQLuxury from './FAQLuxury.astro';
import FAQMinimal from './FAQMinimal.astro';

export interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 ? <FAQLiquid /> : 
 version === 2 ? <FAQGlass /> : 
 version === 3 ? <FAQNeo /> : 
 version === 4 ? <FAQLuxury /> : 
 <FAQMinimal />}
