---
import FeaturesLiquid from './FeaturesLiquid.astro';
import FeaturesGlass from './FeaturesGlass.astro';
import FeaturesNeo from './FeaturesNeo.astro';
import FeaturesLuxury from './FeaturesLuxury.astro';
import FeaturesMinimal from './FeaturesMinimal.astro';

export interface Props {
  version?: 1 | 2 | 3 | 4 | 5;
}

const { version = 1 } = Astro.props;
---

{version === 1 ? <FeaturesLiquid /> : 
 version === 2 ? <FeaturesGlass /> : 
 version === 3 ? <FeaturesNeo /> : 
 version === 4 ? <FeaturesLuxury /> : 
 <FeaturesMinimal />}
