---
import '../../../styles/components/hero/HeroLiquid.css';
import { useTranslations } from '../../../utils/i18n';
import { getLocaleFromUrl } from '../../../utils/locale-utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section class="relative min-h-[90vh] flex items-center justify-center px-4 pt-[calc(80px+var(--nav-offset))] pb-24 md:py-32">
  <!-- Dynamic Background Ambient Glow -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <div class="absolute top-1/4 left-0 w-[50%] h-[50%] bg-[hsl(var(--glow-color))] opacity-[var(--glow-intensity,0.15)] blur-[140px] rounded-full animate-pulse-slow"></div>
    <div class="absolute bottom-1/4 right-0 w-[50%] h-[50%] bg-accent opacity-10 blur-[140px] rounded-full animate-pulse-slow" style="animation-delay: 3s;"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto text-center">
    <!-- Badge with better spacing -->
    <div class="inline-flex items-center gap-3 px-5 py-2 rounded-full border border-accent/20 bg-accent/[0.05] backdrop-blur-xl text-[10px] font-black uppercase tracking-[0.2em] text-accent mb-8 md:mb-12 animate-fade-in shadow-sm">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-40"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-accent shadow-[0_0_8px_hsl(var(--a))]"></span>
      </span>
      {t('hero.liveBadge')}
    </div>

    <!-- Headline with responsive scaling -->
    <h1 class="text-5xl sm:text-6xl md:text-8xl xl:text-[11rem] font-black tracking-tighter text-base-content mb-6 md:mb-8 leading-[0.95] md:leading-[0.85] animate-reveal">
      <span class="inline-block px-2 py-1 bg-gradient-to-br from-base-content via-base-content to-base-content/30 bg-clip-text text-transparent">
        {t('hero.title')}
      </span>
    </h1>

    <!-- Subtitle with better mobile line height -->
    <p class="text-base sm:text-lg md:text-xl text-base-content/50 max-w-2xl mx-auto mb-10 md:mb-12 leading-relaxed sm:leading-loose font-medium animate-fade-in opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
      {t('hero.subtitle')}
    </p>

    <!-- CTAs with improved touch targets -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 mb-12 animate-fade-in opacity-0" style="animation-delay: 0.4s; animation-fill-mode: forwards;">
      <a href="#explore" class="c-hero-liquid__btn-primary group relative w-full sm:w-auto px-10 py-5 rounded-2xl bg-base-content text-base-100 font-bold overflow-hidden text-center">
        <div class="c-hero-liquid__btn-shimmer absolute inset-0 bg-white/20 -translate-x-full group-hover:translate-x-0"></div>
        <span class="relative z-10">{t('hero.cta')}</span>
      </a>
      
      <a href="https://github.com/mirmanoov/liquid-glass-astro" class="c-hero-liquid__btn-secondary group w-full sm:w-auto px-10 py-5 rounded-2xl border border-base-content/10 bg-base-content/[0.02] backdrop-blur-xl text-base-content font-bold flex items-center justify-center gap-2">
        {t('hero.secondaryCta')}
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="c-hero-liquid__arrow-icon opacity-40"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Trust indicators -->
    <div class="flex flex-wrap items-center justify-center gap-6 text-base-content/30 animate-fade-in opacity-0" style="animation-delay: 0.6s; animation-fill-mode: forwards;">
      <span class="text-xs font-medium">{t('hero.trustedBy')}</span>
      <div class="flex items-center gap-4 opacity-50">
        <span class="text-sm font-bold">Vercel</span>
        <span class="text-sm font-bold">Linear</span>
        <span class="text-sm font-bold">Stripe</span>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 animate-fade-in" style="animation-delay: 1.2s; animation-fill-mode: forwards;">
    <span class="text-[10px] font-medium text-base-content/30 uppercase tracking-widest">{t('hero.scrollToExplore')}</span>
    <svg class="w-5 h-5 text-base-content/30 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
