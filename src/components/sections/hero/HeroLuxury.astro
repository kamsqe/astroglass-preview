---
/**
 * Hero V4 - The Product Stage
 * Interactive product showcase where users can immediately experience the product.
 * Mobile: Demo above fold. Desktop: Side-by-side with content.
 */
import '../../../styles/components/hero/HeroLuxury.css';
import { useTranslations } from '../../../utils/i18n';
import { getLocaleFromUrl } from '../../../utils/locale-utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const themes = [
  { id: 'tahoe', name: 'Tahoe', color: '#3B82F6' },
  { id: 'rose', name: 'Rosé', color: '#F43F5E' },
  { id: 'evergreen', name: 'Evergreen', color: '#10B981' },
  { id: 'abyss', name: 'Abyss', color: '#6366F1' },
];
---



<section class="relative min-h-screen flex items-center overflow-hidden px-4 sm:px-6 lg:px-16 pt-[calc(80px+var(--nav-offset))] pb-16 lg:pb-24">
  <!-- Background -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="c-hero-luxury__glow absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-accent opacity-10 blur-[150px] rounded-full transition-all duration-1000"></div>
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto">
    <!-- Mobile: Demo First -->
    <div class="lg:hidden mb-10">
      <!-- Interactive Demo Frame -->
      <div class="hero-v4-demo-frame relative mx-auto max-w-sm">
        <div class="relative bg-base-content/[0.03] backdrop-blur-2xl border border-base-content/10 rounded-[2.5rem] p-4 shadow-2xl overflow-hidden">
          <!-- Phone notch -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-6 bg-base-100 rounded-b-2xl"></div>
          
          <!-- Demo content -->
          <div class="hero-v4-demo-content aspect-[9/16] bg-base-100 rounded-[2rem] overflow-hidden flex flex-col items-center justify-center p-6 relative">
            <!-- Interactive theme preview -->
            <div class="c-hero-luxury__preview-card w-full aspect-video rounded-2xl bg-gradient-to-br from-accent/20 to-accent/5 border border-accent/20 flex items-center justify-center mb-6 transition-all duration-700">
              <span class="text-4xl">✨</span>
            </div>
            
            <!-- Theme switcher -->
            <div class="flex gap-2">
              {themes.map((theme, i) => (
                <button 
                  class={`c-hero-luxury__theme-btn w-10 h-10 rounded-full border-2 transition-all duration-500 ${i === 0 ? 'scale-110 border-base-content' : 'border-transparent opacity-60 hover:opacity-100'}`}
                  style={`background: ${theme.color}`}
                  data-theme={theme.id}
                  data-color={theme.color}
                  aria-label={theme.name}
                ></button>
              ))}
            </div>
            
            <p class="text-xs text-base-content/40 mt-4">{t('hero.tryItNow')}</p>
          </div>
        </div>
        
        <!-- Floating reaction -->
        <div class="absolute -right-2 top-1/4 px-3 py-2 bg-base-content/[0.05] backdrop-blur-xl border border-base-content/10 rounded-full text-sm animate-bounce shadow-lg">
          🔥 Live
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
      <!-- Content -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/20 text-accent text-xs font-bold uppercase tracking-widest mb-6 lg:mb-8 animate-fade-in">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          {t('hero.digitalExperience')}
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black tracking-tight text-base-content mb-6 leading-[1.1] animate-reveal">
          {t('hero.dontTakeOurWord')}
          <span class="block text-accent">{t('hero.tryItNow')}</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg text-base-content/50 max-w-lg mx-auto lg:mx-0 mb-8 leading-relaxed animate-fade-in opacity-0" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
          {t('hero.subtitle')}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start animate-fade-in opacity-0" style="animation-delay: 0.5s; animation-fill-mode: forwards;">
          <a href="#explore" class="px-8 py-4 rounded-2xl bg-base-content text-base-100 font-bold text-center hover:scale-105 active:scale-95 transition-all duration-300 shadow-xl hover:shadow-2xl">
            {t('hero.startBuilding')}
          </a>
          <a href="#" class="px-8 py-4 rounded-2xl border border-base-content/10 bg-base-content/[0.02] backdrop-blur-sm text-base-content font-bold text-center hover:bg-base-content/[0.05] transition-all duration-300 flex items-center justify-center gap-2">
            {t('hero.viewFullDemo')}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="flex items-center justify-center lg:justify-start gap-4 mt-8 text-base-content/30 animate-fade-in opacity-0" style="animation-delay: 0.7s; animation-fill-mode: forwards;">
          <span class="text-xs">{t('hero.trustedBy')}</span>
          <div class="flex gap-3 text-sm font-semibold opacity-60">
            <span>Vercel</span>
            <span>•</span>
            <span>Linear</span>
            <span>•</span>
            <span>Stripe</span>
          </div>
        </div>
      </div>

      <!-- Desktop: Large Demo -->
      <div class="hidden lg:block order-1 lg:order-2">
        <div class="hero-v4-demo-frame relative c-hero-luxury__perspective-2000">
          <!-- Browser frame -->
          <div class="relative bg-base-content/[0.02] backdrop-blur-3xl border border-base-content/10 rounded-[2rem] overflow-hidden shadow-2xl transform hover:scale-[1.02] transition-all duration-700 hover:shadow-[0_50px_100px_-20px_rgba(0,0,0,0.3)]">
            <!-- Browser chrome -->
            <div class="flex items-center gap-2 px-6 py-4 bg-base-content/[0.03] border-b border-base-content/5">
              <div class="flex gap-2">
                <div class="w-3 h-3 rounded-full bg-base-content/10"></div>
                <div class="w-3 h-3 rounded-full bg-base-content/10"></div>
                <div class="w-3 h-3 rounded-full bg-base-content/10"></div>
              </div>
              <div class="flex-1 mx-4">
                <div class="w-48 h-6 rounded-lg bg-base-content/[0.03] border border-base-content/5"></div>
              </div>
            </div>

            <!-- Demo content -->
            <div class="hero-v4-demo-content aspect-video bg-base-100 p-8 flex flex-col items-center justify-center">
              <!-- Interactive preview card -->
              <div class="c-hero-luxury__preview-card w-full max-w-md aspect-video rounded-3xl bg-gradient-to-br from-accent/20 to-accent/5 border border-accent/20 flex items-center justify-center mb-8 transition-all duration-700 shadow-xl">
                <div class="text-center">
                  <span class="text-6xl block mb-2">✨</span>
                  <span class="text-base-content/50 text-sm">Interactive Preview</span>
                </div>
              </div>

              <!-- Theme switcher -->
              <div class="flex items-center gap-6">
                <span class="text-xs text-base-content/40 uppercase tracking-widest">{t('themeSwitcher.label')}</span>
                <div class="flex gap-3">
                  {themes.map((theme, i) => (
                    <button 
                      class={`c-hero-luxury__theme-btn w-12 h-12 rounded-xl border-2 transition-all duration-500 hover:scale-110 ${i === 0 ? 'scale-110 border-base-content shadow-lg' : 'border-transparent opacity-60 hover:opacity-100'}`}
                      style={`background: ${theme.color}`}
                      data-theme={theme.id}
                      data-color={theme.color}
                      aria-label={theme.name}
                    ></button>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Floating elements -->
          <div class="absolute -top-6 -right-6 w-24 h-24 bg-accent/10 rounded-2xl backdrop-blur-xl border border-accent/10 rotate-12 animate-float"></div>
          <div class="absolute -bottom-4 -left-4 px-4 py-2 bg-base-content/[0.05] backdrop-blur-xl border border-base-content/10 rounded-xl text-sm animate-float shadow-lg" style="animation-delay: -2s;">
            <span class="text-accent font-bold">+127%</span>
            <span class="text-base-content/50 ml-1">faster</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initHeroV4() {
    const buttons = document.querySelectorAll('.c-hero-luxury__theme-btn');
    const previewCards = document.querySelectorAll('.c-hero-luxury__preview-card');
    const glow = document.querySelector('.c-hero-luxury__glow');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const color = (btn as HTMLElement).dataset.color;
        
        // Update button states
        buttons.forEach(b => {
          b.classList.remove('scale-110', 'border-base-content', 'shadow-lg');
          b.classList.add('border-transparent', 'opacity-60');
        });
        btn.classList.remove('border-transparent', 'opacity-60');
        btn.classList.add('scale-110', 'border-base-content', 'shadow-lg');

        // Update preview cards
        previewCards.forEach(card => {
          (card as HTMLElement).style.background = `linear-gradient(135deg, ${color}33 0%, ${color}11 100%)`;
          (card as HTMLElement).style.borderColor = `${color}44`;
        });

        // Update background glow
        if (glow) {
          (glow as HTMLElement).style.background = color;
        }
      });
    });
  }

  initHeroV4();
  document.addEventListener('astro:after-swap', initHeroV4);
</script>
