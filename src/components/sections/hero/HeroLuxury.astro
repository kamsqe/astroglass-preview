---
/**
 * Hero Luxury - The Product Stage
 * Interactive product showcase where users can immediately experience the product.
 * Mobile: Demo above fold. Desktop: Side-by-side with content.
 */
import '../../../styles/components/hero/HeroLuxury.css';
import { useTranslations } from '../../../utils/i18n';
import { getLocaleFromUrl } from '../../../utils/locale-utils';
import LuxuryButton from '../../ui/luxury/LuxuryButton.astro';
import LuxurySectionLabel from '../../ui/luxury/LuxurySectionLabel.astro';

import { palettes } from '../../../config/palettes';
import luxuryHeroBg from '../../../assets/themes/luxury/LuxuryHeroBg.jpg';
import luxuryHeroSvg from '../../../assets/themes/luxury/LuxuryHero.svg?raw';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Show 4 distinct palettes as interactive demo swatches
const targetThemeIds = ['azure', 'neonoir', 'solaris', 'evergreen'];
const themes = palettes
  .filter((p) => targetThemeIds.includes(p.id))
  .map((p) => ({
    id: p.id,
    name: p.id.charAt(0).toUpperCase() + p.id.slice(1),
    color: p.accentHex,
  }));
---

<section
  class="relative lg:min-h-0 min-h-screen flex items-center overflow-visible px-4 sm:px-6 lg:px-8 pt-[calc(80px+var(--nav-offset))] lg:pt-[calc(20px+var(--nav-offset))] pb-16 lg:pb-24"
>
  <!-- Background -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <img
      src={luxuryHeroBg.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-luminosity"
      loading="eager"
    />
    <div class="absolute inset-0 bg-base-100/70 backdrop-blur-sm"></div>
    <div
      class="c-hero-luxury__glow js-parallax absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-accent opacity-20 blur-[150px] rounded-full transition-all duration-1000"
    >
    </div>
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto">
    <!-- Mobile: Compact Demo -->
    <div class="lg:hidden mb-8">
      <div class="hero-luxury-demo-frame relative mx-auto max-w-xs">
        <div
          class="relative bg-gradient-to-br from-base-content/[0.08] to-base-content/[0.02] backdrop-blur-3xl border border-base-content/10 rounded-2xl p-3 shadow-2xl overflow-hidden ring-1 ring-white/10 ring-inset"
        >
          <!-- Demo content -->
          <div
            class="hero-luxury-demo-content aspect-[4/3] bg-base-100 rounded-xl overflow-hidden flex flex-col items-center justify-center p-4 relative"
          >
            <!-- Interactive theme preview -->
            <div
              class="c-hero-luxury__preview-card w-full aspect-video rounded-xl bg-gradient-to-br from-accent/20 to-accent/5 border border-accent/20 flex items-center justify-center mb-4 transition-luxury overflow-hidden p-2"
            >
              <div
                class="w-full h-full flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:max-w-full [&>svg]:max-h-full [&>svg]:opacity-60 [&>svg_path]:stroke-[hsl(var(--bc))]"
                set:html={luxuryHeroSvg}
              />
            </div>

            <!-- Theme switcher -->
            <div class="flex gap-2">
              {
                themes.map((theme, i) => (
                  <button
                    class={`c-hero-luxury__theme-btn w-8 h-8 border transition-luxury rounded-lg ${i === 0 ? 'scale-110 border-base-content' : 'border-transparent opacity-60 hover:opacity-100 hover:border-base-content/20'}`}
                    style={`background: ${theme.color}`}
                    data-theme={theme.id}
                    data-color={theme.color}
                    aria-label={theme.name}
                  />
                ))
              }
            </div>
          </div>

          <!-- Floating reaction -->
          <div
            class="absolute right-2 sm:-right-2 top-1/4 px-2 py-1 bg-base-content text-base-100 border border-base-content/10 text-[10px] font-bold animate-bounce shadow-xl rounded-full z-20"
          >
            Live
          </div>
        </div>
      </div>
    </div>

    <div
      class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] xl:grid-cols-[1.1fr_0.9fr] gap-8 lg:gap-16 items-center"
    >
      <!-- Content (Already updated) -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <!-- Badge -->
        <div class="mb-5 sm:mb-8 flex justify-center lg:justify-start">
          <LuxurySectionLabel text={t('hero.digitalExperience')} />
        </div>

        <!-- Headline -->
        <h1
          class="font-serif font-light text-base-content mb-6 sm:mb-8 max-w-5xl mx-auto lg:mx-0 flex flex-col gap-2 sm:gap-4 lg:gap-2"
        >
          <span
            class="text-3xl sm:text-5xl md:text-7xl lg:text-6xl xl:text-7xl tracking-tight leading-tight block"
            >{t('hero.dontTakeOurWord')}</span
          >
          <span
            class="text-3xl sm:text-5xl md:text-7xl lg:text-6xl xl:text-7xl tracking-tight leading-tight block text-accent italic"
            >{t('hero.tryItNow')}</span
          >
        </h1>

        <!-- Subtitle -->
        <p
          class="text-base sm:text-lg text-base-content/75 max-w-md sm:max-w-lg mx-auto lg:mx-0 mb-8 sm:mb-10 leading-relaxed font-light"
        >
          {t('hero.subtitle')}
        </p>

        <!-- CTAs -->
        <div
          class="hero-luxury__actions flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4 px-0 sm:px-4 lg:px-0"
        >
          <LuxuryButton href="#services" variant="primary">{t('hero.startBuilding')}</LuxuryButton>
          <LuxuryButton href={`/${locale}/docs`} variant="secondary">
            {t('hero.viewFullDemo')}
          </LuxuryButton>
        </div>

        <!-- Trust indicators -->
        <div
          class="flex items-center justify-center lg:justify-start gap-3 sm:gap-4 mt-8 sm:mt-12 text-base-content/75"
        >
          <span class="text-[10px] uppercase tracking-widest font-bold">{t('hero.trustedBy')}</span>
          <div class="flex gap-4 text-sm font-medium opacity-70">
            <span>Vercel</span>
            <span class="opacity-30">/</span>
            <span>Linear</span>
            <span class="opacity-30">/</span>
            <span>Stripe</span>
          </div>
        </div>
      </div>

      <!-- Desktop: Large Demo -->
      <div class="hidden lg:block order-1 lg:order-2">
        <div class="hero-luxury-demo-frame relative c-hero-luxury__perspective-2000">
          <!-- Browser frame -->
          <div
            class="relative bg-gradient-to-br from-base-content/[0.08] to-base-content/[0.02] backdrop-blur-3xl border border-base-content/10 overflow-hidden shadow-2xl transform hover:scale-[1.01] transition-all duration-[800ms] ease-[cubic-bezier(0.19,1,0.22,1)] hover:shadow-[0_40px_80px_-20px_rgba(0,0,0,0.2)] rounded-2xl ring-1 ring-white/10 ring-inset"
          >
            <!-- Browser chrome -->
            <div
              class="flex items-center gap-2 px-6 py-4 bg-base-content/[0.02] border-b border-base-content/5"
            >
              <div class="flex gap-2">
                <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                <div class="w-3 h-3 bg-gray-400 rounded-full"></div>
                <div class="w-3 h-3 bg-green-500 rounded-full"></div>
              </div>
              <div class="flex-1 mx-4">
                <div
                  class="w-48 h-5 bg-base-content/[0.03] border border-base-content/5 rounded-lg"
                >
                </div>
              </div>
            </div>

            <!-- Demo content -->
            <div
              class="hero-luxury-demo-content aspect-video bg-base-100 p-8 flex flex-col items-center justify-center"
            >
              <!-- Interactive preview card with SVG visual -->
              <div
                class="c-hero-luxury__preview-card w-full max-w-md aspect-video bg-gradient-to-br from-accent/20 to-accent/5 border border-accent/20 flex items-center justify-center mb-8 transition-luxury shadow-none rounded-2xl overflow-hidden p-4"
              >
                <div
                  class="w-full h-full flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:max-w-full [&>svg]:max-h-full [&>svg]:opacity-60 [&>svg_path]:stroke-[hsl(var(--bc))]"
                  set:html={luxuryHeroSvg}
                />
              </div>

              <!-- Theme switcher -->
              <div class="flex items-center gap-6">
                <span class="text-xs text-base-content/75 uppercase tracking-luxury-wide font-bold"
                  >{t('themeSwitcher.label')}</span
                >
                <div class="flex gap-3">
                  {
                    themes.map((theme, i) => (
                      <button
                        class={`c-hero-luxury__theme-btn w-12 h-12 border transition-luxury hover:scale-105 rounded-xl ${i === 0 ? 'scale-110 border-base-content' : 'border-transparent opacity-60 hover:opacity-100 hover:border-base-content/20'}`}
                        style={`background: ${theme.color}`}
                        data-theme={theme.id}
                        data-color={theme.color}
                        aria-label={theme.name}
                      />
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <!-- Floating elements -->
          <div
            class="js-luxury-floating-square absolute -top-6 -right-6 w-24 h-24 bg-gradient-to-br from-accent/20 to-accent/5 backdrop-blur-xl border border-accent/20 rotate-12 animate-float rounded-2xl ring-1 ring-white/10 ring-inset shadow-main-luxury transition-luxury"
          >
          </div>
          <div
            class="absolute -bottom-4 -left-4 px-4 py-3 bg-base-content text-base-100 border border-base-content/10 text-sm animate-float shadow-main-luxury font-medium rounded-xl ring-1 ring-white/10 ring-inset"
            style="animation-delay: -2s;"
          >
            <span class="luxury-hero-stat-accent text-accent font-bold">+127%</span>
            <span class="opacity-80 ml-1">{t('hero.faster').toLowerCase().replace('.', '')}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { Parallax } from '../../../scripts/luxury-interactions';

  function initHeroLuxury() {
    // Init Magnetic Buttons
    // Note: We need to target the anchor tags inside LuxuryButton if needed, or just apply strictly to .js-magnetic if we kept that class.
    // However, LuxuryButton uses standard CSS transitions. If we want magnetic flair, we should add it to LuxuryButton component or here.
    // For now, let's keep it simple as per audit findings to standardize.

    // Init Parallax
    new Parallax('.js-parallax', 0.1);

    const buttons = document.querySelectorAll('.c-hero-luxury__theme-btn');
    const previewCards = document.querySelectorAll('.c-hero-luxury__preview-card');
    const glow = document.querySelector('.c-hero-luxury__glow');
    const floatingSquare = document.querySelector('.js-luxury-floating-square');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const color = (btn as HTMLElement).dataset.color;
        if (!color) return;

        // Update button states
        buttons.forEach((b) => {
          b.classList.remove('scale-110', 'border-base-content', 'shadow-lg');
          b.classList.add('border-transparent', 'opacity-60');
        });
        btn.classList.remove('border-transparent', 'opacity-60');
        btn.classList.add('scale-110', 'border-base-content', 'shadow-lg');

        // Update preview cards
        previewCards.forEach((card) => {
          (card as HTMLElement).style.background =
            `linear-gradient(135deg, ${color}33 0%, ${color}11 100%)`;
          (card as HTMLElement).style.borderColor = `${color}44`;
        });

        // Update background glow
        if (glow) {
          (glow as HTMLElement).style.background = color;
        }

        // Update floating square
        if (floatingSquare) {
          (floatingSquare as HTMLElement).style.background =
            `linear-gradient(135deg, ${color}33 0%, ${color}11 100%)`;
          (floatingSquare as HTMLElement).style.borderColor = `${color}44`;
        }
      });
    });
  }

  initHeroLuxury();
  document.addEventListener('astro:after-swap', initHeroLuxury);
</script>
