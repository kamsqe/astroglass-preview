---
/**
 * Portfolio V4 - Case Study Cards (Redesigned)
 * Metric-led narrative cards with impact focus.
 */
import { getLocaleFromUrl, useTranslations } from '../../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const projects = [
  { 
    id: 1, 
    title: t('portfolio.p1Title'), 
    desc: t('portfolio.p1Desc'), 
    category: t('portfolio.categories.webapp'),
    metric: '3x',
    metricLabel: t('portfolio.metrics.faster'),
    color: 'from-violet-500 to-purple-600'
  },
  { 
    id: 2, 
    title: t('portfolio.p2Title'), 
    desc: t('portfolio.p2Desc'), 
    category: t('portfolio.categories.dashboard'),
    metric: '50K+',
    metricLabel: t('portfolio.metrics.users'),
    color: 'from-cyan-500 to-blue-600'
  },
  { 
    id: 3, 
    title: t('portfolio.p3Title'), 
    desc: t('portfolio.p3Desc'), 
    category: t('portfolio.categories.mobile'),
    metric: '4.9★',
    metricLabel: t('portfolio.metrics.rating'),
    color: 'from-emerald-500 to-teal-600'
  },
  { 
    id: 4, 
    title: t('portfolio.p4Title'), 
    desc: t('portfolio.p4Desc'), 
    category: t('portfolio.categories.branding'),
    metric: '200%',
    metricLabel: t('portfolio.metrics.growth'),
    color: 'from-amber-500 to-orange-600'
  },
];
---

<section class="relative py-16 sm:py-24 md:py-32 px-4 sm:px-6 bg-base-content/[0.01] overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12 sm:mb-16">
      <span class="inline-block text-accent font-black uppercase text-[10px] tracking-[0.3em] mb-4">{t('portfolio.caseStudies')}</span>
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-base-content tracking-tight mb-4">
        {t('portfolio.impactTitle')}
      </h2>
      <p class="text-base sm:text-lg text-base-content/50 max-w-xl mx-auto">
        {t('portfolio.impactSubtitle')}
      </p>
    </div>

    <!-- Case Study Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      {projects.map((p, i) => (
        <div 
          class="case-card group relative rounded-2xl sm:rounded-3xl overflow-hidden border border-base-content/10 backdrop-blur-sm transition-all duration-700"
          style={`animation-delay: ${i * 100}ms`}
        >
          <!-- Background gradient -->
          <div class={`absolute inset-0 bg-gradient-to-br ${p.color} opacity-[0.03] group-hover:opacity-[0.08] transition-opacity duration-700`}></div>
          
          <!-- Large number watermark -->
          <div class="absolute -bottom-8 -right-4 text-[140px] sm:text-[180px] font-black text-base-content/[0.03] leading-none select-none pointer-events-none">
            0{p.id}
          </div>
          
          <div class="relative z-10 p-6 sm:p-8 lg:p-10 min-h-[280px] sm:min-h-[320px] flex flex-col">
            <!-- Top: Category -->
            <div class="flex items-center justify-between mb-6">
              <span class="px-3 py-1.5 rounded-lg bg-base-content/5 text-base-content/60 text-[10px] font-bold uppercase tracking-wider">
                {p.category}
              </span>
              <div class={`w-8 h-8 rounded-lg bg-gradient-to-br ${p.color} opacity-60 group-hover:opacity-100 group-hover:scale-110 transition-all duration-500`}></div>
            </div>
            
            <!-- Middle: Metric (Visual Anchor) -->
            <div class="mb-6">
              <div class={`text-4xl sm:text-5xl lg:text-6xl font-black bg-gradient-to-r ${p.color} bg-clip-text text-transparent mb-1`}>
                {p.metric}
              </div>
              <span class="text-sm text-base-content/50 font-medium">{p.metricLabel}</span>
            </div>
            
            <!-- Bottom: Title & Description -->
            <div class="mt-auto">
              <h3 class="text-xl sm:text-2xl font-black text-base-content mb-2 group-hover:text-accent transition-colors duration-500">
                {p.title}
              </h3>
              <p class="text-sm text-base-content/50 leading-relaxed mb-4">
                {p.desc}
              </p>
              
              <!-- CTA -->
              <a href="#" class="inline-flex items-center gap-2 text-accent text-xs font-bold opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all duration-300">
                {t('portfolio.viewCaseStudy')}
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </div>
          
          <!-- Hover border glow -->
          <div class={`absolute inset-0 rounded-2xl sm:rounded-3xl border-2 border-transparent group-hover:border-accent/20 transition-colors duration-500 pointer-events-none`}></div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-12 sm:mt-16">
      <a href="#" class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-base-content text-base-100 font-bold shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 group">
        {t('portfolio.allWork')}
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .case-card {
    opacity: 0;
    transform: translateY(20px) scale(0.98);
    animation: card-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    background: hsl(var(--b1));
  }

  @keyframes card-in {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .case-card:hover {
    transform: translateY(-6px) scale(1.01);
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.2);
  }

  @media (min-width: 640px) {
    .case-card:hover {
      transform: translateY(-6px) scale(1.02) perspective(1000px) rotateX(2deg);
    }
  }
</style>
