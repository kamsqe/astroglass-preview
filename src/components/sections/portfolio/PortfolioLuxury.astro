---
/**
 * Portfolio V4 - Case Study Cards (Redesigned)
 * Metric-led narrative cards with impact focus.
 */
import '../../../styles/components/portfolio/PortfolioLuxury.css';
import { useTranslations } from '../../../utils/i18n';
import { getLocaleFromUrl, localePath } from '../../../utils/locale-utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = localePath(Astro.url);

const projects = [
  { 
    id: 1, 
    title: t('portfolio.p1Title'), 
    desc: t('portfolio.p1Desc'), 
    category: t('portfolio.categories.webapp'),
    metric: '3x',
    metricLabel: t('portfolio.metrics.faster'),
    color: 'from-violet-500 to-purple-600'
  },
  { 
    id: 2, 
    title: t('portfolio.p2Title'), 
    desc: t('portfolio.p2Desc'), 
    category: t('portfolio.categories.dashboard'),
    metric: '50K+',
    metricLabel: t('portfolio.metrics.users'),
    color: 'from-cyan-500 to-blue-600'
  },
  { 
    id: 3, 
    title: t('portfolio.p3Title'), 
    desc: t('portfolio.p3Desc'), 
    category: t('portfolio.categories.mobile'),
    metric: '4.9★',
    metricLabel: t('portfolio.metrics.rating'),
    color: 'from-emerald-500 to-teal-600'
  },
  { 
    id: 4, 
    title: t('portfolio.p4Title'), 
    desc: t('portfolio.p4Desc'), 
    category: t('portfolio.categories.branding'),
    metric: '200%',
    metricLabel: t('portfolio.metrics.growth'),
    color: 'from-amber-500 to-orange-600'
  },
];
---

<section id="portfolio" class="relative py-20 md:py-32 px-4 sm:px-6 lg:px-8 overflow-hidden bg-base-100">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12 sm:mb-16">
      <span class="inline-block text-accent font-black uppercase text-[10px] tracking-[0.3em] mb-4">{t('portfolio.caseStudies')}</span>
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-normal font-serif text-base-content tracking-tight mb-4">
        {t('portfolio.impactTitle')}
      </h2>
      <p class="text-base sm:text-lg text-base-content/50 max-w-xl mx-auto">
        {t('portfolio.impactSubtitle')}
      </p>
    </div>

    <!-- Case Study Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      {projects.map((p, i) => (
        <div 
          class="c-portfolio-luxury__card group relative rounded-2xl overflow-hidden border border-base-content/10 bg-gradient-to-br from-base-content/[0.05] to-base-content/[0.01] backdrop-blur-xl ring-1 ring-white/5 ring-inset shadow-2xl transition-luxury"
          style={`animation-delay: ${i * 100}ms`}
        >
          <!-- Background gradient -->
          <div class={`absolute inset-0 bg-gradient-to-br ${p.color} opacity-[0.03] group-hover:opacity-[0.08] transition-opacity duration-luxury-slow`}></div>
          
          <!-- Large number watermark -->
          <div class="absolute -bottom-8 -right-4 text-[140px] sm:text-[180px] font-black text-base-content/[0.03] leading-none select-none pointer-events-none">
            0{p.id}
          </div>
          
          <div class="relative z-10 p-6 sm:p-8 lg:p-10 min-h-[280px] sm:min-h-[320px] flex flex-col">
            <!-- Top: Category -->
            <div class="flex items-center justify-between mb-6">
              <span class="px-3 py-1.5 rounded-lg bg-base-content/5 text-base-content/60 text-[10px] font-bold uppercase tracking-wider">
                {p.category}
              </span>
              <div class={`w-8 h-8 rounded-lg bg-gradient-to-br ${p.color} opacity-60 group-hover:opacity-100 group-hover:scale-110 transition-luxury`}></div>
            </div>
            
            <!-- Middle: Metric (Visual Anchor) -->
            <div class="mb-6">
              <div class={`text-4xl sm:text-5xl lg:text-6xl font-black bg-gradient-to-r ${p.color} bg-clip-text text-transparent mb-1`}>
                {p.metric}
              </div>
              <span class="text-sm text-base-content/50 font-medium">{p.metricLabel}</span>
            </div>
            
            <!-- Bottom: Title & Description -->
            <div class="mt-auto">
              <h3 class="text-xl sm:text-2xl font-black text-base-content mb-2 group-hover:text-accent transition-colors duration-luxury-medium">
                {p.title}
              </h3>
              <p class="text-sm text-base-content/50 leading-relaxed mb-4">
                {p.desc}
              </p>
              
              <!-- CTA -->
              <a href={lp('/luxury/portfolio')} class="c-portfolio-luxury__link inline-flex items-center gap-2 text-accent text-xs font-bold">
                {t('portfolio.viewCaseStudy')}
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </div>
          
          <!-- Hover border glow -->
          <div class={`absolute inset-0 rounded-2xl border-2 border-transparent group-hover:border-accent/20 transition-colors duration-luxury-medium pointer-events-none`}></div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-12 sm:mt-16">
      <a href={lp('/luxury/portfolio')} class="inline-flex items-center gap-3 px-10 py-4 rounded-full bg-base-content text-base-100 font-bold shadow-xl hover:scale-105 active:scale-95 transition-luxury group">
        {t('portfolio.allWork')}
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-luxury-fast" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
