---
/**
 * Pricing V4 - The Perspective Gallery
 * An architectural 3D gallery with smooth CSS-driven transitions.
 */
import { getLocaleFromUrl, useTranslations } from '../../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const plans = [
  { 
    id: 'starter', 
    name: t('pricing.tier1Name'), 
    price: '0', 
    period: t('pricing.freeForever'),
    desc: t('pricing.plans.starter.desc'),
    features: [t('pricing.features.projects'), t('pricing.values.community'), t('pricing.features.support'), t('pricing.features.analytics')],
    cta: t('pricing.plans.starter.cta')
  },
  { 
    id: 'pro', 
    name: t('pricing.tier2Name'), 
    price: '49', 
    period: t('pricing.perMonth'),
    desc: t('pricing.plans.pro.desc'),
    features: [t('pricing.values.unlimited'), t('pricing.values.priorityEmail'), t('pricing.features.customThemes'), t('pricing.features.analytics'), t('pricing.features.customThemes'), t('pricing.features.apiAccess')],
    popular: true,
    cta: t('pricing.plans.pro.cta')
  },
  { 
    id: 'enterprise', 
    name: t('pricing.tier3Name'), 
    price: '199', 
    period: t('pricing.perMonth'),
    desc: t('pricing.plans.enterprise.desc'),
    features: [t('pricing.features.dedicatedNodes'), t('pricing.values.phone247'), t('pricing.features.customSla'), t('pricing.features.securityAudit'), t('pricing.features.teamTraining'), t('pricing.features.whiteLabel')],
    cta: t('pricing.plans.enterprise.cta')
  },
];
---

<section class="pricing-v4-section relative py-32 lg:py-48 px-6 overflow-hidden min-h-screen flex items-center bg-base-100">
  <!-- Ambient Background -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
     <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[150vw] h-[80vh] bg-gradient-to-b from-accent/5 to-transparent blur-3xl"></div>
     <div class="absolute bottom-0 left-0 right-0 h-1/2 bg-gradient-to-t from-base-100 to-transparent"></div>
  </div>

  <div class="max-w-7xl mx-auto w-full relative z-10">
    <!-- Header -->
    <div class="text-center mb-20 lg:mb-32">
       <div class="inline-flex items-center gap-4 mb-8">
          <div class="w-12 h-px bg-accent/40"></div>
          <span class="text-[10px] font-black uppercase tracking-[0.6em] text-accent">{t('pricing.selectScale')}</span>
          <div class="w-12 h-px bg-accent/40"></div>
       </div>
       <h2 class="text-5xl md:text-7xl lg:text-9xl font-black text-base-content tracking-tighter leading-none">{t('pricing.title')}</h2>
    </div>

    <!-- Desktop: Perspective Gallery -->
    <div class="hidden lg:block">
       <div class="perspective-stage" data-active="1">
          <div class="perspective-track">
             {plans.map((p, i) => (
                <article class="gallery-card" data-index={i}>
                   <div class="card-inner">
                      <!-- Glass Shimmer -->
                      <div class="absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-transparent opacity-60 pointer-events-none rounded-[3rem]"></div>
                      
                      <!-- Popular Badge -->
                      {p.popular && (
                         <div class="absolute -top-px left-1/2 -translate-x-1/2 z-20 pointer-events-none">
                            <div class="px-8 py-3 bg-accent text-base-100 text-[9px] font-black uppercase tracking-[0.4em] rounded-b-2xl shadow-2xl">
                               {t('pricing.mostPopular')}
                            </div>
                         </div>
                      )}

                      <div class="relative z-10 flex-1 flex flex-col h-full pointer-events-none">
                         <!-- Tier Header -->
                         <div class="mb-10">
                            <h3 class="text-[11px] font-black uppercase tracking-[0.5em] text-accent mb-6">{p.name}</h3>
                            <div class="flex items-baseline gap-3">
                               <span class="text-base-content/20 text-4xl font-black">$</span>
                               <span class="text-7xl font-black text-base-content tracking-tighter">{p.price}</span>
                            </div>
                            <p class="text-sm text-base-content/30 font-bold mt-3">{p.period}</p>
                         </div>

                         <!-- Description -->
                         <p class="text-lg text-base-content/40 font-medium leading-relaxed mb-10">{p.desc}</p>

                         <!-- Features -->
                         <ul class="space-y-4 flex-1">
                            {p.features.map(f => (
                               <li class="flex items-center gap-4 text-sm font-semibold text-base-content/50">
                                  <div class="w-1.5 h-1.5 rounded-full bg-accent/60"></div>
                                  {f}
                               </li>
                            ))}
                         </ul>

                         <!-- CTA - Fixed at bottom -->
                         <div class="pt-8 mt-auto pointer-events-auto">
                            <button class:list={[
                               "w-full py-5 rounded-2xl font-black text-xs uppercase tracking-[0.3em] shadow-xl transition-all duration-500 hover:scale-105 active:scale-95",
                               p.popular ? "bg-accent text-base-100" : "bg-base-content/5 text-base-content hover:bg-base-content hover:text-base-100"
                            ]}>
                               {p.cta}
                            </button>
                         </div>
                      </div>

                      <!-- Accent Glow -->
                      {p.popular && <div class="absolute -bottom-1/4 -right-1/4 w-96 h-96 bg-accent/20 blur-[100px] rounded-full pointer-events-none"></div>}
                   </div>
                </article>
             ))}
          </div>

          <!-- Click zones for left/right navigation -->
          <button class="nav-zone nav-zone-left" data-nav="prev" aria-label={t('pricing.prevPlan')}></button>
          <button class="nav-zone nav-zone-right" data-nav="next" aria-label={t('pricing.nextPlan')}></button>
       </div>

       <!-- Navigation Dots -->
       <div class="flex items-center justify-center gap-4 mt-16">
          {plans.map((p, i) => (
             <button 
               class:list={["gallery-dot", i === 1 ? "active" : ""]}
               data-target={i}
               aria-label={t('pricing.viewPlan').replace('{plan}', p.name)}
             ></button>
          ))}
       </div>
    </div>

    <!-- Mobile: Tab Navigation -->
    <div class="lg:hidden">
       <!-- Tab Bar -->
       <div class="flex rounded-2xl bg-base-content/[0.03] border border-base-content/10 p-1.5 mb-6">
          {plans.map((p, idx) => (
             <button 
               class:list={["mobile-tab-btn flex-1 py-3 rounded-xl text-center transition-all", idx === 1 ? "active" : ""]}
               data-step={idx}
             >
                <span class="text-[10px] font-black uppercase tracking-wider">{p.name}</span>
             </button>
          ))}
       </div>

       <!-- Card Container -->
       <div class="mobile-focus-container relative min-h-[520px]">
          {plans.map((p, idx) => (
             <div 
               class:list={["mobile-focus-card absolute inset-0", idx === 1 ? "active" : ""]}
               data-card={idx}
             >
                <div class:list={[
                   "h-full flex flex-col p-8 rounded-[2.5rem] border backdrop-blur-xl",
                   p.popular ? "bg-base-content/[0.04] border-accent/30" : "bg-base-content/[0.02] border-base-content/10"
                ]}>
                   {p.popular && (
                      <div class="self-center px-4 py-1.5 bg-accent text-base-100 text-[8px] font-black uppercase tracking-[0.2em] rounded-full mb-4">
                         {t('pricing.recommended')}
                      </div>
                   )}

                   <div class="text-center mb-6">
                      <div class="flex items-baseline justify-center gap-1 mb-1">
                         <span class="text-base-content/20 text-2xl font-black">$</span>
                         <span class="text-6xl font-black text-base-content tracking-tighter">{p.price}</span>
                      </div>
                      <p class="text-xs text-base-content/30 font-medium">{p.period}</p>
                   </div>

                   <p class="text-sm text-base-content/40 text-center font-medium leading-relaxed mb-6">{p.desc}</p>

                   <div class="flex-1 space-y-3">
                      {p.features.map(f => (
                         <div class="flex items-center gap-3 text-sm font-medium text-base-content/50">
                            <div class="w-5 h-5 rounded-full bg-accent/10 flex items-center justify-center flex-shrink-0">
                               <svg class="w-3 h-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                               </svg>
                            </div>
                            {f}
                         </div>
                      ))}
                   </div>

                   <div class="pt-6">
                      <button class:list={[
                         "w-full py-4 rounded-xl font-black text-[10px] uppercase tracking-[0.3em]",
                         p.popular ? "bg-accent text-base-100" : "bg-base-content/5 text-base-content"
                      ]}>
                         {p.cta}
                      </button>
                   </div>
                </div>
             </div>
          ))}
       </div>
    </div>
  </div>
</section>

<style>
  .perspective-stage {
    perspective: 1800px;
    perspective-origin: center center;
    position: relative;
  }

  .perspective-track {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0;
    position: relative;
    height: 720px;
    transform-style: preserve-3d;
  }

  /* Navigation zones - invisible click areas on left/right */
  .nav-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 35%;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 40;
    transition: opacity 300ms ease;
    opacity: 0;
  }
  .nav-zone::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: hsl(var(--bc) / 0.05);
    border: 1px solid hsl(var(--bc) / 0.1);
    transition: all 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-zone:hover {
    opacity: 1;
  }
  .nav-zone:hover::after {
    background: hsl(var(--bc) / 0.1);
    border-color: hsl(var(--bc) / 0.2);
    transform: translateY(-50%) scale(1.1);
  }
  .nav-zone-left {
    left: 0;
  }
  .nav-zone-left::after {
    left: 20px;
  }
  .nav-zone-right {
    right: 0;
  }
  .nav-zone-right::after {
    right: 20px;
  }

  /* Hide zones at edges */
  [data-active="0"] .nav-zone-left { display: none; }
  [data-active="2"] .nav-zone-right { display: none; }

  .gallery-card {
    position: absolute;
    width: 400px;
    height: 680px;
    transform-style: preserve-3d;
    transition: transform 500ms cubic-bezier(0.32, 0.72, 0, 1),
                opacity 400ms ease-out;
    cursor: pointer;
    pointer-events: auto;
    will-change: transform, opacity;
  }

  /* Ensure inactive cards remain clickable */
  .gallery-card .card-inner {
    transition: border-color 300ms ease-out;
    box-shadow: none !important;
  }
  .gallery-card:hover .card-inner {
    border-color: hsl(var(--bc) / 0.25);
    box-shadow: none !important;
  }

  /* Blur overlay for inactive cards - more performant than filter blur */
  .gallery-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: hsl(var(--b1) / 0.3);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    border-radius: 3rem;
    opacity: 1;
    transition: opacity 400ms ease-out;
    pointer-events: none;
  }
  
  /* Active card has no blur overlay */
  [data-active="0"] .gallery-card[data-index="0"]::after,
  [data-active="1"] .gallery-card[data-index="1"]::after,
  [data-active="2"] .gallery-card[data-index="2"]::after {
    opacity: 0;
  }

  .card-inner {
    width: 100%;
    height: 100%;
    background: hsl(var(--bc) / 0.04);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid hsl(var(--bc) / 0.1);
    border-radius: 3rem;
    padding: 3rem;
    padding-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: border-color 300ms ease-out;
  }

  /* Position states controlled by parent data-active attribute */
  
  /* When card 0 (Starter) is active */
  [data-active="0"] .gallery-card[data-index="0"] {
    transform: translateZ(40px) rotateY(0deg);
    opacity: 1;
    z-index: 30;
  }
  [data-active="0"] .gallery-card[data-index="0"] .card-inner {
    border-color: hsl(var(--a) / 0.3);
  }
  [data-active="0"] .gallery-card[data-index="1"] {
    transform: translateX(380px) translateZ(-200px) rotateY(-15deg);
    opacity: 0.5;
    z-index: 20;
  }
  [data-active="0"] .gallery-card[data-index="2"] {
    transform: translateX(700px) translateZ(-400px) rotateY(-25deg);
    opacity: 0.3;
    z-index: 10;
  }

  /* When card 1 (Pro) is active - DEFAULT */
  [data-active="1"] .gallery-card[data-index="0"] {
    transform: translateX(-380px) translateZ(-200px) rotateY(15deg);
    opacity: 0.5;
    z-index: 20;
  }
  [data-active="1"] .gallery-card[data-index="1"] {
    transform: translateZ(40px) rotateY(0deg);
    opacity: 1;
    z-index: 30;
  }
  [data-active="1"] .gallery-card[data-index="1"] .card-inner {
    border-color: hsl(var(--a) / 0.3);
  }
  [data-active="1"] .gallery-card[data-index="2"] {
    transform: translateX(380px) translateZ(-200px) rotateY(-15deg);
    opacity: 0.5;
    z-index: 20;
  }

  /* When card 2 (Enterprise) is active */
  [data-active="2"] .gallery-card[data-index="0"] {
    transform: translateX(-700px) translateZ(-400px) rotateY(25deg);
    opacity: 0.3;
    z-index: 10;
  }
  [data-active="2"] .gallery-card[data-index="1"] {
    transform: translateX(-380px) translateZ(-200px) rotateY(15deg);
    opacity: 0.5;
    z-index: 20;
  }
  [data-active="2"] .gallery-card[data-index="2"] {
    transform: translateZ(40px) rotateY(0deg);
    opacity: 1;
    z-index: 30;
  }
  [data-active="2"] .gallery-card[data-index="2"] .card-inner {
    border-color: hsl(var(--a) / 0.3);
  }

  /* Hover on inactive cards */
  .gallery-card:not([data-index]) .card-inner:hover,
  [data-active="0"] .gallery-card:not([data-index="0"]):hover,
  [data-active="1"] .gallery-card:not([data-index="1"]):hover,
  [data-active="2"] .gallery-card:not([data-index="2"]):hover {
    border-color: hsl(var(--bc) / 0.2);
  }

  /* Navigation dots */
  .gallery-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: hsl(var(--bc) / 0.1);
    border: none;
    cursor: pointer;
    transition: all 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gallery-dot:hover {
    background: hsl(var(--bc) / 0.3);
    transform: scale(1.2);
  }
  .gallery-dot.active {
    background: hsl(var(--a));
    transform: scale(1.4);
    box-shadow: 0 0 20px hsl(var(--a) / 0.5);
  }

  /* Mobile tabs and cards */
  .mobile-tab-btn {
    color: hsl(var(--bc) / 0.4);
  }
  .mobile-tab-btn.active {
    background: hsl(var(--bc) / 0.08);
    color: hsl(var(--bc));
  }

  .mobile-focus-card {
    opacity: 0;
    visibility: hidden;
    transform: translateX(20px);
    transition: all 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-focus-card.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }
</style>

<script>
  let pricingV4Controller: AbortController | null = null;

  function initPerspectiveGallery() {
    // Abort previous listeners
    pricingV4Controller?.abort();
    pricingV4Controller = new AbortController();
    const signal = pricingV4Controller.signal;

    const stage = document.querySelector('.perspective-stage') as HTMLElement;
    const dots = document.querySelectorAll('.gallery-dot');
    const navZones = document.querySelectorAll('.nav-zone');

    // Mobile tab navigation
    const tabBtns = document.querySelectorAll('.mobile-tab-btn');
    const focusCards = document.querySelectorAll('.mobile-focus-card');

    if (!stage) return;

    let currentIndex = 1;
    const maxIndex = 2;

    function setActive(index: number) {
      // Clamp index
      index = Math.max(0, Math.min(maxIndex, index));
      currentIndex = index;
      
      stage.dataset.active = String(index);
      
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index);
      });

      if ('vibrate' in navigator) navigator.vibrate(10);
    }

    function setMobileActive(index: number) {
      tabBtns.forEach((btn, i) => btn.classList.toggle('active', i === index));
      focusCards.forEach((card, i) => card.classList.toggle('active', i === index));
    }

    // Navigation zone clicks
    navZones.forEach((zone) => {
      zone.addEventListener('click', () => {
        const direction = zone.getAttribute('data-nav');
        if (direction === 'prev') {
          setActive(currentIndex - 1);
        } else if (direction === 'next') {
          setActive(currentIndex + 1);
        }
      }, { signal });
    });

    // Dot clicks
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => setActive(i), { signal });
    });

    // Mobile tab clicks
    tabBtns.forEach((btn, i) => {
      btn.addEventListener('click', () => setMobileActive(i), { signal });
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') setActive(currentIndex - 1);
      if (e.key === 'ArrowRight') setActive(currentIndex + 1);
    }, { signal });
  }

  initPerspectiveGallery();
  document.addEventListener('astro:after-swap', initPerspectiveGallery);
</script>
