---
/**
 * Testimonial V1 - The Story Reel
 * Full-screen immersive story format with tap navigation.
 * Mobile: Swipeable carousel with visible nav. Desktop: Horizontal cards.
 */
import { getLocaleFromUrl, useTranslations } from '../../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const testimonials = [
  {
    quote: t('testimonial.q1'),
    author: "Sarah Chen",
    role: t('testimonial.roles.cto'),
    company: t('testimonial.companies.quantum'),
    avatar: "https://i.pravatar.cc/150?img=1",
    gradient: "from-violet-500/20 to-fuchsia-500/20"
  },
  {
    quote: t('testimonial.q2'),
    author: "Marcus Rivera",
    role: t('testimonial.roles.founder'),
    company: t('testimonial.companies.velocity'),
    avatar: "https://i.pravatar.cc/150?img=3",
    gradient: "from-cyan-500/20 to-blue-500/20"
  },
  {
    quote: t('testimonial.q3'),
    author: "Emily Watson",
    role: t('testimonial.roles.vp'),
    company: t('testimonial.companies.scaleup'),
    avatar: "https://i.pravatar.cc/150?img=5",
    gradient: "from-amber-500/20 to-orange-500/20"
  },
  {
    quote: t('testimonial.q4'),
    author: "David Kim",
    role: t('testimonial.roles.lead'),
    company: t('testimonial.companies.nexgen'),
    avatar: "https://i.pravatar.cc/150?img=8",
    gradient: "from-emerald-500/20 to-teal-500/20"
  },
];
---

<section class="relative py-24 lg:py-32 px-6 overflow-hidden bg-base-100">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
       <span class="text-[10px] font-black uppercase tracking-[0.5em] text-accent mb-4 block">{t('testimonial.stories')}</span>
       <h2 class="text-4xl md:text-6xl font-black text-base-content tracking-tighter">{t('testimonial.title')}</h2>
    </div>

    <!-- Mobile: Horizontal Swipe Carousel -->
    <div class="lg:hidden">
       <div class="story-carousel-mobile overflow-x-auto pb-6 -mx-6 px-6 snap-x snap-mandatory scrollbar-hide">
          <div class="flex gap-4" style="width: max-content;">
             {testimonials.map((item, i) => (
                <div 
                  class="story-card-mobile snap-center flex-shrink-0 w-[85vw] max-w-[340px] relative rounded-[2rem] overflow-hidden bg-base-content/[0.03] border border-base-content/10"
                  style="min-height: 420px;"
                >
                   <!-- Gradient Background -->
                   <div class:list={["absolute inset-0 bg-gradient-to-br opacity-30 pointer-events-none", item.gradient]}></div>
                   
                   <div class="relative z-10 h-full flex flex-col items-center justify-center p-8 text-center">
                      <!-- Avatar -->
                      <div class="w-20 h-20 mx-auto mb-6 rounded-full overflow-hidden border-4 border-white/20 shadow-xl">
                         <img src={item.avatar} alt={item.author} class="w-full h-full object-cover" />
                      </div>

                      <!-- Quote -->
                      <p class="text-lg font-semibold text-base-content leading-relaxed mb-6">
                         "{item.quote}"
                      </p>

                      <!-- Attribution -->
                      <div class="mt-auto">
                         <p class="text-base font-black text-base-content">{item.author}</p>
                         <p class="text-sm text-base-content/50">{item.role} at {item.company}</p>
                      </div>
                   </div>
                </div>
             ))}
          </div>
       </div>
       
       <!-- Scroll hint -->
       <div class="flex justify-center gap-2 mt-4">
          {testimonials.map((_, i) => (
             <div class="w-2 h-2 rounded-full bg-base-content/20"></div>
          ))}
       </div>
       <p class="text-center text-xs text-base-content/30 mt-2">{t('testimonial.swipe')}</p>
    </div>

    <!-- Desktop: Horizontal Cards -->
    <div class="hidden lg:grid grid-cols-4 gap-6">
       {testimonials.map((item, i) => (
          <div class="story-card group relative p-8 rounded-[2rem] bg-base-content/[0.02] border border-base-content/10 overflow-hidden hover:bg-base-content/[0.05] transition-all duration-700">
             <!-- Gradient -->
             <div class:list={["absolute inset-0 bg-gradient-to-br opacity-0 group-hover:opacity-30 transition-opacity duration-700 pointer-events-none", item.gradient]}></div>
             
             <div class="relative z-10">
                <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-base-content/10 mb-6">
                   <img src={item.avatar} alt={item.author} class="w-full h-full object-cover" />
                </div>
                <p class="text-base text-base-content/70 font-medium leading-relaxed mb-6 line-clamp-4">
                   "{item.quote}"
                </p>
                <div>
                   <p class="text-sm font-bold text-base-content">{item.author}</p>
                   <p class="text-xs text-base-content/40">{item.role}, {item.company}</p>
                </div>
             </div>
          </div>
       ))}
    </div>
  </div>
</section>

<style>
  .story-carousel-mobile {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .story-carousel-mobile::-webkit-scrollbar {
    display: none;
  }

  .story-card-mobile {
    transition: all 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .story-card {
    transition: all 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .story-card:hover {
    transform: translateY(-8px);
    border-color: hsl(var(--bc) / 0.2);
  }
</style>
