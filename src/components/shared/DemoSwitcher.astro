---
// Demo Switcher - Dropdown to navigate between theme demos
// This component should be included in all header components

export interface Props {
  currentTheme?: 'liquid' | 'glass' | 'neo' | 'luxury' | 'minimal';
}

const { currentTheme } = Astro.props;

const demos = [
  { id: 'liquid', name: 'Liquid', href: '/liquid', description: 'Fluid & organic' },
  { id: 'glass', name: 'Glass', href: '/glass', description: 'Glassmorphism style' },
  { id: 'neo', name: 'Neo', href: '/neo', description: 'Modern futuristic' },
  { id: 'luxury', name: 'Luxury', href: '/luxury', description: 'Premium elegance' },
  { id: 'minimal', name: 'Minimal', href: '/minimal', description: 'Clean simplicity' },
];
---

<div class="demo-switcher relative group">
  <button 
    class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-base-content/70 hover:text-base-content transition-colors duration-300"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <span class="hidden sm:inline">Demos</span>
    <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
  
  <div class="demo-dropdown absolute top-full right-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
    <div class="bg-base-100/95 backdrop-blur-xl border border-base-content/10 rounded-2xl shadow-2xl overflow-hidden">
      <div class="p-2">
        {demos.map((demo) => (
          <a 
            href={demo.href}
            class:list={[
              "flex flex-col px-4 py-3 rounded-xl transition-all duration-300",
              currentTheme === demo.id 
                ? "bg-accent/10 text-accent" 
                : "hover:bg-base-content/5 text-base-content/70 hover:text-base-content"
            ]}
          >
            <span class="font-semibold text-sm">{demo.name}</span>
            <span class="text-xs opacity-60">{demo.description}</span>
          </a>
        ))}
      </div>
      <div class="border-t border-base-content/10 p-2">
        <a 
          href="/"
          class="flex items-center gap-2 px-4 py-2 text-xs font-medium text-base-content/50 hover:text-base-content rounded-lg hover:bg-base-content/5 transition-colors"
        >
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          View All Demos
        </a>
      </div>
    </div>
  </div>
</div>
