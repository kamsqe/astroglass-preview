---
interface Props {
  post: any;
  locale: string;
}

const { post, locale } = Astro.props;
const slug = post.slug.replace(/^(en|ru)\//, '');
const href = locale === 'en' ? `/blog/${slug}/` : `/${locale}/blog/${slug}/`;
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'medium' }).format(post.data.date);
---

<a href={href} class="block group relative p-6 rounded-3xl bg-base-content/5 hover:bg-base-content/10 transition-all duration-300">
  <div class="mb-4">
    {post.data.tags.map((tag: string) => (
      <span class="inline-block px-2 py-1 mr-2 text-xs font-bold uppercase tracking-wider bg-accent/10 text-accent rounded-md">
        {tag}
      </span>
    ))}
  </div>
  <h3 class="text-2xl font-bold mb-2 group-hover:text-accent transition-colors">{post.data.title}</h3>
  <p class="text-base-content/60 mb-4 line-clamp-2">{post.data.description}</p>
  <div class="text-sm text-base-content/40 font-mono">{date}</div>
</a>
