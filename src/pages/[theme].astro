---
/**
 * Dynamic Theme Page — Landing Route
 *
 * Generates /{theme} for each enabled theme via getStaticPaths().
 *
 * HOW SECTION ORDER IS CONTROLLED:
 *   Edit src/config/themePresets.ts → {themeId}.landingSections[]
 *
 * HOW TO ADD A SECTION TO ONE THEME:
 *   1. Create the section component (e.g. NewSectionLiquid.astro)
 *   2. Export it from the theme barrel: src/components/sections/themes/{theme}.ts
 *   3. Add its key to themePresets.ts → {theme}.landingSections[]
 *
 * HOW TO ADD A NEW THEME:
 *   1. Create src/components/sections/themes/{theme}.ts barrel file
 *   2. Add a preset in src/config/themePresets.ts
 *   3. Register the theme in src/config/themes.ts
 *   4. Add the theme module to the themeModules map below
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../utils/i18n';
import { getLocaleFromUrl } from '../utils/locale-utils';
import { getEnabledThemes, getThemeById } from '../config/themes';
import { themePresets } from '../config/themePresets';

// Theme barrel files — each exports all section components for one theme.
// Section ordering and enabling is controlled by themePresets.ts, not here.
// @ts-ignore — .astro imports in .ts barrel files resolve correctly at build time
import * as LiquidSections  from '../components/sections/themes/liquid';
// @ts-ignore
import * as GlassSections   from '../components/sections/themes/glass';
// @ts-ignore
import * as NeoSections     from '../components/sections/themes/neo';
// @ts-ignore
import * as LuxurySections  from '../components/sections/themes/luxury';
// @ts-ignore
import * as MinimalSections from '../components/sections/themes/minimal';
// @ts-ignore
import * as AuroraSections  from '../components/sections/themes/aurora';

export function getStaticPaths() {
  return getEnabledThemes().map((theme) => ({
    params: { theme: theme.id },
    props: { themeId: theme.id },
  }));
}

interface Props {
  themeId: string;
}

const { themeId } = Astro.props;
const theme = getThemeById(themeId);
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const preset = themePresets[themeId] ?? themePresets['liquid'];

// Map of all theme section modules — add a new entry here when adding a new theme.
const themeModules: Record<string, Record<string, unknown>> = {
  liquid:  LiquidSections,
  glass:   GlassSections,
  neo:     NeoSections,
  luxury:  LuxurySections,
  minimal: MinimalSections,
  aurora:  AuroraSections,
};

const sections = themeModules[themeId] ?? LiquidSections;

// Layout components — always rendered, not part of the section preset.
const Header = sections['Header'] as any;
const Footer = sections['Footer'] as any;

// Resolve main content sections in preset order.
// If a section key is listed in the preset but not exported by the barrel file,
// it is silently skipped — no runtime error.
const mainSections = preset.landingSections
  .map((key) => sections[key] ?? null)
  .filter((C): C is NonNullable<typeof C> => C !== null) as any[];
---

<BaseLayout
  title={`${theme?.name} Theme - ${t('title')}`}
  description={t('description')}
  showHeader={false}
>
  <Header />
  <main>
    {mainSections.map((Section: any) => <Section />)}
  </main>
  <Footer />
</BaseLayout>
