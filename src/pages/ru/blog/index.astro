---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/ui/BlogCard.astro';
import { useTranslations } from '../../../utils/i18n';
import FooterLiquid from '../../../components/sections/footer/FooterLiquid.astro';

export const prerender = true;

const locale = 'ru';
const t = useTranslations(locale);

// Get Russian blog posts, fallback to English if none exist
let posts = await getCollection('blog', ({ slug, data }) => {
  return slug.startsWith('ru/') && !data.draft;
});

// If no Russian posts, show English posts
if (posts.length === 0) {
  posts = await getCollection('blog', ({ slug, data }) => {
    return slug.startsWith('en/') && !data.draft;
  });
}

const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={t('blog.title')} description={t('blog.description')}>
  <div class="max-w-6xl mx-auto py-20 px-4">
    <h1 class="text-5xl font-black mb-12">{t('blog.title')}</h1>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.length > 0 ? (
        sortedPosts.map(post => <BlogCard post={post} locale={locale} />)
      ) : (
        <p class="col-span-full text-center text-base-content/60">{t('blog.noPosts')}</p>
      )}
    </div>
  </div>
  <FooterLiquid />
</BaseLayout>
