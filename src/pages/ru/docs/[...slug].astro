---
import { getCollection } from 'astro:content';
import DocsLayout from '../../../components/docs/DocsLayout.astro';
import Callout from '../../../components/mdx/Callout.astro';
import CardGrid from '../../../components/mdx/CardGrid.astro';
import LinkCard from '../../../components/mdx/LinkCard.astro';
import PropsTable from '../../../components/docs/PropsTable.astro';

export const prerender = true;

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ slug }) => slug.startsWith('ru/'));
  return docs.map(doc => ({
    params: { slug: doc.slug.replace('ru/', '') },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content, headings } = await doc.render();
const locale = 'ru';

const components = {
  Callout,
  CardGrid,
  LinkCard,
  PropsTable
};
---

<DocsLayout doc={doc} headings={headings} locale={locale}>
  <Content components={components} />
</DocsLayout>
