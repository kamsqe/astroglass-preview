---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LuminaHero } from '../../components/demos/lumina/LuminaHero';
import { useTranslations } from '../../utils/i18n';
import { getLocaleFromUrl } from '../../utils/locale-utils';
import '../../styles/lumina.css';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const title = "Lumina - " + t('landing.headline');
const description = t('landing.tagline');
---

<BaseLayout title={title} description={description} showHeader={true} showControls={true}>
  <main>
    <LuminaHero 
      client:only="react"
      title={t('landing.demos.lumina.name')}
      subtitle={t('landing.demos.lumina.description')}
      ctaPrimary={t('landing.viewDemos')}
      ctaSecondary={t('landing.documentation')}
    />
  </main>
</BaseLayout>
